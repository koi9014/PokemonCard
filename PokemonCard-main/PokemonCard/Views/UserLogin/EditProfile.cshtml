@{
    ViewData["Title"] = "編輯個人資料";
}

<div class="max-w-md mx-auto mt-4">

    <div class="bg-white rounded-xl shadow-md border border-[#e2bebb]/50 overflow-hidden">

        <!-- 標題列 -->
        <div class="p-6 text-center">
            <div class="mx-auto w-16 h-16 rounded-full bg-[#42A5F5]/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-[#42A5F5] text-[32px]">manage_accounts</span>
            </div>
            <h1 class="mt-4 text-2xl font-extrabold text-[#0d1e25]">編輯個人資料</h1>
            <p class="mt-2 text-sm text-[#5a413f]">更新您的個人資訊與大頭貼</p>
        </div>

        <form class="px-6 py-4 flex flex-col gap-5" method="post" enctype="multipart/form-data" action="/UserLogin/EditProfile">

            <!-- 大頭貼上傳 -->
            <div class="flex flex-col gap-2">
                <label class="text-sm font-bold text-[#0d1e25]">大頭貼</label>
                <div class="flex flex-col items-center gap-4">
                    <div class="relative w-24 h-24 rounded-full bg-[#f4faff] border border-[#e2bebb] flex items-center justify-center overflow-hidden">
                        <img id="avatarPreview" alt="avatar" class="w-full h-full object-cover hidden">
                        <span id="avatarPlaceholder" class="material-symbols-outlined text-[#5a413f] text-[40px]">person</span>
                    </div>
                    <label class="cursor-pointer inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#42A5F5]/10 text-[#42A5F5] font-bold hover:bg-[#42A5F5]/20 transition-all">
                        <span class="material-symbols-outlined text-[18px]">upload</span>
                        上傳大頭貼
                        <input id="avatar" name="avatar" type="file" accept="image/*" class="hidden" onchange="previewImage(this, 'avatarPreview', 'avatarPlaceholder')">
                    </label>
                </div>
            </div>

            <!-- 暱稱 -->
            <div class="flex flex-col gap-2">
                <label class="text-sm font-bold text-[#0d1e25]" for="displayName">
                    暱稱 <span class="text-[#EF5350]">*</span>
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#5a413f] text-[18px]">badge</span>
                    <input id="displayName" name="displayName" type="text" required
                        class="w-full pl-12 pr-4 py-3 rounded-lg bg-white border border-[#e2bebb] focus:outline-none focus:border-[#42A5F5] focus:ring-2 focus:ring-[#42A5F5]/20 transition-all"
                        placeholder="您的暱稱">
                </div>
            </div>

            <!-- 電話 -->
            <div class="flex flex-col gap-2">
                <label class="text-sm font-bold text-[#0d1e25]" for="phone">
                    電話 <span class="text-[#EF5350]">*</span>
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#5a413f] text-[18px]">call</span>
                    <input id="phone" name="phone" type="tel" required pattern="[0-9\-]{9,12}"
                        class="w-full pl-12 pr-4 py-3 rounded-lg bg-white border border-[#e2bebb] focus:outline-none focus:border-[#42A5F5] focus:ring-2 focus:ring-[#42A5F5]/20 transition-all"
                        placeholder="0912-345-678">
                </div>
            </div>

            <!-- 生日 -->
            <div class="flex flex-col gap-2">
                <label class="text-sm font-bold text-[#0d1e25]" for="birthday">
                    生日
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#5a413f] text-[18px]">cake</span>
                    <input id="birthday" name="birthday" type="date"
                        class="w-full pl-12 pr-4 py-3 rounded-lg bg-white border border-[#e2bebb] focus:outline-none focus:border-[#42A5F5] focus:ring-2 focus:ring-[#42A5F5]/20 transition-all">
                </div>
            </div>

            <!-- Email -->
            <div class="flex flex-col gap-2">
                <label class="text-sm font-bold text-[#0d1e25]" for="email">
                    Email <span class="text-[#EF5350]">*</span>
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#5a413f] text-[18px]">mail</span>
                    <input id="email" name="email" type="email" required
                        class="w-full pl-12 pr-4 py-3 rounded-lg bg-white border border-[#e2bebb] focus:outline-none focus:border-[#42A5F5] focus:ring-2 focus:ring-[#42A5F5]/20 transition-all"
                        placeholder="example@email.com">
                </div>
            </div>

            <!-- 確定按鈕 -->
            <button type="submit"
                class="w-full py-3.5 rounded-lg bg-[#EF5350] text-white text-base font-bold shadow-sm hover:bg-[#E53935] hover:shadow-md flex items-center justify-center gap-2 transition-all">
                <span class="material-symbols-outlined text-[20px]">check</span>
                確定
            </button>
        </form>
    </div>

</div>

<script>
    function previewImage(input, previewId, placeholderId) {
        const file = input.files && input.files[0];
        const preview = document.getElementById(previewId);
        const placeholder = document.getElementById(placeholderId);
        if (file) {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = () => {
                if (preview) {
                    preview.src = reader.result;
                    preview.classList.remove('hidden');
                }
                if (placeholder) {
                    placeholder.classList.add('hidden');
                }
            };
        }
    }
</script>