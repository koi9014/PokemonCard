@{
    ViewData["Title"] = "賣家入駐申請";
}

<div class="max-w-md mx-auto mt-4">

    <div class="bg-white rounded-xl shadow-md border border-[#e2bebb]/50 overflow-hidden">

        <!-- 標題列 -->
        <div class="p-6 text-center">
            <div class="mx-auto w-16 h-16 rounded-full bg-[#66BB6A]/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-[#66BB6A] text-[32px]">storefront</span>
            </div>
            <h1 class="mt-4 text-2xl font-extrabold text-[#0d1e25]">賣家入駐申請</h1>
            <p class="mt-2 text-sm text-[#5a413f]">完成表單與身分驗證，加入 PiCartChu 賣家行列</p>
        </div>

        <form class="px-6 py-4 flex flex-col gap-5" method="post" enctype="multipart/form-data" action="/UserLogin/SellerApplication">

            <!-- 真實姓名 -->
            <div class="flex flex-col gap-2">
                <label class="text-sm font-bold text-[#0d1e25]" for="realName">
                    真實姓名 <span class="text-[#EF5350]">*</span>
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#5a413f] text-[18px]">badge</span>
                    <input id="realName" name="realName" type="text" required
                        class="w-full pl-12 pr-4 py-3 rounded-lg bg-white border border-[#e2bebb] focus:outline-none focus:border-[#42A5F5] focus:ring-2 focus:ring-[#42A5F5]/20 transition-all"
                        placeholder="與身分證相符的真實姓名">
                </div>
            </div>

            <!-- 連絡電話 -->
            <div class="flex flex-col gap-2">
                <label class="text-sm font-bold text-[#0d1e25]" for="phone">
                    連絡電話 <span class="text-[#EF5350]">*</span>
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#5a413f] text-[18px]">call</span>
                    <input id="phone" name="phone" type="tel" required pattern="[0-9\-]{9,12}"
                        class="w-full pl-12 pr-4 py-3 rounded-lg bg-white border border-[#e2bebb] focus:outline-none focus:border-[#42A5F5] focus:ring-2 focus:ring-[#42A5F5]/20 transition-all"
                        placeholder="0912-345-678">
                </div>
            </div>

            <!-- 賣場名稱 -->
            <div class="flex flex-col gap-2">
                <label class="text-sm font-bold text-[#0d1e25]" for="shopName">
                    賣場名稱 <span class="text-[#EF5350]">*</span>
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#5a413f] text-[18px]">storefront</span>
                    <input id="shopName" name="shopName" type="text" required
                        class="w-full pl-12 pr-4 py-3 rounded-lg bg-[#f4faff] border border-[#e2bebb] focus:outline-none focus:border-[#42A5F5] focus:ring-2 focus:ring-[#42A5F5]/20 transition-all"
                        placeholder="您的賣場名稱">
                </div>
            </div>

            <!-- 收款銀行帳號 -->
            <div class="flex flex-col gap-2">
                <label class="text-sm font-bold text-[#0d1e25]" for="bankAccount">
                    收款銀行帳號 <span class="text-[#EF5350]">*</span>
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#5a413f] text-[18px]">account_balance</span>
                    <input id="bankAccount" name="bankAccount" type="text" required
                        class="w-full pl-12 pr-4 py-3 rounded-lg bg-[#f4faff] border border-[#e2bebb] focus:outline-none focus:border-[#42A5F5] focus:ring-2 focus:ring-[#42A5F5]/20 transition-all"
                        placeholder="銀行代碼 - 分行 - 帳號">
                </div>
            </div>

            <!-- 身分證正面 -->
            <div class="flex flex-col gap-2">
                <label class="text-sm font-bold text-[#0d1e25]" for="idFront">
                    上傳身分證正面 <span class="text-[#EF5350]">*</span>
                </label>
                <div class="flex items-center gap-4">
                    <img id="idFrontPreview" alt="正面預覽" class="hidden w-24 h-16 object-cover rounded-lg border border-[#e2bebb]">
                    <label class="cursor-pointer inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#42A5F5]/10 text-[#42A5F5] font-bold hover:bg-[#42A5F5]/20 transition-all">
                        <span class="material-symbols-outlined text-[18px]">upload</span>
                        選擇檔案
                        <input id="idFront" name="idFront" type="file" accept="image/*" required class="hidden" onchange="previewImage(this, 'idFrontPreview')">
                    </label>
                </div>
                <p class="text-xs text-[#5a413f] mt-1">請上傳清晰的身分證正面照片</p>
            </div>

            <!-- 身分證反面 -->
            <div class="flex flex-col gap-2">
                <label class="text-sm font-bold text-[#0d1e25]" for="idBack">
                    上傳身分證反面 <span class="text-[#EF5350]">*</span>
                </label>
                <div class="flex items-center gap-4">
                    <img id="idBackPreview" alt="反面預覽" class="hidden w-24 h-16 object-cover rounded-lg border border-[#e2bebb]">
                    <label class="cursor-pointer inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#42A5F5]/10 text-[#42A5F5] font-bold hover:bg-[#42A5F5]/20 transition-all">
                        <span class="material-symbols-outlined text-[18px]">upload</span>
                        選擇檔案
                        <input id="idBack" name="idBack" type="file" accept="image/*" required class="hidden" onchange="previewImage(this, 'idBackPreview')">
                    </label>
                </div>
                <p class="text-xs text-[#5a413f] mt-1">請上傳身份證反面照片</p>
            </div>

            <!-- 送出審核 -->
            <button type="submit"
                class="w-full py-3.5 rounded-lg bg-[#66BB6A] text-white text-base font-bold shadow-sm hover:bg-[#43A047] hover:shadow-md flex items-center justify-center gap-2 transition-all">
                <span class="material-symbols-outlined text-[20px]">fact_check</span>
                送出審核
            </button>
        </form>
    </div>

</div>

<script>
    function previewImage(input, previewId) {
        const file = input.files && input.files[0];
        const preview = document.getElementById(previewId);
        if (file) {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = () => {
                if (preview) {
                    preview.src = reader.result;
                    preview.classList.remove('hidden');
                }
            };
        }
    }
</script>