

<!-- 這裡就是右側的商品／訂單資料 -->

<div class="card mb-4 shadow-sm">

    <div class="card-header d-flex justify-content-between">
        <p><span class="fw-bold">@ViewBag.StoreName?.StoreName </span></p>
        <span class="text-danger">待付款</span>
    </div>

    <div class="card-body">
        <div class="row">

            <div class="col-md-3">
                <img src="~/images/products/charmander_postcard_01.jpg"
                     class="rounded border"
                     width="150"
                     height="150"
                     alt="商品圖片">
            </div>

            <div class="col-md-9">

                <h5>@ViewBag.Product?.ProductName</h5>

                <p class="text-muted">
                    規格：黑色 / M
                </p>

                <p>
                    數量：2
                </p>

                <p class="fw-bold text-danger">
                    訂單金額：$500
                </p>

            </div>

        </div>
    </div>

</div>