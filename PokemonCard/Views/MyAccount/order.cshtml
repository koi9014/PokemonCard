@model PokemonCard.ViewModels.MemberCenterViewModel

@{
    Layout = "~/Views/MyAccount/MemberLayout.cshtml";
}

<!-- 我的訂單 -->
<div class="card shadow-sm">

    <div class="card-header">
        <span class="fw-bold">我的訂單</span>
    </div>

    @if(Model.Orders == null || !Model.Orders.Any( ))
    {
        <!-- 沒有訂單 -->
        <div class="card-body">

            <div class="text-center py-5">

                <i class="bi bi-bag-x fs-1 text-muted"></i>

                <h5 class="mt-3">
                    尚未有訂單
                </h5>

                <p class="text-muted">
                    您目前還沒有任何訂單
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- 有訂單 -->
        @* <div class="card-body">

            @foreach(var item in Model.Orders)
            {
                <!-- 每一筆訂單 -->
                <div class="card mb-4 shadow-sm">

                    <!-- 賣家與訂單狀態 -->
                    <div class="card-header d-flex justify-content-between align-items-center">

                        <span>
                            賣家：
                            <span class="fw-bold">
                                @item.Seller.FullName
                            </span>
                        </span>

                        <span class="text-primary">
                            @PokemonCard.Helpers.OrderStatus.GetText(item.OrderStatus)
                        </span>

                    </div>

                    <!-- 商品內容 -->
                    <div class="card-body">

                        <div class="row align-items-center">

                            <div class="col-md-3">

                                <img src="@item.OrderItems.FirstOrDefault( )?.Product?.ProductImages.FirstOrDefault( )?.ImageUrl"
                                     width="150"
                                     height="150"
                                     alt="@item.OrderItems.FirstOrDefault( )?.Product?.ProductName"
                                     class="img-fluid">

                            </div>

                            <div class="col-md-9">

                                <h5>
                                    @item.OrderItems.FirstOrDefault( )?.Product?.ProductName
                                </h5>

                                <p class="text-muted">
                                    規格：
                                </p>

                                <p>
                                    數量：@item.OrderItems.FirstOrDefault( )?.Quantity
                                </p>

                                <p class="fw-bold text-danger">
                                    訂單金額：@item.OrderAmount
                                </p>

                            </div>

                        </div>

                        <!-- 訂單詳情按鈕 -->
                        <div class="text-end mt-3">

                            <a asp-controller="MyAccount"
                               asp-action="OrderDetail"
                               asp-route-id="@item.OrderId"
                               class="btn btn-primary">
                                訂單詳情
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div> *@
        <div class="card-body">

            @foreach(var order in Model.Orders)
            {
                <!-- ==============================
             一個 Order = 一個框框
        =============================== -->
                <div class="card mb-4 shadow-sm">

                    <!-- 訂單標題 -->
                    <div class="card-header d-flex justify-content-between align-items-center">

                        <div>

                            <span class="me-4">
                                訂單編號：
                                <span class="fw-bold">
                                    @order.OrderNo
                                </span>
                            </span>

                            <span>
                                賣家：
                                <span class="fw-bold">
                                    @order.Seller.FullName
                                </span>
                            </span>

                        </div>

                        <div class="d-flex align-items-center">

                            <span class="text-muted me-4">
                                下單時間：
                                @order.OrderedAt.ToString("yyyy/MM/dd HH:mm")
                            </span>

                            <span class="text-primary">
                                @PokemonCard.Helpers.OrderStatus.GetText(order.OrderStatus)
                            </span>

                        </div>

                    </div>


                    <!-- ==============================
                 這一筆 Order 的所有商品
            =============================== -->
                    <div class="card-body">

                        @foreach(var item in order.OrderItems)
                        {
                            <div class="row align-items-center mb-3 pb-3 border-bottom">

                                <!-- 商品圖片 -->
                                <div class="col-md-3">

                                    <img src="@item.Product?.ProductImages.FirstOrDefault( )?.ImageUrl"
                                         width="150"
                                         height="150"
                                         alt="@item.ProductName"
                                         class="img-fluid">

                                </div>


                                <!-- 商品資訊 -->
                                <div class="col-md-9">

                                    <h5>
                                        @item.ProductName
                                    </h5>

                                    @if(!string.IsNullOrEmpty(item.ProductSpec))
                                    {
                                        <p class="text-muted">
                                            規格：@item.ProductSpec
                                        </p>
                                    }

                                    @if(!string.IsNullOrEmpty(item.ProductSpec2))
                                    {
                                        <p class="text-muted">
                                            @item.ProductSpec2
                                        </p>
                                    }

                                    <p>
                                        數量：@item.Quantity
                                    </p>

                                    <p>
                                        單價：
                                        NT$ @item.UnitPrice.ToString("N0")
                                    </p>

                                    <p class="fw-bold text-danger">
                                        小計：
                                        NT$ @((item.UnitPrice * item.Quantity).ToString("N0"))
                                    </p>

                                </div>

                            </div>
                        }


                        <!-- ==============================
                     訂單底部資訊
                =============================== -->
                        <div class="d-flex justify-content-between align-items-center mt-3">

                            <!-- 訂單總金額 -->
                            <div>

                                <span class="fw-bold">
                                    訂單金額：
                                </span>

                                <span class="fw-bold text-danger">
                                    NT$ @order.OrderAmount.ToString("N0")
                                </span>

                            </div>


                            <!-- 訂單詳情 -->
                            <div>

                                <a asp-controller="MyAccount"
                                   asp-action="OrderDetail"
                                   asp-route-id="@order.OrderId"
                                   class="btn btn-primary">
                                    訂單詳情
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    }

</div>
