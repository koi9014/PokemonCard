@model PokemonCard.ViewModels.MemberCenterViewModel

@{
    Layout = "~/Views/MyAccount/MemberLayout.cshtml";
}

<!-- 我的訂單 -->
<div class="card shadow-sm">

    <div class="card-header">
        <span class="fw-bold">我的訂單</span>
    </div>

    @if(Model.Orders == null || !Model.Orders.Any( ))
    {
        <!-- 沒有訂單 -->
        <div class="card-body">

            <div class="text-center py-5">

                <i class="bi bi-bag-x fs-1 text-muted"></i>

                <h5 class="mt-3">
                    尚未有訂單
                </h5>

                <p class="text-muted">
                    您目前還沒有任何訂單
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- 有訂單 -->
        <div class="card-body">

            @foreach(var item in Model.Orders)
            {
                <!-- 每一筆訂單 -->
                <div class="card mb-4 shadow-sm">

                    <!-- 賣家與訂單狀態 -->
                    <div class="card-header d-flex justify-content-between align-items-center">

                        <span>
                            賣家：
                            <span class="fw-bold">
                                @item.Seller.FullName
                            </span>
                        </span>

                        <span class="text-danger">
                            @PokemonCard.Helpers.OrderStatus.GetText(item.OrderStatus)
                        </span>

                    </div>

                    <!-- 商品內容 -->
                    <div class="card-body">

                        <div class="row align-items-center">

                            <div class="col-md-3">
                                <img src="@item.OrderItems.FirstOrDefault( )?.Product?.ProductImages.FirstOrDefault( )?.ImageUrl"
                                     width="150"
                                     height="150"
                                     alt="@item.OrderItems.FirstOrDefault( )?.Product?.ProductName"
                                     class="img-fluid">
                    

                            </div>

                            <div class="col-md-9">

                                <h5>
                                    @item.OrderItems.FirstOrDefault( )?.Product?.ProductName
                                </h5>

                                <p class="text-muted">
                                    規格：
                                </p>

                                <p>
                                    數量：@item.OrderItems.FirstOrDefault( )?.Quantity
                                </p>

                                <p class="fw-bold text-danger">
                                    訂單金額：@item.OrderAmount
                                </p>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>