@model PokemonCard.Models.Order

<div class="container-fluid">

    <!-- 頁面標題 -->
    <div class="mb-4">
        <h3 class="fw-bold">訂單詳細資料</h3>
    </div>


    <!-- 訂單詳細資料 -->
    <div class="card shadow-sm border-0">


        <!-- ==================== -->
        <!-- 訂單上方資訊 -->
        <!-- ==================== -->

        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <span class="text-muted me-2">
                        訂單編號
                    </span>

                    <span class="fw-bold">
                        @Model.OrderNo
                    </span>

                </div>


                <div>

                    <span class="text-muted me-2">
                        訂單狀態
                    </span>

                    <span class="badge bg-primary">

                        @PokemonCard.Helpers.OrderStatus.GetText(Model.OrderStatus)

                    </span>

                </div>

            </div>

        </div>



        <!-- ==================== -->
        <!-- 訂單進度 -->
        <!-- ==================== -->
        @{
            string status = Model.OrderStatus?.ToUpper( ) ?? "";

            int currentStep = status switch
            {
                "PENDING" => 1,
                "PAID" => 2,
                "PROCESSING" => 3,
                "SHIPPED" => 4,
                "COMPLETED" => 5,
                _ => 1
            };
        }

        <div class="card-body border-bottom py-4">

            <!-- 訂單編號 -->

            <div class="text-center mb-4">

                <h5 class="fw-bold mb-0">
                    訂單編號
                </h5>

                <small class="text-muted">
                    @Model.OrderNo
                </small>

            </div>


            <!-- ==================== -->
            <!-- 訂單進度 -->
            <!-- ==================== -->

            <div class="d-flex align-items-start justify-content-center">


                <!-- ==================== -->
                <!-- 1. 待付款 -->
                <!-- ==================== -->

                <div class="text-center">

                    <div class="rounded-circle
                        d-flex align-items-center justify-content-center mx-auto
                        @(currentStep > 1
                            ? "bg-primary text-white"
                            : currentStep == 1
                                ? "bg-primary text-white"
                                : "bg-light text-muted")"
                         style="width:45px;height:45px;">

                        @if(currentStep > 1)
                        {
                            <i class="bi bi-check-lg fs-5"></i>
                        }
                        else
                        {
                            <i class="bi bi-wallet2 fs-5"></i>
                        }

                    </div>

                    <div class="mt-2 fw-semibold">
                        待付款
                    </div>

                </div>


                <!-- 線 -->

                <div class="mt-3 @(currentStep >= 2 ? "bg-primary" : "bg-secondary-subtle")"
                     style="height:3px;width:90px;">
                </div>


                <!-- ==================== -->
                <!-- 2. 已付款 -->
                <!-- ==================== -->

                <div class="text-center">

                    <div class="rounded-circle
                        d-flex align-items-center justify-content-center mx-auto
                        @(currentStep >= 2
                            ? "bg-primary text-white"
                            : "bg-light text-muted")"
                         style="width:45px;height:45px;">

                        @if(currentStep > 2)
                        {
                            <i class="bi bi-check-lg fs-5"></i>
                        }
                        else
                        {
                            <i class="bi bi-credit-card fs-5"></i>
                        }

                    </div>

                    <div class="mt-2 fw-semibold">
                        已付款
                    </div>

                </div>


                <!-- 線 -->

                <div class="mt-3 @(currentStep >= 3 ? "bg-primary" : "bg-secondary-subtle")"
                     style="height:3px;width:90px;">
                </div>


                <!-- ==================== -->
                <!-- 3. 待出貨 -->
                <!-- ==================== -->

                <div class="text-center">

                    <div class="rounded-circle
                        d-flex align-items-center justify-content-center mx-auto
                        @(currentStep >= 3
                            ? "bg-primary text-white"
                            : "bg-light text-muted")"
                         style="width:45px;height:45px;">

                        @if(currentStep > 3)
                        {
                            <i class="bi bi-check-lg fs-5"></i>
                        }
                        else
                        {
                            <i class="bi bi-box-seam fs-5"></i>
                        }

                    </div>

                    <div class="mt-2 fw-semibold">
                        待出貨
                    </div>

                </div>


                <!-- 線 -->

                <div class="mt-3 @(currentStep >= 4 ? "bg-primary" : "bg-secondary-subtle")"
                     style="height:3px;width:90px;">
                </div>


                <!-- ==================== -->
                <!-- 4. 運送中 -->
                <!-- ==================== -->

                <div class="text-center">

                    <div class="rounded-circle
                        d-flex align-items-center justify-content-center mx-auto
                        @(currentStep >= 4
                            ? "bg-primary text-white"
                            : "bg-light text-muted")"
                         style="width:45px;height:45px;">

                        @if(currentStep > 4)
                        {
                            <i class="bi bi-check-lg fs-5"></i>
                        }
                        else
                        {
                            <i class="bi bi-truck fs-5"></i>
                        }

                    </div>

                    <div class="mt-2 fw-semibold">
                        運送中
                    </div>

                </div>


                <!-- 線 -->

                <div class="mt-3 @(currentStep >= 5 ? "bg-success" : "bg-secondary-subtle")"
                     style="height:3px;width:90px;">
                </div>


                <!-- ==================== -->
                <!-- 5. 已完成 -->
                <!-- ==================== -->

                <div class="text-center">

                    <div class="rounded-circle
                        d-flex align-items-center justify-content-center mx-auto
                        @(currentStep >= 5
                            ? "bg-success text-white"
                            : "bg-light text-muted")"
                         style="width:45px;height:45px;">

                        @if(currentStep >= 5)
                        {
                            <i class="bi bi-check-lg fs-5"></i>
                        }
                        else
                        {
                            <i class="bi bi-house-check fs-5"></i>
                        }

                    </div>

                    <div class="mt-2 fw-semibold
                        @(currentStep >= 5 ? "text-success" : "text-muted")">
                        已完成
                    </div>

                </div>

            </div>

        </div>



        <!-- ==================== -->
        <!-- 收件地址 -->
        <!-- ==================== -->

        <div class="card-body border-bottom">

            <h5 class="fw-bold mb-3">
                收件地址
            </h5>


            <div class="row">

                <div class="col-md-4">

                    <span class="text-muted">
                        姓名
                    </span>

                    <div class="fw-semibold mt-1">
                        @Model.ReceiverName
                    </div>

                </div>


                <div class="col-md-4">

                    <span class="text-muted">
                        電話
                    </span>

                    <div class="fw-semibold mt-1">
                        @Model.ReceiverPhone
                    </div>

                </div>


                <div class="col-md-4">

                    <span class="text-muted">
                        地址
                    </span>

                    <div class="fw-semibold mt-1">
                        @Model.ShippingAddress
                    </div>

                </div>

            </div>

        </div>



        <!-- ==================== -->
        <!-- 商品資訊 -->
        <!-- ==================== -->

        <div class="card-body border-bottom">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold mb-0">
                    商品資訊
                </h5>

                <span class="text-muted">
                    共 @Model.OrderItems.Sum(x => x.Quantity) 件商品
                </span>

            </div>


            @foreach(var item in Model.OrderItems)
            {

                <div class="row align-items-center py-3 border-bottom">


                    <!-- 商品圖片 -->

                    <div class="col-md-2 text-center">

                        <img src="@item.Product?.ProductImages.FirstOrDefault( )?.ImageUrl"
                             width="100"
                             height="100"
                             class="img-fluid rounded-3"
                             style="object-fit:cover;"
                             alt="@item.ProductName">

                    </div>



                    <!-- 商品名稱 -->

                    <div class="col-md-4">

                        <h6 class="fw-bold mb-2">
                            @item.ProductName
                        </h6>


                        <div class="text-muted">

                            規格：

                            @item.ProductSpec

                            @if(!string.IsNullOrEmpty(item.ProductSpec2))
                            {
                                <span>
                                    / @item.ProductSpec2
                                </span>
                            }

                        </div>


                        <div class="text-muted">

                            商品編號：

                            @item.ProductId

                        </div>

                    </div>



                    <!-- 數量 -->

                    <div class="col-md-2 text-center">

                        <div class="text-muted small">
                            數量
                        </div>

                        <div class="fw-semibold">
                            @item.Quantity
                        </div>

                    </div>



                    <!-- 單價 -->

                    <div class="col-md-2 text-center">

                        <div class="text-muted small">
                            單價
                        </div>

                        <div class="fw-semibold">

                            NT$ @item.UnitPrice.ToString("N0")

                        </div>

                    </div>



                    <!-- 小計 -->

                    <div class="col-md-2 text-end">

                        <div class="text-muted small">
                            小計
                        </div>

                        <div class="fw-bold text-danger">

                            NT$ @((item.UnitPrice * item.Quantity).ToString("N0"))

                        </div>

                    </div>


                </div>

            }

        </div>



        <!-- ==================== -->
        <!-- 金額明細 -->
        <!-- ==================== -->

        <div class="card-body">

            <div class="row justify-content-end">

                <div class="col-md-5">


                    <!-- 商品小計 -->

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            商品小計
                        </span>

                        <span>
                            NT$ @Model.OrderItems.Sum(x => x.UnitPrice * x.Quantity).ToString("N0")
                        </span>

                    </div>


                    <!-- 運費 -->

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            運費
                        </span>

                        <span>
                            NT$ @Model.ShipAmount.ToString("N0")
                        </span>

                    </div>


                    <!-- 折價 -->

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            折價券
                        </span>

                        <span class="text-danger">
                            -NT$ 0
                        </span>

                    </div>


                    <hr>


                    <!-- 訂單金額 -->

                    <div class="d-flex justify-content-between mb-3">

                        <span class="fw-bold fs-5">
                            訂單金額
                        </span>

                        <span class="fw-bold fs-5 text-danger">

                            NT$ @Model.OrderAmount.ToString("N0")

                        </span>

                    </div>


                    <!-- 訂單建立時間 -->

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            下單時間
                        </span>

                        <span>
                            @Model.OrderCreatedAt.ToString("yyyy/MM/dd HH:mm")
                        </span>

                    </div>


                </div>

            </div>

        </div>



        <!-- ==================== -->
        <!-- 評價 -->
        <!-- ==================== -->
        @if(Model.OrderStatus == "Completed")
        {

            <div class="card-body border-top">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h5 class="fw-bold mb-1">
                            商品評價
                        </h5>

                        <p class="text-muted mb-0">
                            分享你對這次購物的體驗
                        </p>

                    </div>


                    <button type="button"
                            class="btn btn-primary px-4">

                        <i class="bi bi-star me-1"></i>

                        前往評價

                    </button>

                </div>

            </div>

        }

    </div>

</div>
