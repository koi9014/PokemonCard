@model List<PokemonCard.Models.Order>

<div class="container-fluid">

    <!-- 頁面標題 -->
    <div class="mb-4">
        <h3 class="fw-bold">訂單完成與評價</h3>
    </div>




    <!-- 訂單詳細資料 -->
    <div class="card shadow-sm border-0">

        <!-- ==================== -->
        <!-- 訂單上方資訊 -->
        <!-- ==================== -->
        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <span class="text-muted me-2">訂單編號</span>
                    <span class="fw-bold">
                        ORD202608250001
                    </span>
                </div>

                <div>
                    <span class="text-muted me-2">訂單狀態</span>

                    <span class="badge bg-success">
                        已完成
                    </span>
                </div>

            </div>

        </div>


        <!-- ==================== -->
        <!-- 訂單進度 -->
        <!-- ==================== -->
        <div class="card-body border-bottom py-4">

            <div class="text-center mb-3">
                <h5 class="fw-bold mb-0">
                    訂單編號
                </h5>

                <small class="text-muted">
                    ORD202608250001
                </small>
            </div>


            <div class="d-flex align-items-center justify-content-center">

                <!-- 已付款 -->
                <div class="text-center">

                    <div class="rounded-circle text-white
                        d-flex align-items-center justify-content-center mx-auto"
                         style="width: 40px; height: 40px; background-color: #adb5bd;">

                        <i class="bi bi-check-lg"></i>

                    </div>

                    <div class="mt-2 fw-semibold">
                        已付款
                    </div>

                </div>


                <!-- 線 -->
                <div class="bg-primary"
                     style="height: 3px; width: 120px;">
                </div>


                <!-- 待出貨 -->
                <div class="text-center">

                    <div class="rounded-circle bg-primary text-white
                        d-flex align-items-center justify-content-center mx-auto"
                         style="width: 40px; height: 40px;">

                        <i class="bi bi-check-lg"></i>

                    </div>

                    <div class="mt-2 fw-semibold">
                        待出貨
                    </div>

                </div>


                <!-- 線 -->
                <div class="bg-primary"
                     style="height: 3px; width: 120px;">
                </div>


                <!-- 已完成 -->
                <div class="text-center">

                    <div class="rounded-circle bg-success text-white
                        d-flex align-items-center justify-content-center mx-auto"
                         style="width: 40px; height: 40px;">

                        <i class="bi bi-check-lg"></i>

                    </div>

                    <div class="mt-2 fw-semibold text-success">
                        已完成
                    </div>

                </div>

            </div>

        </div>


        <!-- ==================== -->
        <!-- 收件地址 -->
        <!-- ==================== -->
        <div class="card-body border-bottom">

            <h5 class="fw-bold mb-3">
                收件地址
            </h5>

            <div class="row">

                <div class="col-md-4">
                    <span class="text-muted">
                        姓名
                    </span>

                    <div class="fw-semibold mt-1">
                        王小明
                    </div>
                </div>


                <div class="col-md-4">
                    <span class="text-muted">
                        電話
                    </span>

                    <div class="fw-semibold mt-1">
                        0912-345-678
                    </div>
                </div>


                <div class="col-md-4">
                    <span class="text-muted">
                        地址
                    </span>

                    <div class="fw-semibold mt-1">
                        台北市中正區重慶南路一段100號
                    </div>
                </div>

            </div>

        </div>


        <!-- ==================== -->
        <!-- 商品資訊 -->
        <!-- ==================== -->
        <div class="card-body border-bottom">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold mb-0">
                    商品資訊
                </h5>

                <span class="text-muted">
                    共 2 件商品
                </span>

            </div>


            <!-- 商品 1 -->
            <div class="row align-items-center py-3 border-bottom">

                <!-- 商品圖片 -->
                <div class="col-md-2 text-center">

                    <div class="border rounded-3 d-flex align-items-center justify-content-center mx-auto"
                         style="width: 100px; height: 100px;">

                        <span class="text-muted">
                            商品圖片
                        </span>

                    </div>

                </div>


                <!-- 商品名稱 -->
                <div class="col-md-4">

                    <h6 class="fw-bold mb-2">
                        寶可夢卡牌 強化擴充包
                    </h6>

                    <div class="text-muted">
                        規格：黑色 / M
                    </div>

                    <div class="text-muted">
                        商品編號：PKM001
                    </div>

                </div>


                <!-- 數量 -->
                <div class="col-md-2 text-center">

                    <div class="text-muted small">
                        數量
                    </div>

                    <div class="fw-semibold">
                        2
                    </div>

                </div>


                <!-- 單價 -->
                <div class="col-md-2 text-center">

                    <div class="text-muted small">
                        單價
                    </div>

                    <div class="fw-semibold">
                        $250
                    </div>

                </div>


                <!-- 小計 -->
                <div class="col-md-2 text-end">

                    <div class="text-muted small">
                        小計
                    </div>

                    <div class="fw-bold text-danger">
                        $500
                    </div>

                </div>

            </div>


            <!-- 商品 2 -->
            <div class="row align-items-center py-3">

                <!-- 商品圖片 -->
                <div class="col-md-2 text-center">

                    <div class="border rounded-3 d-flex align-items-center justify-content-center mx-auto"
                         style="width: 100px; height: 100px;">

                        <span class="text-muted">
                            商品圖片
                        </span>

                    </div>

                </div>


                <!-- 商品名稱 -->
                <div class="col-md-4">

                    <h6 class="fw-bold mb-2">
                        寶可夢皮卡丘收藏卡
                    </h6>

                    <div class="text-muted">
                        規格：一般版
                    </div>

                    <div class="text-muted">
                        商品編號：PKM002
                    </div>

                </div>


                <!-- 數量 -->
                <div class="col-md-2 text-center">

                    <div class="text-muted small">
                        數量
                    </div>

                    <div class="fw-semibold">
                        1
                    </div>

                </div>


                <!-- 單價 -->
                <div class="col-md-2 text-center">

                    <div class="text-muted small">
                        單價
                    </div>

                    <div class="fw-semibold">
                        $300
                    </div>

                </div>


                <!-- 小計 -->
                <div class="col-md-2 text-end">

                    <div class="text-muted small">
                        小計
                    </div>

                    <div class="fw-bold text-danger">
                        $300
                    </div>

                </div>

            </div>

        </div>


        <!-- ==================== -->
        <!-- 金額明細 -->
        <!-- ==================== -->
        <div class="card-body">

            <div class="row justify-content-end">

                <div class="col-md-5">

                    <div class="d-flex justify-content-between mb-2">
                        <span>
                            商品小計
                        </span>

                        <span>
                            $800
                        </span>
                    </div>


                    <div class="d-flex justify-content-between mb-2">
                        <span>
                            運費
                        </span>

                        <span>
                            $60
                        </span>
                    </div>


                    <div class="d-flex justify-content-between mb-2">
                        <span>
                            折價券
                        </span>

                        <span class="text-danger">
                            -$100
                        </span>
                    </div>


                    <hr>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="fw-bold fs-5">
                            訂單金額
                        </span>

                        <span class="fw-bold fs-5 text-danger">
                            $760
                        </span>

                    </div>


                    <div class="d-flex justify-content-between">

                        <span>
                            付款方式
                        </span>

                        <span class="fw-semibold">
                            信用卡 / 金融卡
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ==================== -->
        <!-- 評價 -->
        <!-- ==================== -->
        <div class="card-body border-top">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        商品評價
                    </h5>

                    <p class="text-muted mb-0">
                        分享你對這次購物的體驗
                    </p>

                </div>

                <button type="button"
                        class="btn btn-primary px-4">

                    <i class="bi bi-star me-1"></i>
                    前往評價

                </button>

            </div>

        </div>

    </div>

</div>
