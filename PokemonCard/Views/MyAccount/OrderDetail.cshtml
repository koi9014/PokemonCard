@model PokemonCard.Models.Order

<div class="container-fluid">

    <!-- ==================== -->
    <!-- 頁面標題 -->
    <!-- ==================== -->

    <div class="mb-2">
        <button type="button"
                class="btn btn-link p-0 text-dark d-inline-flex align-items-center"
                onclick="history.back()"
                aria-label="返回上一頁"
                title="返回上一頁">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5"></path>
                <path d="m12 19-7-7 7-7"></path>
            </svg>
        </button>
    </div>
    <div class="mb-4">
        <h3 class="fw-bold">訂單詳細資料</h3>
    </div>

    @if (TempData["OrderSuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (TempData["OrderErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (string.Equals(Model.OrderStatus, "SHIPPED", StringComparison.OrdinalIgnoreCase)
        && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.BuyerId.ToString())
    {
        <div class="mb-4 text-end">
            <form asp-controller="MyAccount" asp-action="ConfirmReceipt" asp-route-id="@Model.OrderId" method="post" onsubmit="return confirm('確定已收到商品嗎？確認後訂單將完成。');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">確認收貨</button>
            </form>
        </div>
    }


    <!-- ==================== -->
    <!-- 訂單詳細資料 -->
    <!-- ==================== -->

    <div class="card shadow-sm border-0">


        <!-- ==================== -->
        <!-- 狀態處理 -->
        <!-- ==================== -->
        @{
            string status = Model.OrderStatus?.ToUpper( ) ?? "";
            var cancellationReason = Model.OrderHistories
                .Where(history => string.Equals(history.OrderStatus, "CANCELLED", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(history => history.ChangeTime)
                .Select(history => history.ChangeReason)
                .FirstOrDefault();

            int currentStep = status switch
            {
                "PENDING" => 1,
                "PAID" => 2,
                "PROCESSING" => 3,
                "SHIPPED" => 4,
                "COMPLETED" => 5,
                _ => 0
            };

            string statusClass = status switch
            {
                "PENDING" => "bg-warning text-dark",
                "PAID" => "bg-info text-dark",
                "PROCESSING" => "bg-primary",
                "SHIPPED" => "bg-primary",
                "COMPLETED" => "bg-success",
                "CANCELLED" => "bg-danger",
                _ => "bg-secondary"
            };
        }


        <!-- ==================== -->
        <!-- 訂單上方資訊 -->
        <!-- ==================== -->

        <div class="card-header bg-white border-bottom py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <span class="text-muted me-2">
                        訂單編號
                    </span>

                    <span class="fw-bold">
                        @Model.OrderNo
                    </span>

                </div>


                <div>

                    <span class="text-muted me-2">
                        訂單狀態
                    </span>

                    <span class="badge @statusClass">

                        @PokemonCard.Helpers.OrderStatus.GetText(Model.OrderStatus)

                    </span>

                </div>

            </div>

        </div>



        <!-- ==================== -->
        <!-- 訂單進度 / 已取消 -->
        <!-- ==================== -->
        @if(status == "CANCELLED")
        {
            <!-- ==================== -->
            <!-- 已取消 -->
            <!-- ==================== -->

            <div class="card-body border-bottom py-5">

                <div class="text-center">

                    <div class="rounded-circle
                        d-flex align-items-center justify-content-center mx-auto
                        bg-danger text-white"
                         style="width:70px;height:70px;">

                        <i class="bi bi-x-lg fs-3"></i>

                    </div>


                    <h5 class="fw-bold text-danger mt-3">
                        訂單已取消
                    </h5>


                    <p class="text-muted mb-0">
                        此訂單已取消，無法繼續進行後續流程。
                    </p>
                    @if (!string.IsNullOrWhiteSpace(cancellationReason))
                    {
                        <p class="mt-2 mb-0"><strong>取消原因：</strong>@cancellationReason</p>
                    }

                </div>

            </div>
        }
        else
        {
            <!-- ==================== -->
            <!-- 正常訂單進度 -->
            <!-- ==================== -->

            <div class="card-body border-bottom py-4">


                <!-- 訂單編號 -->

                <div class="text-center mb-4">

                    <h5 class="fw-bold mb-0">
                        訂單編號
                    </h5>

                    <small class="text-muted">
                        @Model.OrderNo
                    </small>

                </div>


                <!-- ==================== -->
                <!-- 訂單進度 -->
                <!-- ==================== -->

                <div class="d-flex align-items-start justify-content-center">


                    <!-- ==================== -->
                    <!-- 1. 待付款 -->
                    <!-- ==================== -->

                    <div class="text-center">

                        <div class="rounded-circle
                            d-flex align-items-center justify-content-center mx-auto
                            @(currentStep > 1
                                ? "bg-primary text-white"
                                : currentStep == 1
                                    ? "bg-primary text-white"
                                    : "bg-light text-muted")"
                             style="width:45px;height:45px;">

                            @if(currentStep > 1)
                            {
                                <i class="bi bi-check-lg fs-5"></i>
                            }
                            else
                            {
                                <i class="bi bi-wallet2 fs-5"></i>
                            }

                        </div>


                        <div class="mt-2 fw-semibold">
                            待付款
                        </div>

                    </div>


                    <!-- 線 -->

                    <div class="mt-3 @(currentStep >= 2 ? "bg-primary" : "bg-secondary-subtle")"
                         style="height:3px;width:90px;">
                    </div>



                    <!-- ==================== -->
                    <!-- 2. 已付款 -->
                    <!-- ==================== -->

                    <div class="text-center">

                        <div class="rounded-circle
                            d-flex align-items-center justify-content-center mx-auto
                            @(currentStep >= 2
                                ? "bg-primary text-white"
                                : "bg-light text-muted")"
                             style="width:45px;height:45px;">

                            @if(currentStep > 2)
                            {
                                <i class="bi bi-check-lg fs-5"></i>
                            }
                            else
                            {
                                <i class="bi bi-credit-card fs-5"></i>
                            }

                        </div>


                        <div class="mt-2 fw-semibold">
                            已付款
                        </div>

                    </div>


                    <!-- 線 -->

                    <div class="mt-3 @(currentStep >= 3 ? "bg-primary" : "bg-secondary-subtle")"
                         style="height:3px;width:90px;">
                    </div>



                    <!-- ==================== -->
                    <!-- 3. 待出貨 -->
                    <!-- ==================== -->

                    <div class="text-center">

                        <div class="rounded-circle
                            d-flex align-items-center justify-content-center mx-auto
                            @(currentStep >= 3
                                ? "bg-primary text-white"
                                : "bg-light text-muted")"
                             style="width:45px;height:45px;">

                            @if(currentStep > 3)
                            {
                                <i class="bi bi-check-lg fs-5"></i>
                            }
                            else
                            {
                                <i class="bi bi-box-seam fs-5"></i>
                            }

                        </div>


                        <div class="mt-2 fw-semibold">
                            待出貨
                        </div>

                    </div>


                    <!-- 線 -->

                    <div class="mt-3 @(currentStep >= 4 ? "bg-primary" : "bg-secondary-subtle")"
                         style="height:3px;width:90px;">
                    </div>



                    <!-- ==================== -->
                    <!-- 4. 運送中 -->
                    <!-- ==================== -->

                    <div class="text-center">

                        <div class="rounded-circle
                            d-flex align-items-center justify-content-center mx-auto
                            @(currentStep >= 4
                                ? "bg-primary text-white"
                                : "bg-light text-muted")"
                             style="width:45px;height:45px;">

                            @if(currentStep > 4)
                            {
                                <i class="bi bi-check-lg fs-5"></i>
                            }
                            else
                            {
                                <i class="bi bi-truck fs-5"></i>
                            }

                        </div>


                        <div class="mt-2 fw-semibold">
                            運送中
                        </div>

                    </div>


                    <!-- 線 -->

                    <div class="mt-3 @(currentStep >= 5 ? "bg-success" : "bg-secondary-subtle")"
                         style="height:3px;width:90px;">
                    </div>



                    <!-- ==================== -->
                    <!-- 5. 已完成 -->
                    <!-- ==================== -->

                    <div class="text-center">

                        <div class="rounded-circle
                            d-flex align-items-center justify-content-center mx-auto
                            @(currentStep >= 5
                                ? "bg-success text-white"
                                : "bg-light text-muted")"
                             style="width:45px;height:45px;">

                            @if(currentStep >= 5)
                            {
                                <i class="bi bi-check-lg fs-5"></i>
                            }
                            else
                            {
                                <i class="bi bi-house-check fs-5"></i>
                            }

                        </div>


                        <div class="mt-2 fw-semibold
                            @(currentStep >= 5
                                ? "text-success"
                                : "text-muted")">

                            已完成

                        </div>

                    </div>

                </div>

            </div>
        }



        <!-- ==================== -->
        <!-- 收件地址 -->
        <!-- ==================== -->

        <div class="card-body border-bottom">

            <h5 class="fw-bold mb-3">
                收件地址
            </h5>


            <div class="row">


                <!-- 姓名 -->

                <div class="col-md-4">

                    <span class="text-muted">
                        姓名
                    </span>

                    <div class="fw-semibold mt-1">
                        @Model.ReceiverName
                    </div>

                </div>


                <!-- 電話 -->

                <div class="col-md-4">

                    <span class="text-muted">
                        電話
                    </span>

                    <div class="fw-semibold mt-1">
                        @Model.ReceiverPhone
                    </div>

                </div>


                <!-- 地址 -->

                <div class="col-md-4">

                    <span class="text-muted">
                        地址
                    </span>

                    <div class="fw-semibold mt-1">
                        @Model.ShippingAddress
                    </div>

                </div>

            </div>

        </div>



        <!-- ==================== -->
        <!-- 商品資訊 -->
        <!-- ==================== -->

        <div class="card-body border-bottom">


            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold mb-0">
                    商品資訊
                </h5>

                <span class="text-muted">
                    共 @Model.OrderItems.Sum(x => x.Quantity) 件商品
                </span>

            </div>


            @foreach(var item in Model.OrderItems)
            {

                <div class="row align-items-center py-3 border-bottom">


                    <!-- 商品圖片 -->

                    <div class="col-md-2 text-center">

                        <img src="@item.Product?.ProductImages.FirstOrDefault( )?.ImageUrl"
                             width="100"
                             height="100"
                             class="img-fluid rounded-3"
                             style="object-fit:cover;"
                             alt="@item.ProductName">

                    </div>



                    <!-- 商品名稱 -->

                    <div class="col-md-4">

                        <h6 class="fw-bold mb-2">
                            @item.ProductName
                        </h6>


                        <div class="text-muted">

                            規格：

                            @item.ProductSpec

                            @if(!string.IsNullOrEmpty(item.ProductSpec2))
                            {
                                <span>
                                    / @item.ProductSpec2
                                </span>
                            }

                        </div>


                        <div class="text-muted">

                            商品編號：

                            @item.ProductId

                        </div>

                    </div>



                    <!-- 數量 -->

                    <div class="col-md-2 text-center">

                        <div class="text-muted small">
                            數量
                        </div>

                        <div class="fw-semibold">
                            @item.Quantity
                        </div>

                    </div>



                    <!-- 單價 -->

                    <div class="col-md-2 text-center">

                        <div class="text-muted small">
                            單價
                        </div>

                        <div class="fw-semibold">

                            NT$ @item.UnitPrice.ToString("N0")

                        </div>

                    </div>



                    <!-- 小計 -->

                    <div class="col-md-2 text-end">

                        <div class="text-muted small">
                            小計
                        </div>

                        <div class="fw-bold text-danger">

                            NT$ @((item.UnitPrice * item.Quantity).ToString("N0"))

                        </div>

                    </div>


                </div>

            }

        </div>



        <!-- ==================== -->
        <!-- 金額明細 -->
        <!-- ==================== -->

        <div class="card-body">

            <div class="row justify-content-end">

                <div class="col-md-5">


                    <!-- 商品小計 -->

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            商品小計
                        </span>

                        <span>
                            NT$ @Model.OrderItems.Sum(x => x.UnitPrice * x.Quantity).ToString("N0")
                        </span>

                    </div>


                    <!-- 運費 -->

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            運費
                        </span>

                        <span>
                            NT$ @Model.ShipAmount.ToString("N0")
                        </span>

                    </div>


                    <!-- 折價 -->

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            折價券
                        </span>

                        <span class="text-danger">
                            -NT$ 0
                        </span>

                    </div>


                    <hr>


                    <!-- 訂單金額 -->

                    <div class="d-flex justify-content-between mb-3">

                        <span class="fw-bold fs-5">
                            訂單金額
                        </span>

                        <span class="fw-bold fs-5 text-danger">

                            NT$ @Model.OrderAmount.ToString("N0")

                        </span>

                    </div>


                    <!-- 訂單建立時間 -->

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            下單時間
                        </span>

                        <span>
                            @Model.OrderCreatedAt.ToString("yyyy/MM/dd HH:mm")
                        </span>

                    </div>


                </div>

            </div>

        </div>



        <!-- ==================== -->
        <!-- 評價 -->
        <!-- ==================== -->
        @if(status == "COMPLETED")
        {

            <div class="card-body border-top">

                <div class="d-flex justify-content-between align-items-center">


                    <div>

                        <h5 class="fw-bold mb-1">
                            商品評價
                        </h5>

                        <p class="text-muted mb-0">
                            分享你對這次購物的體驗
                        </p>

                    </div>


                    <button type="button"
                            class="btn btn-primary px-4">

                        <i class="bi bi-star me-1"></i>

                        前往評價

                    </button>

                </div>

            </div>

        }

        @if (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.SellerId.ToString()
            && (status is "PENDING" or "PAID"))
        {
            <div class="card-body border-top">
                <div class="d-flex justify-content-between align-items-start gap-4">
                    <div>
                        <h5 class="fw-bold text-danger mb-1">取消訂單</h5>
                        <p class="text-muted mb-0">僅限尚未完成採購的訂單，取消原因將提供買家查看。</p>
                    </div>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelOrderModal">取消訂單</button>
                </div>
            </div>

            <div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form asp-controller="Seller" asp-action="CancelOrder" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@Model.OrderId" />
                            <div class="modal-header">
                                <h2 class="modal-title fs-5 fw-bold" id="cancelOrderModalLabel">取消訂單</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted">訂單：<strong>@Model.OrderNo</strong></p>
                                <label for="cancelReason" class="form-label fw-bold">取消原因</label>
                                <textarea id="cancelReason" name="cancelReason" maxlength="50" rows="3" required class="form-control" placeholder="例如：日本當地缺貨"></textarea>
                                <div class="form-text text-end"><span id="cancelReasonCount">0</span>/50</div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">返回</button>
                                <button type="submit" class="btn btn-danger" onclick="return confirm('確定要取消這筆訂單嗎？');">確認取消</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <script>
                const cancelReason = document.getElementById('cancelReason');
                cancelReason?.addEventListener('input', () => {
                    document.getElementById('cancelReasonCount').textContent = cancelReason.value.length;
                });
            </script>
        }

    </div>

</div>
