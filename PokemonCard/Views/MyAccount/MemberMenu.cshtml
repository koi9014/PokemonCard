@model PokemonCard.ViewModels.MemberCenterViewModel

<div class="seller-sidebar border rounded p-3">

    <h5 class="fw-bold mb-3">我的訂單</h5>

    <div class="list-group mb-4">
        <a asp-controller="MyAccount" asp-action="Index" class="list-group-item list-group-item-action">總覽</a>
        <a asp-controller="MyAccount" asp-action="Index" asp-route-status="PENDING" class="list-group-item list-group-item-action">待付款</a>
        <a asp-controller="MyAccount" asp-action="Index" asp-route-status="PAID" class="list-group-item list-group-item-action">已付款</a>
        <a asp-controller="MyAccount" asp-action="Index" asp-route-status="PROCESSING" class="list-group-item list-group-item-action">待出貨</a>
        <a asp-controller="MyAccount" asp-action="Index" asp-route-status="SHIPPED" class="list-group-item list-group-item-action">待收貨</a>
        <a asp-controller="MyAccount" asp-action="Index" asp-route-status="COMPLETED" class="list-group-item list-group-item-action">已完成</a>
        <a asp-controller="MyAccount" asp-action="Index" asp-route-status="CANCELLED" class="list-group-item list-group-item-action">已取消</a>
    </div>



    <h5 class="fw-bold mb-3">賣家中心</h5>

    <div class="list-group mb-4">
    <a asp-controller="UserLogin"
       asp-action="SellerApplication"
       class="list-group-item list-group-item-action">
        申請成為賣家
    </a>
    </div>

    <h5 class="fw-bold mb-3">服務與支援</h5>

    <div class="list-group">
        <a href="#" class="list-group-item list-group-item-action">
            常見問題
        </a>
        <a href="#" class="list-group-item list-group-item-action">
            聯絡客服
        </a>
    </div>

</div>
