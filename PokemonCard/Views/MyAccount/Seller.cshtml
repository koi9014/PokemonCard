@model PokemonCard.ViewModels.MemberCenterViewModel


<div class="seller-sidebar border rounded p-3">

    <h5 class="fw-bold mb-3">我的訂單</h5>

    <div class="list-group mb-4">
        <a href="#" class="list-group-item list-group-item-action">待付款</a>
        <a href="#" class="list-group-item list-group-item-action">待出貨</a>
        <a href="#" class="list-group-item list-group-item-action">待收貨</a>
        <a href="#" class="list-group-item list-group-item-action">已完成</a>
        <a href="#" class="list-group-item list-group-item-action">退貨</a>
    </div>

    <h5 class="fw-bold mb-3">賣家中心</h5>

    <div class="list-group mb-4">
        <a href="~/Seller/SellerHomepage" class="list-group-item list-group-item-action">賣家總覽</a>
        <a href="~/Seller/MyRevenue" class="list-group-item list-group-item-action">營收明細</a>
        <a href="~/Seller/ProductManage" class="list-group-item list-group-item-action">商品列表</a>
        <a href="~/Seller/AddProduct" class="list-group-item list-group-item-action">上架商品</a>

    </div>

    <h5 class="fw-bold mb-3">賣家訂單</h5>

    <div class="list-group mb-4">
        <a href="~/Seller/OrderManage" class="list-group-item list-group-item-action">訂單查詢</a>
        <a href="~/Seller/OrderManage?status=PROCESSING" class="list-group-item list-group-item-action">待出貨</a>
        <a href="~/Seller/OrderManage?status=COMPLETED" class="list-group-item list-group-item-action">已完成</a>
    </div>

    <h5 class="fw-bold mb-3">商店資訊</h5>

    <div class="list-group mb-4">
        <a href="~/Seller/MyStore" class="list-group-item list-group-item-action">查看商店</a>
        <a href="~/Seller/StoreSetting" class="list-group-item list-group-item-action">修改商店資料</a>
    </div>

    <h5 class="fw-bold mb-3">服務與支援</h5>

    <div class="list-group">
        <a href="#" class="list-group-item list-group-item-action">常見問題</a>
        <a href="#" class="list-group-item list-group-item-action">聯絡客服</a>
    </div>

</div>
