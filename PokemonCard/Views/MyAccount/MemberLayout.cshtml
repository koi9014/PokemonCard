@{
    Layout = "_Layout";
}
@model PokemonCard.ViewModels.MemberCenterViewModel


<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - PiCartChu</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~ /css/MemberLayout.css">

   
</head>

<body>
    <main class="member-main">
        <div class="row gx-3 gy-3">
            <aside class="col-lg-3">

@if (Model.IsSeller)
{
                    <partial name="seller" model="Model" />
}
else
{
                    <partial name="MemberMenu" model="Model" />
}
            </aside>
                <section class="col-lg-9">
                    @RenderBody( )
            </section>

   

        </div>
    </main>


    <div class="modal fade" id="filterModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">商品篩選</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="row align-items-center mb-3">
                        <div class="col-3">
                            <label class="fs-6 fw-semibold">價格：</label>
                        </div>

                        <div class="col-9">
                            <div class="d-flex align-items-center gap-2">
                                <input type="number"
                                       class="form-control"
                                       placeholder="最小值"
                                       min="0">

                                <span>-</span>

                                <input type="number"
                                       class="form-control"
                                       placeholder="最大值"
                                       min="0">
                            </div>
                        </div>
                    </div>

                    <div class="row align-items-center mb-3">
                        <div class="col-3">
                            <label class="fs-6 fw-semibold">分類：</label>
                        </div>

                        <div class="col-9">
                            <div class="dropdown">
                                <button class="btn btn-outline-primary dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown">
                                    商品分類
                                </button>

                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">3C商品</a></li>
                                    <li><a class="dropdown-item" href="#">服飾</a></li>
                                    <li><a class="dropdown-item" href="#">食品</a></li>
                                    <li><a class="dropdown-item" href="#">生活用品</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="row align-items-center mb-3">
                        <div class="col-3">
                            <label class="fs-6 fw-semibold">地區：</label>
                        </div>

                        <div class="col-9">
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-primary">台北</button>
                                <button class="btn btn-outline-primary">台中</button>
                            </div>
                        </div>
                    </div>

                    <div class="row align-items-center mb-3">
                        <div class="col-3">
                            <label class="fs-6 fw-semibold">顏色：</label>
                        </div>

                        <div class="col-9">
                            <button class="btn btn-outline-primary">
                                顏色選擇
                            </button>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        取消
                    </button>

                    <button class="btn btn-primary">
                        套用篩選
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>