@{
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - PiCartChu</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            :root {
                --primary: #EF5350;
                --primary-hover: #E53935;
                --tertiary: #42A5F5;
                --surface: #f4faff;
                --text: #0d1e25;
                --text-muted: #5a413f;
                --border: #e2bebb;
            }

            html, body {
                height: 100%;
            }

            body {
                margin: 0;
                background-color: var(--surface);
                color: var(--text);
                font-family: 'Inter', sans-serif;
                display: flex;
                flex-direction: column;
            }

            .member-header {
                height: 80px;
                background-color: #fff;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                z-index: 1030;
                box-shadow: 0 .125rem .25rem rgba(0, 0, 0, .075);
            }

            .member-header-inner {
                height: 80px;
            }

            .member-logo {
                height: 64px;
                width: auto;
                object-fit: contain;
            }

            .member-logo-text {
                color: #FFDE00;
                font-size: 24px;
                font-weight: 700;
                letter-spacing: 1px;
            }

            .member-search {
                max-width: 420px;
                width: 100%;
            }

            .member-search-box {
                height: 42px;
                border: 1px solid var(--border);
                border-radius: 50px;
                background-color: #fff;
                overflow: hidden;
                box-shadow: 0 .125rem .25rem rgba(0, 0, 0, .04);
            }

                .member-search-box .form-control {
                    border: none;
                    box-shadow: none;
                }

                    .member-search-box .form-control:focus {
                        border: none;
                        box-shadow: none;
                    }

            .member-search-icon {
                color: var(--tertiary);
                font-size: 20px;
            }

            .member-filter-button {
                border: none;
                background-color: transparent;
                color: var(--tertiary);
            }

                .member-filter-button:hover {
                    background-color: rgba(66, 165, 245, .08);
                    color: var(--tertiary);
                }

            .member-search-button {
                width: 48px;
                height: 100%;
                border: none;
                background-color: var(--tertiary);
                color: #fff;
            }

                .member-search-button:hover {
                    background-color: #1E88E5;
                }

            .member-header-link {
                color: var(--text-muted);
                font-size: 14px;
                text-decoration: none;
                transition: .2s;
            }

                .member-header-link:hover {
                    color: var(--tertiary);
                }

            .member-header-icon {
                color: var(--tertiary);
                font-size: 20px;
                text-decoration: none;
            }

                .member-header-icon:hover {
                    color: #1E88E5;
                    background-color: #f1f8ff;
                    border-radius: 8px;
                }

            .member-header-divider {
                height: 28px;
                border-left: 1px solid var(--border);
            }

            .member-login {
                color: var(--tertiary);
                font-size: 14px;
                font-weight: 700;
                text-decoration: none;
                padding: 8px 12px;
            }

                .member-login:hover {
                    color: #1E88E5;
                    background-color: rgba(66, 165, 245, .08);
                    border-radius: 8px;
                }

            .member-register {
                padding: 9px 20px;
                border-radius: 8px;
                background-color: var(--primary);
                color: #fff;
                font-size: 14px;
                font-weight: 700;
                text-decoration: none;
                transition: .2s;
            }

                .member-register:hover {
                    background-color: var(--primary-hover);
                    color: #fff;
                }

            .member-avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background-color: var(--primary);
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .member-main {
                width: 100%;

            }

            .member-footer {
                width: 100%;
                background-color: #f1f3f5;
                border-top: 1px solid var(--border);
                padding: 32px 0;
            }

            .member-footer-logo {
                height: 32px;
                width: auto;
                object-fit: contain;
                filter: grayscale(1);
                opacity: .7;
            }

            .member-footer-title {
                color: var(--text-muted);
                font-size: 18px;
                font-weight: 700;
            }

            .member-footer-text {
                color: var(--text-muted);
                font-size: 14px;
            }

            .member-footer-heading {
                color: var(--text);
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1px;
            }

            .member-footer-link {
                color: var(--text-muted);
                font-size: 14px;
                text-decoration: none;
            }

                .member-footer-link:hover {
                    color: var(--tertiary);
                }

            .member-footer-bottom {
                max-width: 1280px;
                margin: 32px auto 0;
                padding: 24px 32px 0;
                border-top: 1px solid rgba(226, 190, 187, .3);
                color: var(--text-muted);
                font-size: 14px;
                text-align: center;
            }
    </style>
</head>

<body>
    <main class="member-main">
        <div class="row gx-3 gy-3">

            <aside class="col-lg-3">
                <partial name="seller" />
            </aside>

            <section class="col-lg-9">
                <partial name="order" />
                @RenderBody( )
            </section>

        </div>
    </main>


    <div class="modal fade" id="filterModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">商品篩選</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="row align-items-center mb-3">
                        <div class="col-3">
                            <label class="fs-6 fw-semibold">價格：</label>
                        </div>

                        <div class="col-9">
                            <div class="d-flex align-items-center gap-2">
                                <input type="number"
                                       class="form-control"
                                       placeholder="最小值"
                                       min="0">

                                <span>-</span>

                                <input type="number"
                                       class="form-control"
                                       placeholder="最大值"
                                       min="0">
                            </div>
                        </div>
                    </div>

                    <div class="row align-items-center mb-3">
                        <div class="col-3">
                            <label class="fs-6 fw-semibold">分類：</label>
                        </div>

                        <div class="col-9">
                            <div class="dropdown">
                                <button class="btn btn-outline-primary dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown">
                                    商品分類
                                </button>

                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">3C商品</a></li>
                                    <li><a class="dropdown-item" href="#">服飾</a></li>
                                    <li><a class="dropdown-item" href="#">食品</a></li>
                                    <li><a class="dropdown-item" href="#">生活用品</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="row align-items-center mb-3">
                        <div class="col-3">
                            <label class="fs-6 fw-semibold">地區：</label>
                        </div>

                        <div class="col-9">
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-primary">台北</button>
                                <button class="btn btn-outline-primary">台中</button>
                            </div>
                        </div>
                    </div>

                    <div class="row align-items-center mb-3">
                        <div class="col-3">
                            <label class="fs-6 fw-semibold">顏色：</label>
                        </div>

                        <div class="col-9">
                            <button class="btn btn-outline-primary">
                                顏色選擇
                            </button>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        取消
                    </button>

                    <button class="btn btn-primary">
                        套用篩選
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>