<!DOCTYPE html>
<html lang="zh-Hant">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>會員中心</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>

<body>

    <!-- 導覽列 -->
    <nav class="navbar navbar-expand-lg bg-light border-bottom">
        <div class="container">

            <!-- Logo -->
            <a class="navbar-brand" href="#">
                PokemonCard
            </a>

            <!-- 搜尋欄 -->
            <div class="position-absolute start-50 translate-middle-x" style="width:40%;">
                <div class="input-group">
                    <input class="form-control" type="text" placeholder="搜尋商品">

                    <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#filterModal">

                        <i class="bi bi-funnel"></i>

                    </button>

                    <button class="btn btn-primary">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>

            <!-- 右側功能 -->
            <div class="d-flex align-items-center gap-3">
                <span>登入者名稱</span>

                <a href="#" class="text-decoration-none">🛒</a>

                <a href="#" class="text-decoration-none">
                    🔔 通知
                </a>
            </div>

        </div>
    </nav>


    <!-- 會員中心 -->
    <div class="container mt-4">

        <div class="row">

            <!-- 左側選單 -->
            <aside class="col-lg-3">

                <partial name="MemberMenu" />

            </aside>


            <!-- 右側內容 -->
            <main class="col-lg-9">

                <partial name="order" />

                @RenderBody( )

            </main>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>