<!DOCTYPE html>
<html lang="zh-Hant">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>會員中心</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>

<body>

    <!-- 導覽列 -->
    <nav class="navbar navbar-expand-lg bg-light border-bottom">
        <div class="container">

            <!-- Logo -->
            <a class="navbar-brand" href="#">
                Picartchu
            </a>

            <!-- 搜尋欄 -->
            <div class="position-absolute start-50 translate-middle-x" style="width:40%;">
                <div class="input-group">
                    <input class="form-control" type="text" placeholder="搜尋商品">

                    <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#filterModal">

                        <i class="bi bi-funnel"></i>

                    </button>

                    <button class="btn btn-primary">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>

            <!-- 右側功能 -->
            <div class="d-flex align-items-center gap-3">
                <span>登入者名稱</span>

                <a href="#" class="text-decoration-none">🛒</a>

                <a href="#" class="text-decoration-none">
                    🔔 通知
                </a>
            </div>

        </div>
    </nav>


    <!-- 會員中心 -->
    <div class="container mt-4">

        <div class="row">

            <!-- 左側選單 -->
            <aside class="col-lg-3">

                <partial name="seller" />

            </aside>


            <!-- 右側內容 -->
            <main class="col-lg-9">

                <partial name="order" />

                @RenderBody( )

            </main>

        </div>

    </div>
    <div class="modal fade" id="filterModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">商品篩選</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <!-- 價格 -->
                    <div class="row align-items-center mb-3">
                        <div class="col-3">
                            <label class="fs-5">價格：</label>
                        </div>

                        <div class="col-9">
                            <div class="d-flex gap-2">
                                <input type="number" class="form-control" placeholder="最小值" min="0" oninput="this.value = Math.max(0, this.value)">
                                <span class="d-flex align-items-center">-</span>
                                <input type="number" class="form-control" placeholder="最大值" min="0" oninput="this.value = Math.max(0, this.value)">
                            </div>
                        </div>
                    </div>


                    <!-- 分類 -->
                    <div class="row align-items-center mb-3">
                        <div class="col-3">
                            <label class="fs-5">分類：</label>
                        </div>

                        <div class="col-9">

                            <div class="dropdown">
                                <button class="btn btn-outline-primary dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown">
                                    商品分類
                                </button>

                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">3C商品</a></li>
                                    <li><a class="dropdown-item" href="#">服飾</a></li>
                                    <li><a class="dropdown-item" href="#">食品</a></li>
                                    <li><a class="dropdown-item" href="#">生活用品</a></li>
                                </ul>
                            </div>

                        </div>
                    </div>


                    <!-- 地區 -->
                    <div class="row align-items-center mb-3">
                        <div class="col-3">
                            <label class="fs-5">地區：</label>
                        </div>

                        <div class="col-9">
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-primary">台北</button>
                                <button class="btn btn-outline-primary">台中</button>
                            </div>
                        </div>
                    </div>


                    <!-- 顏色 -->
                    <div class="row align-items-center mb-3">
                        <div class="col-3">
                            <label class="fs-5">顏色：</label>
                        </div>

                        <div class="col-9">
                            <button class="btn btn-outline-primary">
                                顏色選擇
                            </button>
                        </div>
                    </div>

                </div>


                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">
                        取消
                    </button>

                    <button class="btn btn-primary">
                        套用篩選
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>