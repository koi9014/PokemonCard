<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PokemonCard</title>

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#EF5350", "on-primary": "#ffffff",
                        "secondary": "#26A69A", "tertiary": "#42A5F5",
                        "on-tertiary": "#ffffff", "success": "#66BB6A",
                        "error": "#EF5350", "surface": "#f4faff",
                        "on-surface": "#0d1e25", "on-surface-variant": "#5a413f",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f8fbfd",
                        "surface-container": "#eef5f9",
                        "surface-container-high": "#e3edf3",
                        "outline-variant": "#e2bebb"
                    }
                }
            }
        };
    </script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-[#f4faff] font-['Inter'] text-[#0d1e25] min-h-screen flex flex-col m-0">


    <header class="fixed top-0 w-full z-50 shadow-sm bg-white">
        <div class="h-20 w-full px-6 md:px-8 flex items-center justify-between gap-6 bg-white">
            <div class="flex items-center gap-6 flex-1">
                <a href="~/Home/Index">
                <div class="flex items-center gap-3">
                    <div class="h-16 w-auto shrink-0 flex items-center justify-center">
                        <img src="~/img/logo.png" alt="PiCartChu Logo" class="h-16 w-auto object-contain">
                    </div>
                    <span class="font-bold text-[24px] tracking-wide" style="color: #FFDE00;">PiCartChu</span>
                </div>
                </a>

                <form class="hidden md:flex max-w-md w-full ml-auto md:ml-margin-desktop gap-2" asp-controller="Home" asp-action="Index" method="get">
                    <div class="relative flex-1">
                    <input class="w-full px-5 py-2 bg-surface-container-lowest border border-outline-variant rounded-full text-body-lg focus:outline-none focus:border-tertiary focus:ring-2 focus:ring-tertiary/20 transition-all shadow-sm"
                           placeholder="搜尋寶可夢、卡片或周邊..."
                           name="search"
                           value="@ViewData["Search"]"
                           type="search">
                    <button type="submit"
                            class="absolute right-3 top-1/2 -translate-y-1/2
                        w-9 h-9 flex items-center justify-center
                        rounded-full text-tertiary hover:bg-surface-container">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                    </div>
                </form>

                    

           




            </div>
            <nav class="flex items-center gap-6">
                <a class="text-sm text-[#5a413f] hover:text-[#42A5F5] hidden lg:block transition-colors" href="#">使用說明</a>
                <div class="flex items-center gap-4 border-l border-[#e2bebb] pl-6">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <span class="text-sm text-[#5a413f] hidden md:block"> Hi, @User.Identity.Name</span>
                    }
                    else
                    {
                        <span class="text-sm text-[#5a413f] hidden md:block">遊客您好</span>
                    }
                    <a class="p-2 rounded-lg hover:bg-slate-100 text-[#42A5F5] transition-all relative" href="#"><span class="material-symbols-outlined">notifications</span></a>
                    <a class="p-2 rounded-lg hover:bg-slate-100 text-[#42A5F5] transition-all" href="#"><span class="material-symbols-outlined">shopping_cart</span></a>
                </div>
                <div class="flex items-center gap-2">
                    <a class="px-4 py-2 rounded-lg text-sm text-[#42A5F5] font-bold hover:bg-[#42A5F5]/10 transition-all" href="#">登入</a>
                    <a class="px-6 py-2 rounded-lg bg-[#EF5350] text-white text-sm font-bold shadow-sm hover:bg-[#E53935] hover:shadow-md transition-all" href="#">註冊</a>
                    <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center hover:shadow-md transition-all hover:bg-[#E53935]">
                        <a href="~/MyAccount/MemberCenter">
                        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

   

    <div class="w-full">
        <main class="w-full pt-28 pb-16 flex-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "max-w-[1600px]" : "max-w-[1280px]") mx-auto px-4 md:px-8">
            @RenderBody()
        </main>
    </div>

    <footer class="w-full bg-slate-100 py-8 border-t border-[#e2bebb] shrink-0">
        <div class="max-w-[1280px] mx-auto px-4 md:px-8 flex flex-col md:flex-row justify-between items-start gap-8">
            <div class="flex items-center gap-3">
                <img alt="PiCartChu Logo" class="h-8 w-auto grayscale opacity-70 object-contain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCcMx9CEfC3Mg2DZgGxzMI79Hd1llXj7piztOMsPqS1yyelB0BEkQjLacgztkZpqgcxml9sHIHb7sIpuMkIsKrf138Ad87VPqHxm7zXw7KdtiLTUpn6PHcuSOykM1ECsL_LhcaParxPXHIQum18lGrSXfJQljUHTvbxQ51M5N_eGqfSeDqNVTn86EKUJeQM2sFfup7yFj8PFbPLqp-4BGak138kALIHC8Uwec1c4zLPJiwPr6M00yKiIA">
                <div class="flex flex-col">
                <span class="font-bold text-lg text-[#5a413f]">PiCartChu</span>
                <p class="text-sm text-[#5a413f]">日本寶可夢代購媒合平台</p>
            </div>
            </div>

            <div class="flex gap-8">
                <div class="flex flex-col gap-2">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#0d1e25]">服務指南</h4>
                    <a class="text-sm text-[#5a413f] hover:text-[#42A5F5]" href="#">新手上路</a>
                    <a class="text-sm text-[#5a413f] hover:text-[#42A5F5]" href="#">運送方式</a>
                </div>
                <div class="flex flex-col gap-2">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#0d1e25]">隱私與條款</h4>
                    <a class="text-sm text-[#5a413f] hover:text-[#42A5F5]" href="#">服務條款</a>
                    <a class="text-sm text-[#5a413f] hover:text-[#42A5F5]" href="#">退貨須知</a>
                </div>
            </div>
        </div>
        <div class="max-w-[1280px] mx-auto px-4 md:px-8 mt-8 pt-6 border-t border-[#e2bebb]/30 text-center text-sm text-[#5a413f]">
            © 2026 PiCartChu 日本寶可夢代購. All rights reserved.
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
