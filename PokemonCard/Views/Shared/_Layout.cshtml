<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PokemonCard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Cart.css" />
    <script src="~/js/Cart.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@
    @* <link rel="stylesheet" href="~/PokemonCard.styles.css" asp-append-version="true" /> *@
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            "primary": "#EF5350",
                            "on-primary": "#ffffff",
                            "tertiary": "#42A5F5",
                            "success": "#66BB6A",
                            "surface": "#f4faff",
                            "on-surface": "#0d1e25",
                            "on-surface-variant": "#5a413f",
                            "surface-container-lowest": "#ffffff",
                            "outline-variant": "#e2bebb"
                        }
                    }
                }
            }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-[#f4faff] font-['Inter'] text-[#0d1e25] h-full flex flex-col m-0">

    <!-- 1. 最上方導覽列 (Header) -->
    <header class="fixed top-0 w-full z-50 shadow-sm bg-white">
        <div class="h-20 w-full px-6 md:px-8 flex items-center justify-between gap-6 bg-white">
            <div class="flex items-center gap-6 flex-1">
                <a href="~/Home/Index" class="no-underline">
                <div class="flex items-center gap-3">
                    <div class="h-16 w-auto shrink-0 flex items-center justify-center">
                        <img src="~/img/logo.png" alt="PiCartChu Logo" class="h-16 w-auto object-contain">
                    </div>
                    <span class="font-bold text-[24px] tracking-wide" style="color: #FFDE00;">PiCartChu</span>
                </div>
                    </a>

                <form method="post"
                      action="/Search/Index"
                      class="hidden md:flex relative max-w-md w-full ml-auto mr-8">

                    <input type="text"
                           name="Keyword"
                           placeholder="搜尋寶可夢、卡片或周邊..."
                           class="w-full pl-5 pr-14 py-2 bg-surface-container-lowest border border-outline-variant rounded-full text-body-lg focus:outline-none focus:border-tertiary focus:ring-2 focus:ring-tertiary/20 transition-all shadow-sm">

                    <button type="submit"
                            class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center rounded-full text-tertiary hover:bg-surface-container">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                </form>
            </div>

            <nav class="flex items-center gap-6">
                <!-- 使用說明按鈕 -->
                <a id="guideBtn" class="text-sm text-[#5a413f] hover:text-[#42A5F5] hidden lg:block transition-colors cursor-pointer" href="javascript:void(0);">使用說明</a>

                <div class="flex items-center gap-4 border-l border-[#e2bebb] pl-6">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <span class="text-sm text-[#5a413f] hidden md:block"> Hi, @User.Identity.Name</span>

                        <!-- 人頭選單 -->
                        <div class="relative inline-block text-left">
                            <button id="userDropdownBtn" type="button" class="p-2 rounded-lg hover:bg-slate-100 text-[#42A5F5] transition-all flex items-center justify-center focus:outline-none">
                                <span class="material-symbols-outlined">account_circle</span>
                            </button>

                            <!-- 下拉選單內容 -->
                            <div id="userDropdownMenu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-lg border border-slate-100 py-2 z-50">
                                <a class="block px-4 py-2 text-sm text-[#0d1e25] hover:bg-slate-50 transition-colors" asp-controller="UserLogin" asp-action="EditProfile">
                                    編輯個人資料
                                </a>
                                <div class="border-t border-slate-100 my-1"></div>
                                <a class="block px-4 py-2 text-sm text-[#0d1e25] no-underline hover:bg-slate-50 transition-colors" asp-controller="MyAccount" asp-action="order">
                                    會員中心
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <span class="text-sm text-[#5a413f] hidden md:block">遊客您好</span>
                    }

                    <!-- 購物車按鈕 -->
                    <a asp-controller="Cart"
                       asp-action="Index"
                       class="relative p-2 rounded-lg hover:bg-slate-100 text-[#42A5F5] transition-all">

                        <span class="material-symbols-outlined">
                            shopping_cart
                        </span>


                        <!-- 購物車數量紅點 -->
                        <span id="cartCount"
                              class="absolute -top-1 -right-1
                            bg-red-500 text-white
                            text-xs font-bold
                            rounded-full
                            min-w-[20px] h-[20px]
                            px-1
                            flex items-center justify-center
                            hidden">
                            0
                        </span>

                    </a>

                @if (User.Identity!.IsAuthenticated)
                {
                    <div class="flex items-center gap-2">
                        <form method="post" asp-controller="UserLogin" asp-action="Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="px-6 py-2 rounded-lg border border-[#EF5350] text-[#EF5350] text-sm font-bold hover:bg-[#EF5350]/10 transition-all">
                                登出
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-2">
                        <a class="px-4 py-2 rounded-lg text-sm text-[#42A5F5] font-bold hover:bg-[#42A5F5]/10 transition-all" asp-controller="UserLogin" asp-action="Login">登入</a>
                        <a class="px-6 py-2 rounded-lg bg-[#EF5350] text-white text-sm font-bold shadow-sm hover:bg-[#E53935] hover:shadow-md transition-all" asp-controller="UserLogin" asp-action="Register">註冊</a>
                    </div>
                }
            </nav>
        </div>
    </header>

    <!-- 2. 主頁面內容區塊 (Main) -->
    <div class="container">
        <main class="w-full pt-28 pb-16 flex-1 max-w-[1280px] mx-auto px-4 md:px-8">
            @RenderBody()
        </main>
    </div>

    <!-- 3. 使用說明教學彈窗 (Modal) -->
    <div class="modal fade" id="guideModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-2xl overflow-hidden border-0 shadow-2xl">
                <!-- 標頭 -->
                <div class="modal-header bg-slate-50 px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#42A5F5]">help</span>
                        <h5 class="font-bold text-lg text-[#0d1e25] m-0">網站使用指南</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- 內容區塊 (多步驟) -->
                <div class="modal-body p-6 md:p-8 min-h-[320px] flex flex-col justify-center">
                    <!-- Step 1 -->
                    <div class="guide-step flex flex-col items-center text-center gap-4" data-step="1">
                        <div class="w-16 h-16 bg-[#42A5F5]/10 rounded-full flex items-center justify-center text-[#42A5F5]">
                            <span class="material-symbols-outlined text-4xl">search</span>
                        </div>
                        <h6 class="font-bold text-xl text-[#0d1e25]">第一步：搜尋心儀的寶可夢商品</h6>
                        <p class="text-[#5a413f] text-sm max-w-md">
                            您可以在頂部搜尋欄輸入關鍵字，或是透過首頁的「地區」、「種類」與「系列」篩選標籤，快速找到想要代購的卡牌或周邊。
                        </p>
                    </div>

                    <!-- Step 2 -->
                    <div class="guide-step hidden flex flex-col items-center text-center gap-4" data-step="2">
                        <div class="w-16 h-16 bg-[#EF5350]/10 rounded-full flex items-center justify-center text-[#EF5350]">
                            <span class="material-symbols-outlined text-4xl">shopping_cart</span>
                        </div>
                        <h6 class="font-bold text-xl text-[#0d1e25]">第二步：加入購物車與委託代購</h6>
                        <p class="text-[#5a413f] text-sm max-w-md">
                            選擇想要的商品規格後加入購物車。點擊右上角購物車即可確認清單並送出日本代購媒合委託。
                        </p>
                    </div>

                    <!-- Step 3 -->
                    <div class="guide-step hidden flex flex-col items-center text-center gap-4" data-step="3">
                        <div class="w-16 h-16 bg-[#66BB6A]/10 rounded-full flex items-center justify-center text-[#66BB6A]">
                            <span class="material-symbols-outlined text-4xl">account_circle</span>
                        </div>
                        <h6 class="font-bold text-xl text-[#0d1e25]">第三步：會員中心追蹤訂單進度</h6>
                        <p class="text-[#5a413f] text-sm max-w-md">
                            登入後點擊右上角個人頭像進入「會員中心」，即可即時查看代購商品的採購狀況、國際運送進度與物流編號。
                        </p>
                    </div>
                </div>

                <!-- 底部按鈕區 -->
                <div class="modal-footer bg-slate-50 px-6 py-4 border-t border-slate-100 flex items-center justify-between">
                    <!-- 頁號指示點 -->
                    <div class="flex items-center gap-2">
                        <span class="step-dot w-2.5 h-2.5 rounded-full bg-[#42A5F5] transition-all" data-dot="1"></span>
                        <span class="step-dot w-2.5 h-2.5 rounded-full bg-slate-300 transition-all" data-dot="2"></span>
                        <span class="step-dot w-2.5 h-2.5 rounded-full bg-slate-300 transition-all" data-dot="3"></span>
                    </div>

                    <!-- 操作按鈕 -->
                    <div class="flex items-center gap-3">
                        <button type="button" id="prevGuideBtn" class="px-4 py-2 rounded-lg border border-slate-300 text-slate-600 text-sm font-bold hover:bg-slate-100 disabled:opacity-40 transition-all">
                            上一頁
                        </button>
                        <button type="button" id="nextGuideBtn" class="px-5 py-2 rounded-lg bg-[#42A5F5] text-white text-sm font-bold hover:bg-[#358bd8] transition-all">
                            下一頁
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. 最下方頁尾 (Footer) -->
    <footer class="w-full bg-slate-100 py-8 border-t border-[#e2bebb] shrink-0">
        <div class="max-w-[1280px] mx-auto px-4 md:px-8 flex flex-col md:flex-row justify-between items-start gap-8">
            <div class="flex items-center gap-3">
                <img alt="PiCartChu Logo" class="h-8 w-auto grayscale opacity-70 object-contain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCcMx9CEfC3Mg2DZgGxzMI79Hd1llXj7piztOMsPqS1yyelB0BEkQjLacgztkZpqgcxml9sHIHb7sIpuMkIsKrf138Ad87VPqHxm7zXw7KdtiLTUpn6PHcuSOykM1ECsL_LhcaParxPXHIQum18lGrSXfJQljUHTvbxQ51M5N_eGqfSeDqNVTn86EKUJeQM2sFfup7yFj8PFbPLqp-4BGak138kALIHC8Uwec1c4zLPJiwPr6M00yKiIA">
                <div class="flex flex-col">
                    <span class="font-bold text-lg text-[#5a413f]">PiCartChu</span>
                    <p class="text-sm text-[#5a413f]">日本寶可夢代購媒合平台</p>
                </div>
            </div>

            <div class="flex gap-8">
                <div class="flex flex-col gap-2">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#0d1e25]">服務指南</h4>
                    <a class="text-sm text-[#5a413f] hover:text-[#42A5F5]" href="#">新手上路</a>
                    <a class="text-sm text-[#5a413f] hover:text-[#42A5F5]" href="#">運送方式</a>
                </div>
                <div class="flex flex-col gap-2">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#0d1e25]">隱私與條款</h4>
                    <a class="text-sm text-[#5a413f] hover:text-[#42A5F5]" href="#">服務條款</a>
                    <a class="text-sm text-[#5a413f] hover:text-[#42A5F5]" href="#">退貨須知</a>
                </div>
            </div>
        </div>
        <div class="max-w-[1280px] mx-auto px-4 md:px-8 mt-8 pt-6 border-t border-[#e2bebb]/30 text-center text-sm text-[#5a413f]">
            © 2026 PiCartChu 日本寶可夢代購. All rights reserved.
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- JS 控制邏輯 -->
    <script>
            document.addEventListener('DOMContentLoaded', function() {
                // --- 1. 右上角人頭下拉選單 ---
                const btn = document.getElementById('userDropdownBtn');
                const menu = document.getElementById('userDropdownMenu');

                if (btn && menu) {
                    btn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        menu.classList.toggle('hidden');
                    });

                    document.addEventListener('click', function(e) {
                        if (!menu.contains(e.target) && !btn.contains(e.target)) {
                            menu.classList.add('hidden');
                        }
                    });
                }

                // --- 2. 使用說明彈窗多步驟切換 ---
                let currentStep = 1;
                const totalSteps = 3;

                const guideModalElement = document.getElementById('guideModal');
                const guideModal = guideModalElement ? new bootstrap.Modal(guideModalElement) : null;

                const guideBtn = document.getElementById('guideBtn');
                const prevBtn = document.getElementById('prevGuideBtn');
                const nextBtn = document.getElementById('nextGuideBtn');

                if (guideBtn && guideModal) {
                    guideBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        currentStep = 1;
                        updateStepView();
                        guideModal.show();
                    });
                }

                if (prevBtn) {
                    prevBtn.addEventListener('click', function() {
                        if (currentStep > 1) {
                            currentStep--;
                            updateStepView();
                        }
                    });
                }

                if (nextBtn) {
                    nextBtn.addEventListener('click', function() {
                        if (currentStep < totalSteps) {
                            currentStep++;
                            updateStepView();
                        } else {
                            guideModal.hide();
                        }
                    });
                }

                function updateStepView() {
                    // 切換 Step 內容
                    document.querySelectorAll('.guide-step').forEach(el => {
                        if (parseInt(el.getAttribute('data-step')) === currentStep) {
                            el.classList.remove('hidden');
                        } else {
                            el.classList.add('hidden');
                        }
                    });

                    // 切換指示點顏色
                    document.querySelectorAll('.step-dot').forEach(el => {
                        if (parseInt(el.getAttribute('data-dot')) === currentStep) {
                            el.classList.remove('bg-slate-300');
                            el.classList.add('bg-[#42A5F5]');
                        } else {
                            el.classList.remove('bg-[#42A5F5]');
                            el.classList.add('bg-slate-300');
                        }
                    });

                    // 控制上一頁按鈕
                    if (prevBtn) prevBtn.disabled = (currentStep === 1);

                    // 控制下一頁 / 完成按鈕
                    if (nextBtn) {
                        if (currentStep === totalSteps) {
                            nextBtn.textContent = '完成教學';
                            nextBtn.classList.remove('bg-[#42A5F5]', 'hover:bg-[#358bd8]');
                            nextBtn.classList.add('bg-[#66BB6A]', 'hover:bg-[#57a05b]');
                        } else {
                            nextBtn.textContent = '下一頁';
                            nextBtn.classList.remove('bg-[#66BB6A]', 'hover:bg-[#57a05b]');
                            nextBtn.classList.add('bg-[#42A5F5]', 'hover:bg-[#358bd8]');
                        }
                    }
                }
            });
    </script>
</body>
</html>
