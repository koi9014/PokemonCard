@{
    ViewData["Title"] = "日本地區訂單分析";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<style>
    #japan-region-map {
        height: 620px;
        min-height: 420px;
        width: 100%;
        background: #eef3f8;
    }

    .map-legend {
        background: rgba(255, 255, 255, 0.94);
        border-radius: 0.5rem;
        box-shadow: 0 0.15rem 0.75rem rgba(0, 0, 0, 0.16);
        color: #212529;
        font-size: 0.8rem;
        line-height: 1.4;
        padding: 0.75rem;
    }

    .map-legend i {
        border-radius: 0.2rem;
        display: inline-block;
        height: 0.9rem;
        margin-right: 0.35rem;
        vertical-align: -0.1rem;
        width: 0.9rem;
    }

    .region-map-label {
        background: transparent;
        border: 0;
        color: #ffffff;
        font-size: 1.15rem;
        font-weight: 700;
        pointer-events: none;
        text-align: center;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
        white-space: nowrap;
    }

    .analytics-pikachu-card img {
        height: 100px;
        image-rendering: pixelated;
        object-fit: contain;
        width: 100px;
    }

    .analytics-table {
        margin: 0 auto;
        max-width: 1100px;
        table-layout: fixed;
        width: 100%;
    }
</style>

<div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">日本八大地區及沖繩訂單分析</h1>
        <p class="text-secondary mb-0">依商品所在地彙整訂購件數、銷售額、訂單數與每月趨勢。</p>
    </div>
    <span id="analytics-status" class="badge text-bg-secondary px-3 py-2">資料讀取中</span>
</div>

<div id="analytics-error" class="alert alert-danger d-none" role="alert"></div>

<section class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div>
            <h2 class="h5 mb-1">日本八大地區及沖繩訂單熱力地圖</h2>
            <p class="small text-secondary mb-0">顏色深淺依地區訂購件數顯示；沖繩獨立統計。</p>
        </div>
        <div class="d-flex align-items-center gap-3 small text-secondary">
            <span id="analytics-period">資料期間：讀取中</span>
            <span>點擊區塊可查看該地區彙總</span>
        </div>
    </div>
    <div class="card-body p-0">
        <div id="japan-region-map" aria-label="日本八大地區及沖繩訂單熱力地圖"></div>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-secondary small mb-2">總訂購件數</div>
                <div id="total-order-quantity" class="fs-3 fw-bold">—</div>
                <div class="small text-secondary mt-2">所有八大地區及沖繩的訂購件數</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-secondary small mb-2">總銷售額</div>
                <div id="total-sales-amount" class="fs-3 fw-bold">—</div>
                <div class="small text-secondary mt-2">訂購件數 × 商品單價</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-secondary small mb-2">總訂單數</div>
                <div id="total-order-count" class="fs-3 fw-bold">—</div>
                <div class="small text-secondary mt-2">同一訂單跨區時會各區各計一次</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 analytics-pikachu-card">
            <div class="card-body d-flex align-items-center justify-content-center">
                <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/versions/generation-v/black-white/animated/25.gif"
                     alt="皮卡丘動態圖" />
            </div>
        </div>
    </div>
</div>

<section class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h2 class="h5 mb-0">各地區統計</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 analytics-table">
            <colgroup>
                <col style="width: 20%" />
                <col style="width: 25%" />
                <col style="width: 35%" />
                <col style="width: 20%" />
            </colgroup>
            <thead class="table-light">
                <tr>
                    <th scope="col">地區</th>
                    <th scope="col" class="text-center">訂購件數</th>
                    <th scope="col" class="text-center">銷售額</th>
                    <th scope="col" class="text-center">訂單數</th>
                </tr>
            </thead>
            <tbody id="region-statistics-body">
                <tr>
                    <td colspan="4" class="text-center text-secondary py-4">資料讀取中…</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section id="unclassified-card" class="card border-warning shadow-sm mt-4 d-none">
    <div class="card-header bg-warning-subtle py-3">
        <h2 class="h6 mb-0">待對照的商品所在地</h2>
    </div>
    <div id="unclassified-location-list" class="list-group list-group-flush"></div>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        (() => {
            const numberFormatter = new Intl.NumberFormat('zh-TW');
            const currencyFormatter = new Intl.NumberFormat('zh-TW', {
                style: 'currency',
                currency: 'TWD',
                maximumFractionDigits: 0
            });

            const escapeHtml = (value) => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');

            const prefecturesByRegion = {
                '北海道': ['北海道', 'Hokkaido'],
                '東北': ['青森', '青森県', 'Aomori', '岩手', '岩手県', 'Iwate', '宮城', '宮城県', 'Miyagi', '秋田', '秋田県', 'Akita', '山形', '山形県', 'Yamagata', '福島', '福島県', 'Fukushima'],
                '關東': ['茨城', '茨城県', 'Ibaraki', '栃木', '栃木県', 'Tochigi', '群馬', '群馬県', 'Gunma', '埼玉', '埼玉県', 'Saitama', '千葉', '千葉県', 'Chiba', '東京', '東京都', 'Tokyo', '神奈川', '神奈川県', 'Kanagawa'],
                '中部': ['新潟', '新潟県', 'Niigata', '富山', '富山県', 'Toyama', '石川', '石川県', 'Ishikawa', '福井', '福井県', 'Fukui', '山梨', '山梨県', 'Yamanashi', '長野', '長野県', 'Nagano', '岐阜', '岐阜県', 'Gifu', '静岡', '静岡県', 'Shizuoka', '愛知', '愛知県', 'Aichi'],
                '近畿': ['三重', '三重県', 'Mie', '滋賀', '滋賀県', 'Shiga', '京都', '京都府', 'Kyoto', '大阪', '大阪府', 'Osaka', '兵庫', '兵庫県', 'Hyogo', '奈良', '奈良県', 'Nara', '和歌山', '和歌山県', 'Wakayama'],
                '中國': ['鳥取', '鳥取県', 'Tottori', '島根', '島根県', 'Shimane', '岡山', '岡山県', 'Okayama', '広島', '広島県', 'Hiroshima', '山口', '山口県', 'Yamaguchi'],
                '四國': ['徳島', '徳島県', 'Tokushima', '香川', '香川県', 'Kagawa', '愛媛', '愛媛県', 'Ehime', '高知', '高知県', 'Kochi'],
                '九州': ['福岡', '福岡県', 'Fukuoka', '佐賀', '佐賀県', 'Saga', '長崎', '長崎県', 'Nagasaki', '熊本', '熊本県', 'Kumamoto', '大分', '大分県', 'Oita', '宮崎', '宮崎県', 'Miyazaki', '鹿児島', '鹿児島県', 'Kagoshima'],
                '沖繩': ['沖縄', '沖縄県', 'Okinawa']
            };

            const prefectureToRegion = new Map(
                Object.entries(prefecturesByRegion).flatMap(([region, prefectures]) =>
                    prefectures.map(prefecture => [prefecture, region]))
            );

            let map;
            let mapLayer;
            let legend;

            const labelPositions = {
                '北海道': [43.4, 142.1],
                '東北': [39.2, 140.8],
                '關東': [36.1, 140.2],
                '中部': [36.8, 137.3],
                '近畿': [34.6, 135.4],
                '中國': [34.7, 132.4],
                '四國': [33.7, 133.4],
                '九州': [32.1, 130.7],
                '沖繩': [26.4, 127.9]
            };

            const getRegionFromFeature = (feature) => {
                const properties = feature?.properties ?? {};
                return prefectureToRegion.get(properties.name)
                    ?? prefectureToRegion.get(properties.name_english)
                    ?? null;
            };

            const getColor = (quantity, maximum) => {
                if (!quantity) return '#e9ecef';

                const ratio = quantity / maximum;
                if (ratio > 0.8) return '#800026';
                if (ratio > 0.6) return '#bd0026';
                if (ratio > 0.4) return '#e31a1c';
                if (ratio > 0.2) return '#fc4e2a';
                return '#fd8d3c';
            };

            const updateLegend = (maximum) => {
                if (!legend) {
                    legend = L.control({ position: 'bottomright' });
                    legend.onAdd = () => {
                        const div = L.DomUtil.create('div', 'map-legend');
                        div.id = 'map-legend-content';
                        return div;
                    };
                    legend.addTo(map);
                }

                const unit = Math.max(1, Math.ceil(maximum / 5));
                document.getElementById('map-legend-content').innerHTML = `
                    <strong>訂購件數</strong><br>
                    <i style="background:#e9ecef"></i>0 件<br>
                    <i style="background:#fd8d3c"></i>1–${numberFormatter.format(unit)} 件<br>
                    <i style="background:#e31a1c"></i>${numberFormatter.format(unit + 1)}–${numberFormatter.format(unit * 3)} 件<br>
                    <i style="background:#800026"></i>${numberFormatter.format(unit * 3 + 1)} 件以上`;
            };

            const getRegionStyle = (region, maximum, isHighlighted = false) => ({
                color: isHighlighted ? '#111827' : '#343a40',
                fillColor: getColor(Number(region?.orderQuantity ?? 0), maximum),
                fillOpacity: isHighlighted ? 0.96 : 0.82,
                opacity: 1,
                weight: isHighlighted ? 2.2 : 1.1
            });

            const setGroupStyle = (group, region, maximum, isHighlighted) => {
                group.eachLayer(layer => layer.setStyle(getRegionStyle(region, maximum, isHighlighted)));
            };

            const getRegionPopup = (regionName, region) => `
                <div class="text-center">
                    <strong>${escapeHtml(regionName)}</strong><br>
                    訂購件數：${numberFormatter.format(region?.orderQuantity ?? 0)} 件<br>
                    銷售額：${currencyFormatter.format(region?.salesAmount ?? 0)}<br>
                    訂單數：${numberFormatter.format(region?.orderCount ?? 0)} 筆
                </div>`;

            const renderMap = async (data) => {
                if (typeof L === 'undefined') {
                    return;
                }

                const statisticsByRegion = new Map((data.regions ?? []).map(region => [region.region, region]));
                const maximumQuantity = Math.max(1, ...[...statisticsByRegion.values()].map(region => Number(region.orderQuantity ?? 0)));

                if (!map) {
                    map = L.map('japan-region-map', {
                        minZoom: 3,
                        scrollWheelZoom: false,
                        zoomControl: true
                    });
                }

                if (mapLayer) {
                    map.removeLayer(mapLayer);
                }

                try {
                    const response = await fetch('https://raw.githubusercontent.com/codeforamerica/click_that_hood/master/public/data/japan.geojson');
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }

                    const geoJson = await response.json();
                    const groupsByRegion = new Map(
                        [...statisticsByRegion.keys()].map(regionName => [regionName, L.featureGroup()])
                    );
                    mapLayer = L.featureGroup().addTo(map);

                    geoJson.features.forEach(feature => {
                        const regionName = getRegionFromFeature(feature);
                        const group = groupsByRegion.get(regionName);

                        if (!group) {
                            return;
                        }

                        const region = statisticsByRegion.get(regionName);
                        const prefectureLayer = L.geoJson(feature, {
                            style: getRegionStyle(region, maximumQuantity)
                        });
                        group.addLayer(prefectureLayer);
                    });

                    groupsByRegion.forEach((group, regionName) => {
                        const region = statisticsByRegion.get(regionName);

                        group.on({
                            mouseover: () => setGroupStyle(group, region, maximumQuantity, true),
                            mouseout: () => setGroupStyle(group, region, maximumQuantity, false),
                            click: event => L.popup()
                                .setLatLng(event.latlng)
                                .setContent(getRegionPopup(regionName, region))
                                .openOn(map)
                        });

                        mapLayer.addLayer(group);

                        const labelPosition = labelPositions[regionName];
                        if (labelPosition) {
                            const label = L.marker(labelPosition, {
                                icon: L.divIcon({
                                    className: 'region-map-label',
                                    html: escapeHtml(regionName),
                                    iconAnchor: [0, 0]
                                }),
                                interactive: false
                            });
                            mapLayer.addLayer(label);
                        }
                    });

                    map.fitBounds(mapLayer.getBounds(), { padding: [24, 24] });
                    updateLegend(maximumQuantity);
                } catch {
                    document.getElementById('japan-region-map').innerHTML = '<div class="h-100 d-flex align-items-center justify-content-center text-secondary">日本地圖資料讀取失敗，請確認網路連線後重新整理。</div>';
                }
            };

            const showError = (message) => {
                document.getElementById('analytics-error').textContent = message;
                document.getElementById('analytics-error').classList.remove('d-none');
                const status = document.getElementById('analytics-status');
                status.textContent = '資料讀取失敗';
                status.className = 'badge text-bg-danger px-3 py-2';
            };

            const renderAnalytics = (data) => {
                const regions = data.regions ?? [];
                const trends = data.monthlyTrend ?? [];
                const unclassified = data.unclassifiedLocations ?? [];

                const totalQuantity = regions.reduce((sum, region) => sum + Number(region.orderQuantity ?? 0), 0);
                const totalSales = regions.reduce((sum, region) => sum + Number(region.salesAmount ?? 0), 0);
                const totalOrders = regions.reduce((sum, region) => sum + Number(region.orderCount ?? 0), 0);
                const periodMonths = [...new Set(trends.map(trend => trend.month))].sort();

                document.getElementById('total-order-quantity').textContent = numberFormatter.format(totalQuantity) + ' 件';
                document.getElementById('total-sales-amount').textContent = currencyFormatter.format(totalSales);
                document.getElementById('total-order-count').textContent = numberFormatter.format(totalOrders) + ' 筆';
                document.getElementById('analytics-period').textContent = periodMonths.length
                    ? `資料期間：${periodMonths[0]} ～ ${periodMonths[periodMonths.length - 1]}`
                    : '資料期間：尚無訂單資料';

                document.getElementById('region-statistics-body').innerHTML = regions.map(region => `
                    <tr>
                        <th scope="row">${escapeHtml(region.region)}</th>
                        <td class="text-center">${numberFormatter.format(region.orderQuantity ?? 0)} 件</td>
                        <td class="text-center">${currencyFormatter.format(region.salesAmount ?? 0)}</td>
                        <td class="text-center">${numberFormatter.format(region.orderCount ?? 0)} 筆</td>
                    </tr>`).join('');

                if (unclassified.length) {
                    document.getElementById('unclassified-card').classList.remove('d-none');
                    document.getElementById('unclassified-location-list').innerHTML = unclassified.map(item => `
                        <div class="list-group-item d-flex justify-content-between align-items-center gap-3">
                            <span>${escapeHtml(item.location)}</span>
                            <span class="badge text-bg-warning">${numberFormatter.format(item.orderQuantity ?? 0)} 件</span>
                        </div>`).join('');
                }

                const status = document.getElementById('analytics-status');
                status.textContent = '已更新';
                status.className = 'badge text-bg-success px-3 py-2';

                renderMap(data);
            };

            fetch('@Url.Action("GetRegionOrderAnalytics", "RegionAnalytics")')
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    return response.json();
                })
                .then(renderAnalytics)
                .catch(() => showError('無法讀取地區訂單資料，請確認資料庫連線與管理員登入狀態。'));
        })();
    </script>
}
