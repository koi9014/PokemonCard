@model PokemonCard.Models.Product


@{
    ViewData["Title"] = "商品詳細資訊";
}

<link rel="stylesheet" href="~/css/Details.css">



<div class="container py-4">


    <!-- ========================== ===========
         商品主要區域
    ====================================== -->

    <div class="row g-5">


        <!-- =================================
             左側：商品圖片輪播
        ================================== -->

        <div class="col-lg-6">

            <!-- 商品圖片區 -->

            <div id="productCarousel"
                 class="carousel slide product-carousel"
                 data-bs-touch="true"
                 data-bs-interval="false">

                <div class="carousel-inner">

                    @{
                        int imageIndex = 0;
                    }

                    @foreach(var image in Model.ProductImages.OrderBy(x => x.ImageOrder))
                    {
                        <div class="carousel-item @(imageIndex == 0 ? "active" : "")">

                            <img src="@image.ImageUrl"
                                 alt="@Model.ProductName 商品圖片 @(imageIndex + 1)">

                        </div>

                        imageIndex++;
                    }

                </div>


                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#productCarousel"
                        data-bs-slide="prev">

                    <span class="carousel-control-prev-icon"></span>

                </button>


                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#productCarousel"
                        data-bs-slide="next">

                    <span class="carousel-control-next-icon"></span>

                </button>

            </div>


            <!-- ⭐ 注意：這裡已經在 product-carousel 外面 -->

            <div class="product-indicators">

                @for(int i = 0; i < Model.ProductImages.Count; i++)
                {
                    <button type="button"
                            data-bs-target="#productCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-label="商品圖片 @(i + 1)">
                    </button>
                }

            </div>




        </div>



        <!-- =================================
             右側：商品資訊
        ================================== -->

        <div class="col-lg-6">


            <!-- 商品分類 -->

            <div class="mb-3">

                <span class="badge bg-info text-dark px-3 py-2">
                    @Model.ProductType
                </span>

            </div>


            <!-- 商品名稱 -->

            <h1 class="product-title mb-3">

                @Model.ProductName

            </h1>



            <!-- ==========================
     商品規格
========================== -->

            <div class="mb-4">


                @foreach(var item in Model.ProductSpecs)
                {
<button type="button"
        class="product-option @(item == Model.ProductSpecs.FirstOrDefault() ? "active" : "")"
        data-price="@item.SpecsPrice"
        data-stock="@item.Stock"
        data-specification-id="@item.SpecificationId">

    <span class="option-name">
        @item.SpecsCategory1
    </span>

    <span class="option-price">
        NT$ @item.SpecsPrice
    </span>

</button>

                }
               
            </div>
            <!-- 價格 -->

            <div class="product-info-box mb-4">

                <div class="text-muted mb-1">
                    售價
                </div>

                <div class="product-price" id="productPrice">

                    NT$ @Model.ProductSpecs.FirstOrDefault( )?.SpecsPrice

                </div>

            </div>



            <!-- 數量 -->

            <div class="mb-4">

                <label class="form-label fw-bold">
                    購買數量
                </label>


                <div class="input-group quantity-box">

                    <button class="btn btn-outline-secondary"
                            type="button"
                            onclick="decreaseQuantity()">
                        −
                    </button>

                    <input id="quantity"
                           name="quantity"
                           type="number"
                           class="form-control text-center"
                           value="1"
                           min="1"
                           max="1"
                           readonly>

                    <button class="btn btn-outline-secondary"
                            type="button"
                            onclick="increaseQuantity()">
                        ＋
                    </button>

                </div>


            </div>


<!-- 購物按鈕 -->

<div class="row g-2 mb-4">

    <!-- 加入購物車 -->
    <div class="col-6">

        <button type="button"
                class="btn btn-cart w-100 py-2"
                onclick="handleAddToCart()">

            <span class="material-symbols-outlined align-middle">
                shopping_cart
            </span>

            加入購物車

        </button>

    </div>



                <!-- 立即購買 -->
                <div class="col-6">

                    <form asp-controller="Checkout"
                          asp-action="Index"
                          method="get">

                        <!-- 商品 ID -->
                        <input type="hidden"
                               name="productId"
                               value="@Model.ProductId" />

                        <!-- 規格 ID -->
                        <input type="hidden"
                               id="specificationId"
                               name="specificationId"
                               value="@Model.ProductSpecs.FirstOrDefault( )?.SpecificationId" />

                        <!-- 購買數量 -->
                        <input type="hidden"
                               id="checkoutQuantity"
                               name="quantity"
                               value="1" />

                        <button type="submit"
                                class="btn btn-buy w-100 py-2">

                            立即購買

                        </button>

                    </form>

                </div>

            </div>


            <!-- 商品基本資訊 -->

            <div class="row text-muted small">


                <div class="col-6 mb-3">

                    <strong>
                        商品狀態
                    </strong>

                    <br>

                    現貨

                </div>


                <div class="col-6 mb-3">

                    <strong>
                        估計配送
                    </strong>

                    <br>

                    7 - 14 天

                </div>


                

            </div>

        </div>

    </div>



    <!-- =====================================
         賣家資訊
    ====================================== -->

    <div class="seller-card mt-5">


        <div class="row align-items-center">


            <!-- 賣家頭像 -->

            <div class="col-auto">

                <img src="@Model.Seller.User.Avatar"
                     class="seller-avatar"
                     alt="賣家頭像">

            </div>


            <!-- 賣家資訊 -->

            <div class="col">

                <div class="seller-name">

                    @Model.Seller.StoreName

                </div>


                <div class="rating">

                    ★★★★★

                    <span class="text-muted">
                        5.0
                    </span>

                </div>


                <div class="text-muted small">

                    @Model.Seller.StoreDescription

                </div>

            </div>


            <!-- 評價 -->

            <div class="col-md-auto text-center mt-3 mt-md-0">

                <div class="fw-bold fs-5">

                    128

                </div>

                <div class="text-muted small">

                    評價

                </div>

            </div>


            <!-- 賣家商品 -->

            <div class="col-md-auto mt-3 mt-md-0">

                <a asp-controller="Seller"
                   asp-action="MyStore"
                   asp-route-sellerId="@Model.Seller.UserId"
                   class="btn btn-outline-warning">
                    查看賣家商品
                </a>

            </div>

        </div>

    </div>



    <!-- =====================================
         商品詳細說明
    ====================================== -->

    <div class="mt-5">


        <h3 class="fw-bold mb-3">

            商品詳細說明

        </h3>


        <div class="detail-box">

            @Model.Description


        </div>

    </div>

<!-- =====================================
     商品圖片放大 Modal
====================================== -->

<div class="modal fade"
     id="imageModal"
     tabindex="-1"
     aria-hidden="true">


    <div class="modal-dialog modal-dialog-centered modal-lg">


        <div class="modal-content">


            <div class="modal-header">

                <h5 class="modal-title">
                    商品圖片
                </h5>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body text-center">

                <img id="modalProductImage"
                     src=""
                     class="img-fluid"
                     alt="商品圖片">

            </div>


        </div>

    </div>

</div>
</div>

<!-- ==========================================
     加入購物車成功小視窗
========================================== -->

<div id="cartToast"
     class="cart-toast">

    <div class="cart-toast-header">

        <div class="cart-success-icon">

            <span class="material-symbols-outlined">
                check
            </span>

        </div>

        <div class="cart-success-text">

            已加入購物車

        </div>

        <button type="button"
                class="cart-toast-close"
                onclick="closeCartToast()">

            ×

        </button>

    </div>


    <div class="cart-toast-body">

        <img id="cartToastImage"
             src=""
             alt="商品圖片"
             class="cart-toast-image">


        <div class="cart-toast-info">

            <div id="cartToastProductName"
                 class="cart-toast-product-name">

                商品名稱

            </div>

            <div id="cartToastSpecification"
                 class="cart-toast-specification">

                規格

            </div>

            <div class="cart-toast-bottom">

                <span id="cartToastPrice"
                      class="cart-toast-price">

                    NT$ 0

                </span>

                <span>
                    ×
                </span>

                <span id="cartToastQuantity">
                    1
                </span>

            </div>

        </div>

    </div>


    <div class="cart-toast-footer">

        <button type="button"
                class="btn btn-outline-secondary"
                onclick="closeCartToast()">

            繼續購物

        </button>


        <a asp-controller="Cart"
           asp-action="Index"
           class="btn btn-warning">

            查看購物車

        </a>

    </div>

</div>


<!-- =====================================
     JavaScript
====================================== -->
<script>

    // ==========================================
    // 商品圖片放大
    // ==========================================

    document
        .querySelectorAll("#productCarousel img")
        .forEach(function (image) {

            image.addEventListener("click", function () {

                const modalImage =
                    document.getElementById("modalProductImage");

                if (modalImage) {
                    modalImage.src = this.src;

                    // 開啟 Bootstrap Modal
                    const modalElement =
                        document.getElementById("imageModal");

                    if (modalElement) {

                        const modal =
                            new bootstrap.Modal(modalElement);

                        modal.show();
                    }
                }

            });

        });


    // ==========================================
    // 商品圖片輪播 Indicator
    // ==========================================

    const productCarousel =
        document.getElementById("productCarousel");

    const productIndicators =
        document.querySelectorAll(
            ".product-indicators button"
        );


    if (productCarousel) {

        productCarousel.addEventListener(
            "slid.bs.carousel",
            function (event) {

                // 移除所有 active
                productIndicators.forEach(function (button) {

                    button.classList.remove("active");

                });


                // 設定目前圖片 indicator
                if (productIndicators[event.to]) {

                    productIndicators[event.to]
                        .classList.add("active");

                }

            }
        );

    }


    // ==========================================
    // 商品規格切換
    // ==========================================

    document
        .querySelectorAll(".product-option")
        .forEach(function (button) {

            button.addEventListener("click", function () {

                // ----------------------------------
                // 移除其他規格 active
                // ----------------------------------

                document
                    .querySelectorAll(".product-option")
                    .forEach(function (btn) {

                        btn.classList.remove("active");

                    });


                // ----------------------------------
                // 設定目前規格 active
                // ----------------------------------

                this.classList.add("active");


                // ----------------------------------
                // 取得規格資料
                // ----------------------------------

                const price =
                    parseInt(this.dataset.price) || 0;

                const stock =
                    parseInt(this.dataset.stock) || 0;

                const specificationId =
                    this.dataset.specificationId;


                // ----------------------------------
                // 更新商品價格
                // ----------------------------------

                const productPrice =
                    document.getElementById("productPrice");

                if (productPrice) {

                    productPrice.textContent =
                        "NT$ " +
                        price.toLocaleString();

                }


                // ----------------------------------
                // 更新購買數量
                // ----------------------------------

                const quantity =
                    document.getElementById("quantity");


                if (quantity) {

                    // 設定最大庫存
                    quantity.max = stock;


                    if (stock > 0) {

                        quantity.value = 1;

                    }
                    else {

                        quantity.value = 0;

                    }

                }


                // ----------------------------------
                // 更新購物車 SpecificationId
                // ----------------------------------

                const cartSpecificationId =
                    document.getElementById(
                        "cartSpecificationId"
                    );

                if (cartSpecificationId) {

                    cartSpecificationId.value =
                        specificationId;

                }


                // ----------------------------------
                // 更新立即購買 SpecificationId
                // ----------------------------------

                const checkoutSpecificationId =
                    document.getElementById(
                        "specificationId"
                    );

                if (checkoutSpecificationId) {

                    checkoutSpecificationId.value =
                        specificationId;

                }


                // ----------------------------------
                // 更新購物車數量
                // ----------------------------------

                const cartQuantity =
                    document.getElementById(
                        "cartQuantity"
                    );

                if (cartQuantity && quantity) {

                    cartQuantity.value =
                        quantity.value;

                }


                // ----------------------------------
                // 更新立即購買數量
                // ----------------------------------

                const checkoutQuantity =
                    document.getElementById(
                        "checkoutQuantity"
                    );

                if (checkoutQuantity && quantity) {

                    checkoutQuantity.value =
                        quantity.value;

                }

            });

        });


    // ==========================================
    // 增加購買數量
    // ==========================================

    function increaseQuantity() {

        const input =
            document.getElementById("quantity");


        if (!input) {
            return;
        }


        let current =
            parseInt(input.value) || 1;


        const max =
            parseInt(input.max) || 1;


        // 不可以超過庫存
        if (current < max) {

            current++;

            input.value = current;

        }


        // ----------------------------------
        // 同步購物車數量
        // ----------------------------------

        const cartQuantity =
            document.getElementById("cartQuantity");

        if (cartQuantity) {

            cartQuantity.value =
                input.value;

        }


        // ----------------------------------
        // 同步立即購買數量
        // ----------------------------------

        const checkoutQuantity =
            document.getElementById(
                "checkoutQuantity"
            );

        if (checkoutQuantity) {

            checkoutQuantity.value =
                input.value;

        }

    }


    // ==========================================
    // 減少購買數量
    // ==========================================

    function decreaseQuantity() {

        const input =
            document.getElementById("quantity");


        if (!input) {
            return;
        }


        let current =
            parseInt(input.value) || 1;


        const min =
            parseInt(input.min) || 1;


        // 不可以低於 1
        if (current > min) {

            current--;

            input.value = current;

        }


        // ----------------------------------
        // 同步購物車數量
        // ----------------------------------

        const cartQuantity =
            document.getElementById("cartQuantity");

        if (cartQuantity) {

            cartQuantity.value =
                input.value;

        }


        // ----------------------------------
        // 同步立即購買數量
        // ----------------------------------

        const checkoutQuantity =
            document.getElementById(
                "checkoutQuantity"
            );

        if (checkoutQuantity) {

            checkoutQuantity.value =
                input.value;

        }

    }

</script>
<script>

    // ==========================================
    // 加入購物車
    // ==========================================

    const addToCartForm =
        document.getElementById("addToCartForm");


    if (addToCartForm) {

        addToCartForm.addEventListener(
            "submit",
            async function (event) {

                // 防止表單重新整理
                event.preventDefault();


                // ----------------------------------
                // 取得資料
                // ----------------------------------

                const productId =
                    document.getElementById(
                        "cartProductId"
                    ).value;


                const specificationId =
                    document.getElementById(
                        "cartSpecificationId"
                    ).value;


                const quantity =
                    document.getElementById(
                        "cartQuantity"
                    ).value;


                // ----------------------------------
                // 建立 FormData
                // ----------------------------------

                const formData =
                    new FormData();


                formData.append(
                    "productId",
                    productId
                );


                formData.append(
                    "specificationId",
                    specificationId
                );


                formData.append(
                    "quantity",
                    quantity
                );


                try {

                    // ----------------------------------
                    // 呼叫 CartController
                    // ----------------------------------

                    const response =
                        await fetch(
                            "/Cart/Add",
                            {
                                method: "POST",

                                body: formData
                            }
                        );


                    // ----------------------------------
                    // 取得 JSON
                    // ----------------------------------

                    const result =
                        await response.json();


                    // ----------------------------------
                    // 成功
                    // ----------------------------------

                    if (result.success) {

                        showCartToast();

                    }
                    else {

                        alert("加入購物車失敗");

                    }

                }
                catch (error) {

                    console.error(
                        "加入購物車錯誤：",
                        error
                    );

                    alert(
                        "加入購物車失敗，請稍後再試。"
                    );

                }

            }
        );

    }


    // ==========================================
    // 顯示購物車小視窗
    // ==========================================

    function showCartToast() {

        const toast =
            document.getElementById(
                "cartToast"
            );


        if (!toast) {
            return;
        }


        // ----------------------------------
        // 商品名稱
        // ----------------------------------

const productName =
    document.getElementById("cartToastProductName");

if (productName) {
    productName.textContent =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductName));
}


        // ----------------------------------
        // 商品圖片
        // ----------------------------------

        const image =
            document.querySelector(
                "#productCarousel .carousel-item.active img"
            );


        const toastImage =
            document.getElementById(
                "cartToastImage"
            );


        if (image && toastImage) {

            toastImage.src =
                image.src;

        }


        // ----------------------------------
        // 規格
        // ----------------------------------

        const activeOption =
            document.querySelector(
                ".product-option.active"
            );


        const specification =
            document.getElementById(
                "cartToastSpecification"
            );


        if (activeOption && specification) {

            const optionName =
                activeOption.querySelector(
                    ".option-name"
                );


            if (optionName) {

                specification.textContent =
                    "規格：" +
                    optionName.textContent.trim();

            }

        }


        // ----------------------------------
        // 價格
        // ----------------------------------

        const price =
            document.getElementById(
                "productPrice"
            );


        const toastPrice =
            document.getElementById(
                "cartToastPrice"
            );


        if (price && toastPrice) {

            toastPrice.textContent =
                price.textContent;

        }


        // ----------------------------------
        // 數量
        // ----------------------------------

        const quantity =
            document.getElementById(
                "quantity"
            );


        const toastQuantity =
            document.getElementById(
                "cartToastQuantity"
            );


        if (quantity && toastQuantity) {

            toastQuantity.textContent =
                quantity.value;

        }


        // ----------------------------------
        // 顯示
        // ----------------------------------

        toast.classList.add("show");


        // ----------------------------------
        // 5 秒後自動關閉
        // ----------------------------------

        clearTimeout(
            window.cartToastTimer
        );


        window.cartToastTimer =
            setTimeout(function () {

                closeCartToast();

            }, 5000);

    }


    // ==========================================
    // 關閉購物車小視窗
    // ==========================================

    function closeCartToast() {

        const toast =
            document.getElementById(
                "cartToast"
            );


        if (toast) {

            toast.classList.remove(
                "show"
            );

        }

    }

</script>

<script>

    function handleAddToCart() {

        // ==========================================
        // 商品 ID
        // ==========================================

        const productId =
            @Model.ProductId;


        // ==========================================
        // 取得目前選中的規格
        // ==========================================

        const selectedOption =
            document.querySelector(
                ".product-option.active"
            );


        if (!selectedOption) {

            alert("請先選擇商品規格");

            return;
        }


        // ==========================================
        // 規格 ID
        // ==========================================

        const specificationId =
            selectedOption.dataset.specificationId;


        // ==========================================
        // 購買數量
        // ==========================================

        const quantityInput =
            document.getElementById("quantity");


        const quantity =
            parseInt(quantityInput.value) || 1;


        // ==========================================
        // 商品名稱
        // ==========================================

        const productName =
            document.getElementById(
                "cartToastProductName"
            );


        if (productName) {

            productName.textContent =
                "@Html.Raw(Model.ProductName)";

        }


        // ==========================================
        // 商品價格
        // ==========================================

        const price =
            selectedOption.dataset.price;


        const priceElement =
            document.getElementById(
                "cartToastPrice"
            );


        if (priceElement) {

            priceElement.textContent =
                "NT$ " +
                Number(price)
                    .toLocaleString();

        }


        // ==========================================
        // 商品規格
        // ==========================================

        const specification =
            document.getElementById(
                "cartToastSpecification"
            );


        if (specification) {

            specification.textContent =
                selectedOption
                    .querySelector(".option-name")
                    .textContent
                    .trim();

        }


        // ==========================================
        // 數量
        // ==========================================

        const toastQuantity =
            document.getElementById(
                "cartToastQuantity"
            );


        if (toastQuantity) {

            toastQuantity.textContent =
                quantity;

        }


        // ==========================================
        // 商品圖片
        // ==========================================

        const firstImage =
            document.querySelector(
                "#productCarousel .carousel-item.active img"
            );


        const toastImage =
            document.getElementById(
                "cartToastImage"
            );


        if (
            firstImage &&
            toastImage
        ) {

            toastImage.src =
                firstImage.src;

        }


        // ==========================================
        // 呼叫 CartController
        // ==========================================

        addToCart(
            productId,
            specificationId,
            quantity
        );

    }

</script>

