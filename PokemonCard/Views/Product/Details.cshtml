@model PokemonCard.Models.Product



@{
    ViewData["Title"] = "商品詳細資訊";
}

<style>

    /* ==============================
           商品圖片輪播
        ============================== */

    .product-carousel {
        background-color: #f4faff;
        border: 1px solid #e2bebb;
        border-radius: 20px;
        overflow: hidden;
    }

        .product-carousel .carousel-item {
            height: 430px;
        }

        .product-carousel img {
            width: 100%;
            height: 430px;
            object-fit: contain;
            cursor: pointer;
        }

    /* 輪播左右按鈕 */
    .carousel-control-prev,
    .carousel-control-next {
        width: 50px;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(0, 0, 0, 0.55);
        border-radius: 50%;
        padding: 22px;
        background-size: 50%;
    }

    /* 輪播指示點 */
    .carousel-indicators {
        margin-bottom: 20px;
    }

        .carousel-indicators button {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            border: 0;
            margin: 0 5px;
        }


    /* ==============================
           商品資訊
        ============================== */

    .product-title {
        font-size: 30px;
        font-weight: 700;
        color: #0d1e25;
    }

    .product-short-description {
        color: #5a413f;
        line-height: 1.8;
    }

    .product-price {
        color: #EF5350;
        font-size: 32px;
        font-weight: 700;
    }

    .product-info-box {
        border-top: 1px solid #e2bebb;
        border-bottom: 1px solid #e2bebb;
        padding: 20px 0;
    }


    /* ==============================
           數量按鈕
        ============================== */

    .quantity-box {
        width: 150px;
    }

        .quantity-box input {
            text-align: center;
        }


    /* ==============================
           購物車 / 購買按鈕
        ============================== */

    .btn-cart {
        color: #42A5F5;
        border: 1px solid #42A5F5;
        font-weight: 700;
    }

        .btn-cart:hover {
            background-color: #42A5F5;
            color: white;
        }

    .btn-buy {
        background-color: #EF5350;
        color: white;
        border: 1px solid #EF5350;
        font-weight: 700;
    }

        .btn-buy:hover {
            background-color: #E53935;
            color: white;
        }


    /* ==============================
           賣家資訊
        ============================== */

    .seller-card {
        background-color: white;
        border: 1px solid #e2bebb;
        border-radius: 16px;
        padding: 24px;
    }

    .seller-avatar {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 50%;
        border: 1px solid #ddd;
    }

    .seller-name {
        font-size: 20px;
        font-weight: 700;
    }

    .rating {
        color: #f5b301;
    }


    /* ==============================
           商品詳細說明
        ============================== */

    .detail-box {
        background-color: #fff4cc;
        border-radius: 20px;
        padding: 30px;
        line-height: 2;
        min-height: 180px;
    }


    /* ==============================
           商品規格
        ============================== */

    .spec-table th {
        width: 30%;
        background-color: #f8f9fa;
    }

    .product-indicators {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
    }

        .product-indicators button {
            width: 10px;
            height: 10px;
            padding: 0;
            margin: 0;
            border: none;
            border-radius: 50%;
            background-color: #cbd5e1;
            opacity: 1;
        }

            .product-indicators button.active {
                background-color: #42A5F5;
            }

    /* ==========================
       商品規格
    ========================== */

    .product-options {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }


    .product-option {
        min-width: 140px;
        padding: 12px 16px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #fff;
        text-align: left;
        cursor: pointer;
        transition: all 0.2s ease;
    }


        .product-option:hover {
            border-color: #ffc107;
            background: #fffaf0;
        }


        .product-option.active {
            border: 2px solid #ffc107;
            background: #fff8e1;
            color: #212529;
        }


        .product-option .option-name {
            display: block;
            font-weight: 600;
            margin-bottom: 4px;
        }


        .product-option .option-price {
            display: block;
            color: #dc3545;
            font-size: 14px;
            font-weight: 600;
        }

</style>


<div class="container py-4">


    <!-- ========================== ===========
         商品主要區域
    ====================================== -->

    <div class="row g-5">


        <!-- =================================
             左側：商品圖片輪播
        ================================== -->

        <div class="col-lg-6">

            <!-- 商品圖片區 -->

            <div id="productCarousel"
                 class="carousel slide product-carousel"
                 data-bs-touch="true"
                 data-bs-interval="false">

                <div class="carousel-inner">

                    @{
                        int imageIndex = 0;
                    }

                    @foreach(var image in Model.ProductImages.OrderBy(x => x.ImageOrder))
                    {
                        <div class="carousel-item @(imageIndex == 0 ? "active" : "")">

                            <img src="@image.ImageUrl"
                                 alt="@Model.ProductName 商品圖片 @(imageIndex + 1)">

                        </div>

                        imageIndex++;
                    }

                </div>


                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#productCarousel"
                        data-bs-slide="prev">

                    <span class="carousel-control-prev-icon"></span>

                </button>


                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#productCarousel"
                        data-bs-slide="next">

                    <span class="carousel-control-next-icon"></span>

                </button>

            </div>


            <!-- ⭐ 注意：這裡已經在 product-carousel 外面 -->

            <div class="product-indicators">

                @for(int i = 0; i < Model.ProductImages.Count; i++)
                {
                    <button type="button"
                            data-bs-target="#productCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-label="商品圖片 @(i + 1)">
                    </button>
                }

            </div>




        </div>



        <!-- =================================
             右側：商品資訊
        ================================== -->

        <div class="col-lg-6">


            <!-- 商品分類 -->

            <div class="mb-3">

                <span class="badge bg-info text-dark px-3 py-2">
                    @Model.ProductType
                </span>

            </div>


            <!-- 商品名稱 -->

            <h1 class="product-title mb-3">

                @Model.ProductName

            </h1>


            <!-- 商品簡介 -->

            <p class="product-short-description mb-4">

                @Model.Description

            </p>

            <!-- ==========================
     商品規格
========================== -->

            <div class="mb-4">


                @foreach(var item in Model.ProductSpecs)
                {
                    <button type="button"
                            class="product-option @(item == Model.ProductSpecs.FirstOrDefault( ) ? "active" : "")"
                            data-price="@item.SpecsPrice"
                            data-stock="@item.Stock"
                            data-option="收藏版">

                        <span class="option-name">
                            @item.SpecsCategory1
                        </span>

                        <span class="option-price">
                            NT$ @item.SpecsPrice
                        </span>

                    </button>
                }
               
            </div>
            <!-- 價格 -->

            <div class="product-info-box mb-4">

                <div class="text-muted mb-1">
                    售價
                </div>

                <div class="product-price" id="productPrice">

                    NT$ @Model.ProductSpecs.FirstOrDefault( )?.SpecsPrice

                </div>

            </div>



            <!-- 數量 -->

            <div class="mb-4">

                <label class="form-label fw-bold">
                    購買數量
                </label>


                <div class="input-group quantity-box">

                    <button class="btn btn-outline-secondary"
                            type="button"
                            onclick="decreaseQuantity()">
                        −
                    </button>

                    <input id="quantity"
                           name="quantity"
                           type="number"
                           class="form-control text-center"
                           value="1"
                           min="1"
                           max="1"
                           readonly>

                    <button class="btn btn-outline-secondary"
                            type="button"
                            onclick="increaseQuantity()">
                        ＋
                    </button>

                </div>


            </div>


            <!-- 購物按鈕 -->

            <div class="row g-2 mb-4">


                <div class="col-6">

                    <button type="button"
                            class="btn btn-cart w-100 py-2">

                        <span class="material-symbols-outlined align-middle">
                            shopping_cart
                        </span>

                        加入購物車

                    </button>

                </div>


                <div class="col-6">

                    <button type="button"
                            class="btn btn-buy w-100 py-2">

                        直接購買

                    </button>

                </div>

            </div>


            <!-- 商品基本資訊 -->

            <div class="row text-muted small">


                <div class="col-6 mb-3">

                    <strong>
                        商品狀態
                    </strong>

                    <br>

                    現貨

                </div>


                <div class="col-6 mb-3">

                    <strong>
                        估計配送
                    </strong>

                    <br>

                    7 - 14 天

                </div>


                

            </div>

        </div>

    </div>



    <!-- =====================================
         賣家資訊
    ====================================== -->

    <div class="seller-card mt-5">


        <div class="row align-items-center">


            <!-- 賣家頭像 -->

            <div class="col-auto">

                <img src="@Model.Seller.User.Avatar"
                     class="seller-avatar"
                     alt="賣家頭像">

            </div>


            <!-- 賣家資訊 -->

            <div class="col">

                <div class="seller-name">

                    @Model.Seller.StoreName

                </div>


                <div class="rating">

                    ★★★★★

                    <span class="text-muted">
                        5.0
                    </span>

                </div>


                <div class="text-muted small">

                    @Model.Seller.StoreDescription

                </div>

            </div>


            <!-- 評價 -->

            <div class="col-md-auto text-center mt-3 mt-md-0">

                <div class="fw-bold fs-5">

                    128

                </div>

                <div class="text-muted small">

                    評價

                </div>

            </div>


            <!-- 賣家商品 -->

            <div class="col-md-auto mt-3 mt-md-0">

                <button class="btn btn-outline-warning">

                    查看賣家商品

                </button>

            </div>

        </div>

    </div>



    <!-- =====================================
         商品詳細說明
    ====================================== -->

    <div class="mt-5">


        <h3 class="fw-bold mb-3">

            商品詳細說明

        </h3>


        <div class="detail-box">

            <p>
                本商品為日本寶可夢官方卡牌。
            </p>

            <p>
                商品皆由日本當地賣家購入，
                確認商品狀況後進行出貨。
            </p>

            <p>
                卡片狀況、包裝方式及實際商品內容
                請以商品圖片為準。
            </p>

            <p class="mb-0">
                如有任何商品相關問題，
                歡迎於購買前先聯絡賣家。
            </p>

        </div>

    </div>

<!-- =====================================
     商品圖片放大 Modal
====================================== -->

<div class="modal fade"
     id="imageModal"
     tabindex="-1"
     aria-hidden="true">


    <div class="modal-dialog modal-dialog-centered modal-lg">


        <div class="modal-content">


            <div class="modal-header">

                <h5 class="modal-title">
                    商品圖片
                </h5>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body text-center">

                <img id="modalProductImage"
                     src=""
                     class="img-fluid"
                     alt="商品圖片">

            </div>


        </div>

    </div>

</div>
</div>


<!-- =====================================
     JavaScript
====================================== -->

<script>

    // ==========================
    // 數量增加
    // ==========================

    function increaseQuantity() {

        const input =
            document.getElementById("quantity");

        let quantity =
            parseInt(input.value);

        quantity++;

        input.value = quantity;
    }


    // ==========================
    // 數量減少
    // ==========================

    function decreaseQuantity() {

        const input =
            document.getElementById("quantity");

        let quantity =
            parseInt(input.value);

        if (quantity > 1) {

            quantity--;

        }

        input.value = quantity;
    }


    // ==========================
    // 圖片放大
    // ==========================

    document
        .querySelectorAll("#productCarousel img")
        .forEach(function(image) {

            image.addEventListener("click", function() {

                const modalImage =
                    document.getElementById("modalProductImage");

                modalImage.src =
                    this.src;

            });

        });
            const productCarousel =
            document.getElementById("productCarousel");

        const productIndicators =
            document.querySelectorAll(
                ".product-indicators button"
            );


        productCarousel.addEventListener(
            "slid.bs.carousel",
            function(event) {

                // 移除所有 active
                productIndicators.forEach(function(button) {

                    button.classList.remove("active");

                });


                // 設定目前圖片的 indicator
                if (productIndicators[event.to]) {

                    productIndicators[event.to]
                        .classList.add("active");

                }

            }
        );


</script>

<script>

    // ==========================
    // 商品規格 / 價格切換
    // ==========================

    document
        .querySelectorAll(".product-option")
        .forEach(function(option) {

            option.addEventListener("click", function() {

                // 移除其他規格的 active
                document
                    .querySelectorAll(".product-option")
                    .forEach(function(item) {

                        item.classList.remove("active");

                    });


                // 設定目前規格
                this.classList.add("active");


                // 取得價格
                const price =
                    parseInt(this.dataset.price);


                // 更新價格
                document.getElementById("productPrice")
                    .textContent =
                    "NT$ " + price.toLocaleString();

            });

        });

</script>

<script>
    function increaseQuantity() {
        const input = document.getElementById("quantity");

        let quantity = parseInt(input.value) || 1;
        const max = parseInt(input.max);

        if (quantity < max) {
            input.value = quantity + 1;
        }
    }

    function decreaseQuantity() {
        const input = document.getElementById("quantity");

        let quantity = parseInt(input.value) || 1;
        const min = parseInt(input.min);

        if (quantity > min) {
            input.value = quantity - 1;
        }
    }
        // 選擇規格
    document.querySelectorAll(".product-option").forEach(function (button) {

        button.addEventListener("click", function () {

            document.querySelectorAll(".product-option")
                .forEach(function (btn) {
                    btn.classList.remove("active");
                });

            this.classList.add("active");

            const stock = parseInt(this.dataset.stock) || 0;

            const quantity = document.getElementById("quantity");

            quantity.max = stock;
            quantity.value = stock > 0 ? 1 : 0;
        });
    });


    // 增加數量
    function increaseQuantity() {

        const input = document.getElementById("quantity");

        const current = parseInt(input.value) || 1;
        const max = parseInt(input.max) || 1;

        if (current < max) {
            input.value = current + 1;
        }
    }


    // 減少數量
    function decreaseQuantity() {

        const input = document.getElementById("quantity");

        const current = parseInt(input.value) || 1;
        const min = parseInt(input.min) || 1;

        if (current > min) {
            input.value = current - 1;
        }
    }

</script>

