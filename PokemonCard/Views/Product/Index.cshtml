@{
    ViewData["Title"] = "商品詳細資訊";
}

<style>

    /* ==============================
           商品圖片輪播
        ============================== */

    .product-carousel {
        background-color: #f4faff;
        border: 1px solid #e2bebb;
        border-radius: 20px;
        overflow: hidden;
    }

        .product-carousel .carousel-item {
            height: 430px;
        }

        .product-carousel img {
            width: 100%;
            height: 430px;
            object-fit: contain;
            cursor: pointer;
        }

    /* 輪播左右按鈕 */
    .carousel-control-prev,
    .carousel-control-next {
        width: 50px;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(0, 0, 0, 0.55);
        border-radius: 50%;
        padding: 22px;
        background-size: 50%;
    }

    /* 輪播指示點 */
    .carousel-indicators {
        margin-bottom: 20px;
    }

        .carousel-indicators button {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            border: 0;
            margin: 0 5px;
        }


    /* ==============================
           商品資訊
        ============================== */

    .product-title {
        font-size: 30px;
        font-weight: 700;
        color: #0d1e25;
    }

    .product-short-description {
        color: #5a413f;
        line-height: 1.8;
    }

    .product-price {
        color: #EF5350;
        font-size: 32px;
        font-weight: 700;
    }

    .product-info-box {
        border-top: 1px solid #e2bebb;
        border-bottom: 1px solid #e2bebb;
        padding: 20px 0;
    }


    /* ==============================
           數量按鈕
        ============================== */

    .quantity-box {
        width: 150px;
    }

        .quantity-box input {
            text-align: center;
        }


    /* ==============================
           購物車 / 購買按鈕
        ============================== */

    .btn-cart {
        color: #42A5F5;
        border: 1px solid #42A5F5;
        font-weight: 700;
    }

        .btn-cart:hover {
            background-color: #42A5F5;
            color: white;
        }

    .btn-buy {
        background-color: #EF5350;
        color: white;
        border: 1px solid #EF5350;
        font-weight: 700;
    }

        .btn-buy:hover {
            background-color: #E53935;
            color: white;
        }


    /* ==============================
           賣家資訊
        ============================== */

    .seller-card {
        background-color: white;
        border: 1px solid #e2bebb;
        border-radius: 16px;
        padding: 24px;
    }

    .seller-avatar {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 50%;
        border: 1px solid #ddd;
    }

    .seller-name {
        font-size: 20px;
        font-weight: 700;
    }

    .rating {
        color: #f5b301;
    }


    /* ==============================
           商品詳細說明
        ============================== */

    .detail-box {
        background-color: #fff4cc;
        border-radius: 20px;
        padding: 30px;
        line-height: 2;
        min-height: 180px;
    }


    /* ==============================
           商品規格
        ============================== */

    .spec-table th {
        width: 30%;
        background-color: #f8f9fa;
    }

    .product-indicators {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
    }

        .product-indicators button {
            width: 10px;
            height: 10px;
            padding: 0;
            margin: 0;
            border: none;
            border-radius: 50%;
            background-color: #cbd5e1;
            opacity: 1;
        }

            .product-indicators button.active {
                background-color: #42A5F5;
            }

</style>


<div class="container py-4">


    <!-- ========================== ===========
         商品主要區域
    ====================================== -->

    <div class="row g-5">


        <!-- =================================
             左側：商品圖片輪播
        ================================== -->

        <div class="col-lg-6">

            <!-- 商品圖片區 -->

            <div id="productCarousel"
                 class="carousel slide product-carousel"
                 data-bs-touch="true"
                 data-bs-interval="false">

                <!-- 圖片 -->
                <div class="carousel-inner">

                    <div class="carousel-item active">

                        <img src="https://images.pokemontcg.io/base1/58.png"
                             alt="皮卡丘商品圖片">

                    </div>

                    <div class="carousel-item">

                        <img src="https://images.pokemontcg.io/base1/4.png"
                             alt="商品圖片 2">

                    </div>

                    <div class="carousel-item">

                        <img src="https://images.pokemontcg.io/jungle/51.png"
                             alt="商品圖片 3">

                    </div>

                    <div class="carousel-item">

                        <img src="https://images.pokemontcg.io/jungle/54.png"
                             alt="商品圖片 4">

                    </div>

                </div>


                <!-- 左箭頭 -->

                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#productCarousel"
                        data-bs-slide="prev">

                    <span class="carousel-control-prev-icon"></span>

                </button>


                <!-- 右箭頭 -->

                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#productCarousel"
                        data-bs-slide="next">

                    <span class="carousel-control-next-icon"></span>

                </button>

            </div>


            <!-- ⭐ 注意：這裡已經在 product-carousel 外面 -->

            <div class="product-indicators">

                <button type="button"
                        data-bs-target="#productCarousel"
                        data-bs-slide-to="0"
                        class="active">
                </button>

                <button type="button"
                        data-bs-target="#productCarousel"
                        data-bs-slide-to="1">
                </button>

                <button type="button"
                        data-bs-target="#productCarousel"
                        data-bs-slide-to="2">
                </button>

                <button type="button"
                        data-bs-target="#productCarousel"
                        data-bs-slide-to="3">
                </button>

            </div>



        </div>



        <!-- =================================
             右側：商品資訊
        ================================== -->

        <div class="col-lg-6">


            <!-- 商品分類 -->

            <div class="mb-3">

                <span class="badge bg-info text-dark px-3 py-2">
                    寶可夢卡牌
                </span>

            </div>


            <!-- 商品名稱 -->

            <h1 class="product-title mb-3">

                皮卡丘 Pokémon Card

            </h1>


            <!-- 商品簡介 -->

            <p class="product-short-description mb-4">

                日本寶可夢官方卡牌，
                適合收藏與喜愛皮卡丘的玩家。
                商品由日本當地賣家購入。

            </p>


            <!-- 價格 -->

            <div class="product-info-box mb-4">

                <div class="text-muted mb-1">
                    售價
                </div>

                <div class="product-price">

                    NT$ 580

                </div>

            </div>


            <!-- 數量 -->

            <div class="mb-4">

                <label class="form-label fw-bold">
                    購買數量
                </label>


                <div class="input-group quantity-box">

                    <button class="btn btn-outline-secondary"
                            type="button"
                            onclick="decreaseQuantity()">

                        −

                    </button>


                    <input id="quantity"
                           type="text"
                           class="form-control"
                           value="1"
                           readonly>


                    <button class="btn btn-outline-secondary"
                            type="button"
                            onclick="increaseQuantity()">

                        ＋

                    </button>

                </div>

            </div>


            <!-- 購物按鈕 -->

            <div class="row g-2 mb-4">


                <div class="col-6">

                    <button type="button"
                            class="btn btn-cart w-100 py-2">

                        <span class="material-symbols-outlined align-middle">
                            shopping_cart
                        </span>

                        加入購物車

                    </button>

                </div>


                <div class="col-6">

                    <button type="button"
                            class="btn btn-buy w-100 py-2">

                        直接購買

                    </button>

                </div>

            </div>


            <!-- 商品基本資訊 -->

            <div class="row text-muted small">


                <div class="col-6 mb-3">

                    <strong>
                        商品編號
                    </strong>

                    <br>

                    PC001

                </div>


                <div class="col-6 mb-3">

                    <strong>
                        商品狀態
                    </strong>

                    <br>

                    現貨

                </div>


                <div class="col-6">

                    <strong>
                        商品所在地
                    </strong>

                    <br>

                    日本

                </div>


                <div class="col-6">

                    <strong>
                        估計配送
                    </strong>

                    <br>

                    7 - 14 天

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================
         賣家資訊
    ====================================== -->

    <div class="seller-card mt-5">


        <div class="row align-items-center">


            <!-- 賣家頭像 -->

            <div class="col-auto">

                <img src="https://i.pravatar.cc/150?img=12"
                     class="seller-avatar"
                     alt="賣家頭像">

            </div>


            <!-- 賣家資訊 -->

            <div class="col">

                <div class="seller-name">

                    PikachuShop

                </div>


                <div class="rating">

                    ★★★★★

                    <span class="text-muted">
                        5.0
                    </span>

                </div>


                <div class="text-muted small">

                    日本寶可夢商品專門賣家

                </div>

            </div>


            <!-- 評價 -->

            <div class="col-md-auto text-center mt-3 mt-md-0">

                <div class="fw-bold fs-5">

                    128

                </div>

                <div class="text-muted small">

                    評價

                </div>

            </div>


            <!-- 賣家商品 -->

            <div class="col-md-auto mt-3 mt-md-0">

                <button class="btn btn-outline-warning">

                    查看賣家商品

                </button>

            </div>

        </div>

    </div>



    <!-- =====================================
         商品詳細說明
    ====================================== -->

    <div class="mt-5">


        <h3 class="fw-bold mb-3">

            商品詳細說明

        </h3>


        <div class="detail-box">

            <p>
                本商品為日本寶可夢官方卡牌。
            </p>

            <p>
                商品皆由日本當地賣家購入，
                確認商品狀況後進行出貨。
            </p>

            <p>
                卡片狀況、包裝方式及實際商品內容
                請以商品圖片為準。
            </p>

            <p class="mb-0">
                如有任何商品相關問題，
                歡迎於購買前先聯絡賣家。
            </p>

        </div>

    </div>



    <!-- =====================================
         商品規格
    ====================================== -->

    <div class="mt-5">


        <h3 class="fw-bold mb-3">

            商品資訊

        </h3>


        <div class="table-responsive">

            <table class="table table-bordered spec-table">


                <tbody>


                    <tr>

                        <th>
                            商品類型
                        </th>

                        <td>
                            寶可夢卡牌
                        </td>

                    </tr>


                    <tr>

                        <th>
                            品牌
                        </th>

                        <td>
                            Pokémon
                        </td>

                    </tr>


                    <tr>

                        <th>
                            商品狀態
                        </th>

                        <td>
                            全新
                        </td>

                    </tr>


                    <tr>

                        <th>
                            商品來源
                        </th>

                        <td>
                            日本
                        </td>

                    </tr>


                    <tr>

                        <th>
                            商品編號
                        </th>

                        <td>
                            PC001
                        </td>

                    </tr>


                </tbody>

            </table>

        </div>

    </div>


</div>



<!-- =====================================
     商品圖片放大 Modal
====================================== -->

<div class="modal fade"
     id="imageModal"
     tabindex="-1"
     aria-hidden="true">


    <div class="modal-dialog modal-dialog-centered modal-lg">


        <div class="modal-content">


            <div class="modal-header">

                <h5 class="modal-title">
                    商品圖片
                </h5>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body text-center">

                <img id="modalProductImage"
                     src=""
                     class="img-fluid"
                     alt="商品圖片">

            </div>


        </div>

    </div>

</div>



<!-- =====================================
     JavaScript
====================================== -->

<script>

    // ==========================
    // 數量增加
    // ==========================

    function increaseQuantity() {

        const input =
            document.getElementById("quantity");

        let quantity =
            parseInt(input.value);

        quantity++;

        input.value = quantity;
    }


    // ==========================
    // 數量減少
    // ==========================

    function decreaseQuantity() {

        const input =
            document.getElementById("quantity");

        let quantity =
            parseInt(input.value);

        if (quantity > 1) {

            quantity--;

        }

        input.value = quantity;
    }


    // ==========================
    // 圖片放大
    // ==========================

    document
        .querySelectorAll("#productCarousel img")
        .forEach(function(image) {

            image.addEventListener("click", function() {

                const modalImage =
                    document.getElementById("modalProductImage");

                modalImage.src =
                    this.src;

            });

        });

</script>
