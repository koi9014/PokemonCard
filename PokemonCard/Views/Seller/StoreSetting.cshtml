@model PokemonCard.Controllers.StoreSettingInput
@{
    Layout = "~/Views/MyAccount/MemberLayout.cshtml";
    ViewData["Title"] = Model.IsCreate ? "建立賣場" : "修改賣場資料";
}

<div class="mx-auto w-full max-w-2xl rounded-xl border border-[#e2bebb] bg-white p-6 shadow-sm">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-[#0d1e25]">@(Model.IsCreate ? "建立賣場" : "修改賣場資料")</h1>
        <p class="mt-1 text-sm text-[#5a413f]">@(Model.IsCreate ? "填寫資料來建立你的賣場。" : "更新賣場名稱、介紹與頭像。")</p>
    </div>

    @if (TempData["StoreSettingSuccess"] is string successMessage)
    {
        <div class="mb-5 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-green-700">@successMessage</div>
    }
    @if (TempData["StoreSettingInfo"] is string infoMessage)
    {
        <div class="mb-5 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-blue-700">@infoMessage</div>
    }

    <form asp-action="StoreSetting" method="post" enctype="multipart/form-data" class="space-y-6">
        @Html.AntiForgeryToken()
        <input asp-for="IsCreate" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="rounded-lg bg-red-50 p-4 text-sm text-red-700"></div>

        <section>
            <label class="mb-2 block text-sm font-bold text-[#0d1e25]">賣場頭像</label>
            <div class="flex flex-wrap items-center gap-4">
                <div class="flex h-24 w-24 items-center justify-center overflow-hidden rounded-full border border-[#e2bebb] bg-[#f4faff]">
                    <img id="avatar-preview" src="@Model.AvatarUrl" alt="賣場頭像預覽" class="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? "hidden " : "")h-full w-full object-cover" />
                    <span id="avatar-placeholder" class="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? "" : "hidden ")text-sm text-[#5a413f]">尚無圖片</span>
                </div>
                <div>
                    <label class="inline-flex cursor-pointer items-center rounded-lg border border-[#42a5f5] px-4 py-2 text-sm font-bold text-[#00609a] hover:bg-[#eef5f9]">
                        選擇圖片
                        <input asp-for="Avatar" id="avatar" accept="image/jpeg,image/png,image/webp" class="hidden" />
                    </label>
                    <p class="mt-2 text-xs text-[#5a413f]">支援 JPG、PNG、WEBP，最大 5 MB。</p>
                    <span asp-validation-for="Avatar" class="mt-1 block text-sm text-red-700"></span>
                </div>
            </div>
        </section>

        <section>
            <label asp-for="StoreName" class="mb-2 block text-sm font-bold text-[#0d1e25]">賣場名稱</label>
            <input asp-for="StoreName" maxlength="50" class="w-full rounded-lg border border-[#e2bebb] px-4 py-3 outline-none focus:border-[#42a5f5]" />
            <span asp-validation-for="StoreName" class="mt-1 block text-sm text-red-700"></span>
        </section>

        <section>
            <label asp-for="StoreDescription" class="mb-2 block text-sm font-bold text-[#0d1e25]">賣場介紹</label>
            <textarea asp-for="StoreDescription" maxlength="100" rows="4" class="w-full resize-none rounded-lg border border-[#e2bebb] px-4 py-3 outline-none focus:border-[#42a5f5]" placeholder="簡單介紹你的賣場"></textarea>
            <p class="mt-1 text-xs text-[#5a413f]">最多 100 個字。</p>
            <span asp-validation-for="StoreDescription" class="mt-1 block text-sm text-red-700"></span>
        </section>

        <div class="flex justify-end gap-3 border-t border-[#e2bebb] pt-5">
            <a asp-controller="MyAccount" asp-action="Order" class="rounded-lg border border-[#e2bebb] px-5 py-2.5 font-bold text-[#5a413f]">返回</a>
            <button type="submit" class="rounded-lg bg-[#ef5350] px-5 py-2.5 font-bold text-white hover:bg-[#e53935]">@(Model.IsCreate ? "建立賣場" : "儲存變更")</button>
        </div>
    </form>
</div>

<script>
    document.getElementById('avatar')?.addEventListener('change', event => {
        const file = event.target.files?.[0];
        if (!file) return;
        const preview = document.getElementById('avatar-preview');
        preview.src = URL.createObjectURL(file);
        preview.classList.remove('hidden');
        document.getElementById('avatar-placeholder')?.classList.add('hidden');
    });
</script>
