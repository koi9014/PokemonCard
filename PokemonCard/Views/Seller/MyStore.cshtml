@model PokemonCard.Controllers.SellerStoreViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Seller.StoreName;
}

<link rel="stylesheet" href="~/css/Details.css" asp-append-version="true" />

<div class="container py-4">
    <section class="seller-card mb-5">
        <div class="row align-items-center g-3">
            <div class="col-auto">
                @if (!string.IsNullOrWhiteSpace(Model.Seller.User.Avatar))
                {
                    <img src="@Model.Seller.User.Avatar" class="seller-avatar" alt="@Model.Seller.StoreName 賣家頭像" />
                }
                else
                {
                    <div class="seller-avatar d-flex align-items-center justify-content-center bg-light text-muted">店</div>
                }
            </div>
            <div class="col">
                <h1 class="seller-name mb-2">@Model.Seller.StoreName</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Seller.StoreDescription))
                {
                    <p class="text-muted mb-0">@Model.Seller.StoreDescription</p>
                }
                else
                {
                    <p class="text-muted mb-0">此賣家尚未填寫賣場介紹。</p>
                }
            </div>
            <div class="col-md-auto text-center">
                <div class="fw-bold fs-5">@(Model.ReviewCount == 0 ? "尚無評價" : $"★ {Model.AverageRating:F1}")</div>
                <div class="text-muted small">@Model.ReviewCount 則賣家評價</div>
            </div>
        </div>
    </section>

    <section class="card mb-5 shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h2 class="h4 fw-bold mb-1">賣家評價</h2>
                    @if (Model.ReviewCount > 0)
                    {
                        <span class="text-warning fw-bold">★ @Model.AverageRating.ToString("F1")</span>
                        <span class="text-muted">（@Model.ReviewCount 則評價）</span>
                    }
                    else
                    {
                        <span class="text-muted">目前尚無賣家評價</span>
                    }
                </div>
                @if (Model.Reviews.Any())
                {
                    <button id="toggle-reviews" type="button" class="btn btn-outline-primary">查看全部評價</button>
                }
            </div>

            @if (Model.Reviews.Any())
            {
                <div id="review-list" class="d-none mt-4 border-top pt-3">
                    @foreach (var review in Model.Reviews)
                    {
                        var stars = new string('★', Math.Clamp(review.Rating, 0, 5));
                        <article class="border-bottom py-3">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <strong>@review.ReviewerName</strong>
                                <span class="text-muted small">@review.CreatedAt.ToString("yyyy/MM/dd")</span>
                            </div>
                            <div class="text-warning small mt-1">@stars</div>
                            <p class="mb-0 mt-2">@(string.IsNullOrWhiteSpace(review.Comment) ? "買家未留下文字評價。" : review.Comment)</p>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <div class="d-flex flex-column gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">賣場商品</h2>
            <p class="text-muted mb-0">顯示 @Model.Products.Count 件已上架商品</p>
        </div>
        @if (Model.Categories.Any())
        {
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="fw-bold me-1">商品分類</span>
                <a href="@Url.Action("MyStore", new { sellerId = Model.Seller.UserId })" class="btn btn-sm @(string.IsNullOrWhiteSpace(Model.ProductType) ? "btn-primary" : "btn-outline-primary")">全部</a>
                @foreach (var category in Model.Categories)
                {
                    <a href="@Url.Action("MyStore", new { sellerId = Model.Seller.UserId, productType = category })" class="btn btn-sm @(Model.ProductType == category ? "btn-primary" : "btn-outline-primary")">@category</a>
                }
            </div>
        }
    </div>

    @if (Model.Products.Any())
    {
        <div class="row g-4">
            @foreach (var product in Model.Products)
            {
                var firstImage = product.ProductImages.OrderBy(image => image.ImageOrder).FirstOrDefault()?.ImageUrl;
                var prices = product.ProductSpecs.Select(spec => spec.SpecsPrice).ToList();
                var minPrice = prices.Count > 0 ? prices.Min() : 0;
                var maxPrice = prices.Count > 0 ? prices.Max() : 0;

                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm">
                        <div class="d-flex align-items-center justify-content-center bg-light" style="height:220px;">
                            @if (!string.IsNullOrWhiteSpace(firstImage))
                            {
                                <img src="@firstImage" class="img-fluid" style="width:100%; height:100%; object-fit:contain;" alt="@product.ProductName" />
                            }
                            else
                            {
                                <span class="text-muted">暫無商品圖片</span>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            @if (!string.IsNullOrWhiteSpace(product.ProductType))
                            {
                                <span class="badge bg-info text-dark mb-2 align-self-start">@product.ProductType</span>
                            }
                            <h5 class="card-title">@product.ProductName</h5>
                            <p class="text-danger fw-bold fs-5 mt-auto mb-3">
                                @if (prices.Count == 0)
                                {
                                    @:價格未定
                                }
                                else if (minPrice == maxPrice)
                                {
                                    @:NT$ @minPrice.ToString("N0")
                                }
                                else
                                {
                                    @:NT$ @minPrice.ToString("N0") ~ @maxPrice.ToString("N0")
                                }
                            </p>
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-outline-primary w-100">查看商品</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="rounded border bg-light p-5 text-center text-muted">此賣場目前沒有已上架商品。</div>
    }
</div>

<script>
    const toggleReviews = document.getElementById('toggle-reviews');
    const reviewList = document.getElementById('review-list');
    toggleReviews?.addEventListener('click', () => {
        const isHidden = reviewList.classList.toggle('d-none');
        toggleReviews.textContent = isHidden ? '查看全部評價' : '收起評價';
    });
</script>
