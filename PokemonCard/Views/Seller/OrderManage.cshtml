@{
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        "colors": {
        "tertiary-fixed-dim": "#99cbff",
        "secondary": "#126d27",
        "surface-dim": "#cbdde7",
        "on-background": "#0d1e25",
        "on-surface": "#0d1e25",
        "tertiary": "#00609a",
        "on-tertiary-fixed-variant": "#004a78",
        "surface-variant": "#d4e5ef",
        "on-error-container": "#93000a",
        "surface-container-high": "#d9ebf5",
        "surface-container": "#dff1fb",
        "inverse-on-surface": "#e2f3fd",
        "on-secondary-container": "#19722b",
        "error": "#ba1a1a",
        "primary-container": "#d23e3e",
        "tertiary-fixed": "#cfe5ff",
        "on-tertiary-fixed": "#001d34",
        "background": "#f4faff",
        "tertiary-container": "#0079c1",
        "outline-variant": "#e2bebb",
        "secondary-container": "#9cf49c",
        "on-tertiary": "#ffffff",
        "on-secondary-fixed-variant": "#005318",
        "surface-container-highest": "#d4e5ef",
        "on-tertiary-container": "#fdfcff",
        "secondary-fixed": "#9ff79f",
        "error-container": "#ffdad6",
        "surface-container-low": "#e7f6ff",
        "surface-tint": "#b3272a",
        "on-primary": "#ffffff",
        "surface-bright": "#f4faff",
        "surface-container-lowest": "#ffffff",
        "surface": "#f4faff",
        "outline": "#8e706e",
        "primary-fixed-dim": "#ffb3ae",
        "inverse-primary": "#ffb3ae",
        "on-primary-container": "#fffbff",
        "inverse-surface": "#23333a",
        "on-error": "#ffffff",
        "primary": "#b02528",
        "on-primary-fixed-variant": "#910816",
        "on-primary-fixed": "#410004",
        "primary-fixed": "#ffdad7",
        "on-surface-variant": "#5a413f",
        "secondary-fixed-dim": "#83da85",
        "on-secondary": "#ffffff",
        "on-secondary-fixed": "#002105"
        },
        "borderRadius": {
        "DEFAULT": "0.125rem",
        "lg": "0.25rem",
        "xl": "0.5rem",
        "full": "0.75rem"
        },
        "spacing": {
        "max-width": "1280px",
        "unit": "4px",
        "margin-mobile": "16px",
        "gutter": "16px",
        "margin-desktop": "24px"
        },
        "fontFamily": {
        "body-lg": ["Inter", "sans-serif"],
        "label-bold": ["Inter", "sans-serif"],
        "title-md": ["Inter", "sans-serif"],
        "headline-lg": ["Inter", "sans-serif"]
        },
        "fontSize": {
        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "700" }],
        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
        "label-bold": ["12px", { "lineHeight": "16px", "fontWeight": "700" }],
        "price-display": ["24px", { "lineHeight": "24px", "letterSpacing": "-0.01em", "fontWeight": "800" }],
        "title-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "700" }],
        "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }]
        }
        }
        }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-background font-body-lg text-on-surface p-4 md:p-8">

    <main class="w-full max-w-5xl mx-auto">
        <!-- Breadcrumb & Header -->
        <div class="flex flex-col gap-unit mb-6">
            <a href="~/Seller/SellerHomepage">
                <div class="flex items-center gap-2 text-body-sm text-on-surface-variant bg-white/80 w-fit px-3 py-1.5 rounded-full backdrop-blur-sm shadow-sm cursor-pointer hover:text-on-surface transition-colors">
                    <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                    <span>返回賣家中心</span>
                </div>
            </a>
            <div class="flex items-center justify-between mt-2">
                <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">訂單管理</h1>
            </div>
        </div>

        <!-- Main Container -->
        <div class="bg-white/95 backdrop-blur-sm rounded-xl shadow-sm border border-outline-variant p-6 flex flex-col gap-6 relative overflow-hidden">
            <!-- Decorative background element -->
            <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Toolbar: Search & Actions -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 relative z-10">
                <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                    <div class="relative w-full sm:w-72">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                        <input class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-body-lg text-on-surface focus:outline-none focus:border-tertiary focus:ring-2 focus:ring-tertiary/20 transition-all" placeholder="請輸入訂單編號、姓名、手機" type="text">
                    </div>
                    <button class="px-5 py-2 bg-surface-container-high text-on-surface font-label-bold rounded-lg hover:bg-surface-dim transition-colors border border-outline-variant shadow-sm whitespace-nowrap">
                        搜尋
                    </button>
                </div>
                <div class="flex gap-3 w-full md:w-auto justify-end">
                    <button class="px-5 py-2 bg-secondary text-on-secondary font-label-bold rounded-lg hover:bg-secondary/90 transition-colors shadow-sm flex items-center gap-2 whitespace-nowrap">
                        <span class="material-symbols-outlined text-[18px]">local_shipping</span>
                        執行出貨
                    </button>
                    <button class="px-5 py-2 bg-surface text-tertiary font-label-bold rounded-lg hover:bg-surface-container-high transition-colors border border-tertiary/30 shadow-sm flex items-center gap-2 whitespace-nowrap">
                        <span class="material-symbols-outlined text-[18px]">call_merge</span>
                        訂單合併
                    </button>
                </div>
            </div>

            <!-- Tabs -->
            <div class="flex overflow-x-auto gap-6 border-b border-outline-variant pb-2 relative z-10">
                <button class="text-title-md font-title-md text-primary border-b-2 border-primary pb-2 whitespace-nowrap">全部</button>
                <button class="text-title-md font-title-md text-on-surface-variant hover:text-on-surface pb-2 whitespace-nowrap transition-colors">待採購</button>
                <button class="text-title-md font-title-md text-on-surface-variant hover:text-on-surface pb-2 whitespace-nowrap transition-colors relative">
                    待付尾款
                    <span class="absolute top-0 -right-2 w-2 h-2 bg-primary rounded-full"></span>
                </button>
                <button class="text-title-md font-title-md text-on-surface-variant hover:text-on-surface pb-2 whitespace-nowrap transition-colors">待出貨</button>
                <button class="text-title-md font-title-md text-on-surface-variant hover:text-on-surface pb-2 whitespace-nowrap transition-colors">運送中</button>
                <button class="text-title-md font-title-md text-on-surface-variant hover:text-on-surface pb-2 whitespace-nowrap transition-colors">已完成</button>
                <button class="text-title-md font-title-md text-on-surface-variant hover:text-on-surface pb-2 whitespace-nowrap transition-colors">退貨/退款</button>
            </div>

            <!-- Table -->
            <div class="overflow-x-auto w-full relative z-10">
                <table class="w-full text-left border-collapse min-w-[700px]">
                    <thead>
                        <tr class="border-b border-outline-variant">
                            <th class="py-3 px-3 w-10">
                                <div class="w-5 h-5 border-2 border-outline-variant rounded flex items-center justify-center cursor-pointer hover:border-primary"></div>
                            </th>
                            <th class="py-3 px-3 font-label-bold text-on-surface-variant uppercase tracking-wider">訂單編號</th>
                            <th class="py-3 px-3 font-label-bold text-on-surface-variant uppercase tracking-wider">買家帳號</th>
                            <th class="py-3 px-3 font-label-bold text-on-surface-variant uppercase tracking-wider">交易類型</th>
                            <th class="py-3 px-3 font-label-bold text-on-surface-variant uppercase tracking-wider text-right">金額</th>
                            <th class="py-3 px-3 font-label-bold text-on-surface-variant uppercase tracking-wider text-center">狀態</th>
                            <th class="py-3 px-3 font-label-bold text-on-surface-variant uppercase tracking-wider text-right">操作</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/50">
                        <!-- Row 1 -->
                        <tr class="hover:bg-surface-container-low transition-colors group">
                            <td class="py-3 px-3">
                                <div class="w-5 h-5 border-2 border-primary bg-primary rounded flex items-center justify-center cursor-pointer">
                                    <span class="material-symbols-outlined text-[16px] text-on-primary">check</span>
                                </div>
                            </td>
                            <td class="py-3 px-3"><span class="font-body-lg text-on-surface">ORD5073001</span></td>
                            <td class="py-3 px-3">
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 rounded-full bg-surface-variant flex items-center justify-center text-label-bold text-on-surface-variant">A</div>
                                    <span class="font-body-lg text-on-surface">abc123</span>
                                </div>
                            </td>
                            <td class="py-3 px-3"><span class="inline-flex items-center px-2 py-0.5 rounded bg-surface-container-high text-body-sm text-on-surface">預購</span></td>
                            <td class="py-3 px-3 text-right"><span class="font-price-display text-on-surface">$580</span></td>
                            <td class="py-3 px-3 text-center">
                                <span class="inline-flex items-center gap-1 text-body-sm font-label-bold text-primary">
                                    <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                    待採購
                                </span>
                            </td>
                            <td class="py-3 px-3 text-right">
                                <button class="text-tertiary hover:text-tertiary-container font-label-bold transition-colors">詳情</button>
                            </td>
                        </tr>
                        <!-- Row 2 -->
                        <tr class="hover:bg-surface-container-low transition-colors group">
                            <td class="py-3 px-3">
                                <div class="w-5 h-5 border-2 border-primary bg-primary rounded flex items-center justify-center cursor-pointer">
                                    <span class="material-symbols-outlined text-[16px] text-on-primary">check</span>
                                </div>
                            </td>
                            <td class="py-3 px-3"><span class="font-body-lg text-on-surface">ORD5073005</span></td>
                            <td class="py-3 px-3">
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 rounded-full bg-surface-variant flex items-center justify-center text-label-bold text-on-surface-variant">A</div>
                                    <span class="font-body-lg text-on-surface">abc123</span>
                                </div>
                            </td>
                            <td class="py-3 px-3"><span class="inline-flex items-center px-2 py-0.5 rounded bg-surface-container-high text-body-sm text-on-surface">現貨</span></td>
                            <td class="py-3 px-3 text-right"><span class="font-price-display text-on-surface">$1099</span></td>
                            <td class="py-3 px-3 text-center">
                                <span class="inline-flex items-center gap-1 text-body-sm font-label-bold text-secondary">
                                    <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                    待出貨
                                </span>
                            </td>
                            <td class="py-3 px-3 text-right">
                                <button class="text-tertiary hover:text-tertiary-container font-label-bold transition-colors">詳情</button>
                            </td>
                        </tr>
                        <!-- Row 3 -->
                        <tr class="hover:bg-surface-container-low transition-colors group">
                            <td class="py-3 px-3">
                                <div class="w-5 h-5 border-2 border-outline-variant rounded flex items-center justify-center cursor-pointer hover:border-primary"></div>
                            </td>
                            <td class="py-3 px-3"><span class="font-body-lg text-on-surface">ORD5073201</span></td>
                            <td class="py-3 px-3">
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 rounded-full bg-surface-variant flex items-center justify-center text-label-bold text-on-surface-variant">A</div>
                                    <span class="font-body-lg text-on-surface">abc133</span>
                                </div>
                            </td>
                            <td class="py-3 px-3"><span class="inline-flex items-center px-2 py-0.5 rounded bg-surface-container-high text-body-sm text-on-surface">預購</span></td>
                            <td class="py-3 px-3 text-right"><span class="font-price-display text-on-surface">$480</span></td>
                            <td class="py-3 px-3 text-center">
                                <span class="inline-flex items-center gap-1 text-body-sm font-label-bold text-secondary">
                                    <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                    待出貨
                                </span>
                            </td>
                            <td class="py-3 px-3 text-right">
                                <button class="text-tertiary hover:text-tertiary-container font-label-bold transition-colors">詳情</button>
                            </td>
                        </tr>
                        <!-- Row 4 -->
                        <tr class="hover:bg-surface-container-low transition-colors group bg-primary/5">
                            <td class="py-3 px-3">
                                <div class="w-5 h-5 border-2 border-outline-variant rounded flex items-center justify-center cursor-pointer hover:border-primary"></div>
                            </td>
                            <td class="py-3 px-3"><span class="font-body-lg text-on-surface">ORD5073002</span></td>
                            <td class="py-3 px-3">
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 rounded-full bg-surface-variant flex items-center justify-center text-label-bold text-on-surface-variant">A</div>
                                    <span class="font-body-lg text-on-surface">abc223</span>
                                </div>
                            </td>
                            <td class="py-3 px-3"><span class="inline-flex items-center px-2 py-0.5 rounded bg-surface-container-high text-body-sm text-on-surface">現貨</span></td>
                            <td class="py-3 px-3 text-right"><span class="font-price-display text-on-surface">$799</span></td>
                            <td class="py-3 px-3 text-center">
                                <span class="inline-flex items-center gap-1 text-body-sm font-label-bold text-secondary">
                                    <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                    待出貨
                                </span>
                            </td>
                            <td class="py-3 px-3 text-right">
                                <button class="text-tertiary hover:text-tertiary-container font-label-bold transition-colors">詳情</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="flex justify-end items-center mt-4 border-t border-outline-variant pt-4 relative z-10">
                <div class="flex items-center gap-2 text-body-sm text-on-surface-variant cursor-pointer hover:text-on-surface transition-colors">
                    <span>第3頁/共10頁</span>
                    <span class="material-symbols-outlined text-[18px]">arrow_drop_down</span>
                </div>
            </div>
        </div>
    </main>

</body>
</html>
