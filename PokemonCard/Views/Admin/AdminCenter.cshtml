@{
    ViewData["Title"] = "管理員後台首頁";
    Layout = "_AdminLayout";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1">管理員後台首頁 / 儀表板</h1>
        <p class="text-secondary mb-0">日本限定寶可夢代購平台管理總覽</p>
    </div>
</div>


<div class="row g-3">
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-secondary small mb-1">待審核賣家</div>
                <div class="fs-3 fw-bold">0</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-secondary small mb-1">異常訂單</div>
                <div class="fs-3 fw-bold">0</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-secondary small mb-1">黑名單使用者</div>
                <div class="fs-3 fw-bold">0</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-secondary small mb-1">系統模組</div>
                <div class="fs-3 fw-bold">9</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-body">
        <h2 class="h5">後台功能區</h2>
        <p class="text-secondary mb-0">請從左側選單進入各項管理功能。</p>
    </div>
</div>

