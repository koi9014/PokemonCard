@model List<BannedWord>

@{
    ViewData["Title"] = "違禁字庫管理";
    Layout = "_AdminLayout";

    var keyword = ViewBag.Keyword as string ?? string.Empty;
    var status = ViewBag.Status as string ?? "all";
    var enabledCount = Convert.ToInt32(ViewBag.EnabledCount ?? 0);
    var disabledCount = Convert.ToInt32(ViewBag.DisabledCount ?? 0);
    var totalCount = enabledCount + disabledCount;
    var reviewText = TempData["BannedWordReviewText"] as string ?? string.Empty;
    var reviewMatches = TempData["BannedWordReviewMatches"] as string ?? string.Empty;
    var reviewPassed = TempData["BannedWordReviewPassed"] as string;
}

<style>
    .page-toolbar {
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 8px;
    }

    .metric-card {
        border: 1px solid #e9ecef;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 0.125rem 0.5rem rgba(15, 23, 42, 0.04);
    }

    .metric-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .management-card {
        border: 1px solid #e9ecef;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 0.125rem 0.5rem rgba(15, 23, 42, 0.04);
    }

    .table thead th {
        color: #6c757d;
        font-size: 0.82rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .word-input {
        min-width: 220px;
    }

    .empty-state {
        min-height: 180px;
        display: grid;
        place-items: center;
    }

    .review-result {
        min-width: 220px;
    }
</style>

<div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3 mb-4">
    <div>
        <div class="text-secondary small mb-1">Content Safety</div>
        <h1 class="h3 mb-1">違禁字庫管理</h1>
        <p class="text-secondary mb-0">管理審查規則字詞，啟用中的違禁字會用於後續賣家與商品內容審查。</p>
    </div>
    <div class="page-toolbar px-3 py-2 text-secondary small">
        <span class="fw-semibold text-dark">審查來源：</span>
        賣家申請、賣場資料、商品名稱與描述
    </div>
</div>

@if (TempData["BannedWordMessage"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
    </div>
}

@if (TempData["BannedWordError"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
    </div>
}

@if (TempData["BannedWordReviewError"] is string reviewError)
{
    <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm" role="alert">
        @reviewError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="metric-card h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small mb-1">啟用中</div>
                    <div class="fs-3 fw-bold text-success">@enabledCount</div>
                </div>
                <div class="metric-icon bg-success-subtle text-success">
                    <i class="bi bi-shield-check"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small mb-1">已停用</div>
                    <div class="fs-3 fw-bold text-secondary">@disabledCount</div>
                </div>
                <div class="metric-icon bg-secondary-subtle text-secondary">
                    <i class="bi bi-slash-circle"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small mb-1">總詞數</div>
                    <div class="fs-3 fw-bold">@totalCount</div>
                </div>
                <div class="metric-icon bg-primary-subtle text-primary">
                    <i class="bi bi-database-check"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="management-card mb-3">
    <div class="card-body p-3">
        <form asp-controller="Admin" asp-action="ReviewBannedWordText" method="post" class="d-flex flex-column flex-xl-row align-items-xl-center gap-3">
            @Html.AntiForgeryToken()
            <div class="d-flex align-items-center gap-2 text-nowrap">
                <i class="bi bi-clipboard-check text-primary"></i>
                <span class="fw-semibold">文字審查測試</span>
            </div>
            <input id="reviewText" name="reviewText" value="@reviewText" class="form-control" maxlength="500" placeholder="輸入賣場名稱、商品名稱或描述文字進行測試" />
            <button type="submit" class="btn btn-outline-primary text-nowrap">
                <i class="bi bi-shield-check me-1"></i>檢查
            </button>
            <div class="review-result small">
                @if (reviewPassed == "True")
                {
                    <span class="text-success fw-semibold">
                        <i class="bi bi-check-circle me-1"></i>未命中違禁字
                    </span>
                }
                else if (!string.IsNullOrWhiteSpace(reviewMatches))
                {
                    <span class="text-danger fw-semibold me-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>命中
                    </span>
                    @foreach (var matchedWord in reviewMatches.Split('、', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="badge text-bg-danger me-1">@matchedWord</span>
                    }
                }
                else
                {
                    <span class="text-secondary">輸入文字後可測試規則</span>
                }
            </div>
        </form>
    </div>
</div>

<div class="management-card mb-4">
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-search text-secondary"></i>
                    <h2 class="h5 mb-0">查詢違禁字</h2>
                </div>
                <form asp-controller="Admin" asp-action="BannedWords" method="get" class="row g-3 align-items-end">
                    <div class="col-md-7">
                        <label for="keyword" class="form-label">關鍵字</label>
                        <input id="keyword" name="keyword" value="@keyword" class="form-control" placeholder="輸入違禁字或部分文字" />
                    </div>
                    <div class="col-md-3">
                        <label for="status" class="form-label">狀態</label>
                        <select id="status" name="status" class="form-select">
                            <option value="all" selected="@(status == "all")">全部</option>
                            <option value="enabled" selected="@(status == "enabled")">啟用中</option>
                            <option value="disabled" selected="@(status == "disabled")">已停用</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-dark">
                            <i class="bi bi-search me-1"></i>搜尋
                        </button>
                    </div>
                </form>
            </div>

            <div class="col-lg-5 border-start">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-plus-circle text-primary"></i>
                    <h2 class="h5 mb-0">新增違禁字</h2>
                </div>
                <form asp-controller="Admin" asp-action="CreateBannedWord" method="post" class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-8">
                        <label for="newBannedWords" class="form-label">違禁字</label>
                        <input id="newBannedWords" name="bannedWords" class="form-control" maxlength="100" placeholder="例如：假貨" required />
                    </div>
                    <div class="col-md-4 d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-1"></i>新增
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="management-card">
    <div class="card-body p-0">
        <div class="d-flex align-items-center justify-content-between px-4 py-3 border-bottom">
            <div>
                <h2 class="h5 mb-1">違禁字清單</h2>
                <div class="text-secondary small">可直接編輯文字，或切換啟用狀態。</div>
            </div>
            <span class="badge rounded-pill text-bg-light border">目前顯示 @Model.Count 筆</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 34%;">違禁字</th>
                        <th style="width: 12%;">狀態</th>
                        <th style="width: 18%;">建立管理員</th>
                        <th style="width: 18%;">建立時間</th>
                        <th class="text-end pe-4" style="width: 18%;">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state text-center text-secondary">
                                    <div>
                                        <div class="fs-2 mb-2"><i class="bi bi-inbox"></i></div>
                                        <div class="fw-semibold text-dark mb-1">沒有符合條件的違禁字</div>
                                        <div class="small">請調整搜尋條件，或新增第一個違禁字。</div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <form asp-controller="Admin" asp-action="EditBannedWord" method="post" class="d-flex gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.BannedWordsId" />
                                        <input name="bannedWords" value="@item.BannedWords" class="form-control form-control-sm word-input" maxlength="100" required />
                                        <button type="submit" class="btn btn-outline-dark btn-sm text-nowrap">
                                            <i class="bi bi-check2 me-1"></i>儲存
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    @if (item.IsEnabled)
                                    {
                                        <span class="badge text-bg-success">啟用中</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">已停用</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-dark">@(item.Admin?.Username ?? "-")</span>
                                </td>
                                <td>
                                    <span class="text-secondary small">@item.BanCreatedAt.ToString("yyyy/MM/dd HH:mm")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-controller="Admin" asp-action="ToggleBannedWord" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.BannedWordsId" />
                                        <button type="submit" class="btn btn-sm @(item.IsEnabled ? "btn-outline-secondary" : "btn-outline-success")">
                                            <i class="bi @(item.IsEnabled ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                                            @(item.IsEnabled ? "停用" : "啟用")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
