                                <span class="material-symbols-outlined text-[18px]">favorite</span>
                            </button>
                            <img alt="Paldea" class="w-full h-full object-contain mix-blend-multiply group-hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida/AP1WRLuFDjlHaEPlSBRjOZSz0cWjjj7S_hBtpF8Qp1SXDJriS8oadtdjhJrLwGE5mjkZH_dINDBy1N2A9qSW8WRTQnGRKN05ElpR3lr4bUMAnBzrd7hqpTMFvaIiSh77oCIIpaQDZE9Dax-fRJTwjBv1NDyrm6nZAxUX1H36GG3oBFzuTbzL9iDXpE6QndlQ7TjucPuuM0WiKIisleLQ3KakQcWQ8E2eelXnnt3z-mcgwn99jidE2JyX3blTBQ3_">
                        </div>
                        <div class="p-4 md:p-5 flex flex-col flex-1">
