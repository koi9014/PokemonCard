                            <div class="absolute top-3 left-3 z-10">
                                <span class="bg-[#EF5350] text-white text-xs font-bold px-2 py-1 rounded shadow-sm uppercase">新品</span>
                            </div>
                            <button class="absolute top-3 right-3 z-10 w-8 h-8 rounded-lg bg-white/90 backdrop-blur-sm flex items-center justify-center text-[#5a413f] hover:text-[#EF5350] shadow-sm transition-all">
                                <span class="material-symbols-outlined text-[18px]">favorite</span>
                            </button>
                            <img alt="Pikachu" class="w-full h-full object-contain mix-blend-multiply group-hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida/AP1WRLvUgza1E_kLXdY8QKlRyIBxX4AhytCF1D9A1T_YNwUBbXMOXl7EW144zKnsSfG4Zw3k9IU7EqBaES_P8fT87uCZX1Mi4NQz2CAjQzToWWT9p3baiqjHkQDsaXFjwnNpB6tmcbrfIxvaA6YoLOcg6G6DQCp2eAckggOtErsF19k7bltFYble06j8H0gNqBkx3I-Y4Io_xs3t7XbPA_EQxEZmdUNZFI1YabXBS9CVCWbwENNXVkqIgTAzB44V">
                        </div>
                        <div class="p-4 md:p-5 flex flex-col flex-1">
                            <div class="text-xs font-bold text-[#5a413f] mb-1 uppercase">娃娃系列</div>
                            <h4 class="text-lg font-bold text-[#0d1e25] mb-2 line-clamp-2 min-h-[56px]">皮卡丘 經典坐姿絨毛娃娃</h4>
