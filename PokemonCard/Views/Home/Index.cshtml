@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>PiCartChu 日本寶可夢代購平台 - 純內容區塊</title>
        <!-- Tailwind CSS CDN -->
        <script src="https://cdn.tailwindcss.com"></script>
        <script id="tailwind-config">
            tailwind.config = {
            darkMode: "class",
            theme: {
            extend: {
            colors: {
            "primary": "#EF5350",
            "on-primary": "#ffffff",
            "tertiary": "#42A5F5",
            "success": "#66BB6A",
            "surface": "#f4faff",
            "on-surface": "#0d1e25",
            "on-surface-variant": "#5a413f",
            "surface-container": "#dff1fb",
            "surface-container-low": "#e7f6ff",
            "surface-container-lowest": "#ffffff",
            "outline-variant": "#e2bebb"
            }
            }
            }
            }
        </script>
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    </head>
    <body class="bg-[#f4faff] font-['Inter'] text-[#0d1e25] m-0 p-4 md:p-8">

        <!-- 內容容器 -->
        <div class="max-w-[1280px] mx-auto flex flex-col gap-8">

            <!-- 1. Hero Banner 區塊 -->
            <section class="w-full">
                <div class="relative w-full h-[300px] md:h-[400px] lg:h-[450px] rounded-xl overflow-hidden shadow-md group">
                    <div class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 group-hover:scale-105" style="background-image: url('https://lh3.googleusercontent.com/aida/AP1WRLsxRraB_bYHVjdefxcOwZxIc6qt5U-KhE98NR8VzngzIePqNG0RkuFsc5Ph3S4pqF3s2b_ma0AoLeryCv1Bi_iO7x8VH51o_II5qlI_BUdQyYJ0iIXVQxoGxwbp2n_Y_stjXe-iiFr08kgvFTDf7BIXCrFVmkf2svbpDjK5WZ5KaAflonAKXRUcPFH6IIcJ4htm4T6YlujhWHnf2YNreU5cIgkefAreLwaYpbrFOwxgE-hnY_wg2dFir0_X');"></div>
                    <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/20 to-transparent"></div>
                    <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-10 text-white z-10">
                        <span class="inline-block px-3 py-1 mb-3 text-xs font-bold bg-[#66BB6A] text-white rounded w-max uppercase tracking-wider">
                            FEATURED COLLECTION
                        </span>
                        <h2 class="text-2xl md:text-4xl font-extrabold mb-3 leading-tight max-w-2xl">
                            最新寶可夢新品與熱賣商品
                        </h2>
                        <p class="text-lg text-white/90 mb-6 max-w-xl">
                            直接從日本產地直送，預購開跑中！
                        </p>
                        <button class="bg-[#EF5350] text-white px-6 py-3 rounded-lg font-bold shadow-md hover:bg-[#E53935] hover:-translate-y-0.5 transition-all w-max flex items-center gap-2">
                            探索更多 <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- 2. 篩選器區塊 (地區、種類) -->
            <section class="w-full">
                <div class="bg-white rounded-xl shadow-sm border border-[#e2bebb]/50 p-5 md:p-6">
                    <div class="flex flex-col gap-5">
                        <!-- 地區篩選 -->
                        <div class="flex flex-col md:flex-row md:items-start gap-4">
                            <div class="w-full md:w-24 shrink-0 mt-1 flex items-center gap-2 text-primary font-bold">
                                <span class="material-symbols-outlined text-[20px]">location_on</span> 地區
                            </div>
                            <div class="flex flex-wrap gap-2 md:gap-3 flex-1">
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-primary text-on-primary shadow-sm hover:shadow-md transition-all">全部</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">札幌</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">東北</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">新千歲機場</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">日本橋</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">池袋</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">澀谷</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">晴空塔</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">東京灣</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">橫濱</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">東京</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">成田機場</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">名古屋</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">金澤</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">御殿場</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">京都</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">心齋橋</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">梅田</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">廣島</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">香川</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">福岡</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">沖繩</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">寶可夢樂園</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">限定快閃店</button>
                            </div>
                        </div>
                        <div class="w-full h-px bg-surface-variant/50"></div>
                        <!-- 種類篩選 -->
                        <div class="flex flex-col md:flex-row md:items-start gap-4">
                            <div class="w-full md:w-24 shrink-0 mt-1 flex items-center gap-2 text-tertiary font-bold">
                                <span class="material-symbols-outlined text-[20px]">category</span> 種類
                            </div>
                            <div class="flex flex-wrap gap-2 md:gap-3 flex-1">
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">泡澡球</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">徽章</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">包包</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">娃娃</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">吊飾</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">模型</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">卡牌</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">文具</button>
                            </div>
                        </div>
                        <div class="w-full h-px bg-surface-variant/50"></div>
                        <!--系列篩選 -->
                        <!-- Series Filter -->
                        <div class="flex flex-col md:flex-row md:items-start gap-4">
                            <div class="w-full md:w-24 shrink-0 mt-1 flex items-center gap-2 text-success font-bold">
                                <span class="material-symbols-outlined text-[20px]">stars</span> 系列
                            </div>
                            <div class="flex flex-wrap gap-2 md:gap-3 flex-1">
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all flex items-center gap-1">
                                    <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span> Paldea Legends
                                </button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all flex items-center gap-1">
                                    <span class="w-2 h-2 rounded-full bg-tertiary"></span> Pokemon Sleep
                                </button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all flex items-center gap-1">
                                    <span class="w-2 h-2 rounded-full bg-success"></span> Pokemon Soda
                                </button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">30th Anniversary</button>
                                <button class="px-4 py-1.5 rounded text-body-sm font-medium bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-all">Pokopia</button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>



            <!-- 3. 精選熱銷商品網格區塊 -->
            <section class="w-full">
                <div class="flex items-end justify-between mb-6">
                    <div>
                        <h3 class="text-2xl font-bold text-[#0d1e25] flex items-center gap-2">
                            精選熱銷商品
                            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#EF5350]/10 text-[#EF5350]">
                                <span class="material-symbols-outlined text-[20px]">local_fire_department</span>
                            </span>
                        </h3>
                        <p class="text-sm text-[#5a413f] mt-1">為您挑選本週最受歡迎的代購項目</p>
                    </div>
                    <a class="hidden md:flex items-center gap-1 text-[#42A5F5] font-medium hover:text-[#0079c1] transition-colors group" href="#">
                        查看全部 <span class="material-symbols-outlined text-[20px] transition-transform group-hover:translate-x-1">arrow_forward</span>
                    </a>
                </div>

                <!-- 商品卡片列表 -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- 卡片 1 -->
                    <div class="bg-white border border-[#e2bebb]/30 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col overflow-hidden group">
