                                </div>
                                <button class="w-10 h-10 rounded-lg bg-[#42A5F5]/10 text-[#42A5F5] hover:bg-[#42A5F5] hover:text-white transition-all flex items-center justify-center shadow-sm">
                                    <span class="material-symbols-outlined text-[20px]">shopping_cart</span>
                                </button>
                            </div>
                        </div>
                    </div>

