@{
    ViewData["Title"] = "Home Page";
    var pageModel = (PokemonCard.Controllers.HomeIndexViewModel)Model;
    var locations = new[] { "北海道", "東北", "關東", "中部", "近畿", "中國", "四國", "九州", "沖繩" };
    var productTypes = new[] { "絨毛娃娃", "模型與公仔", "集換式卡牌", "生活與家居", "服飾與配件", "文具與辦公用品", "電玩周邊", "3C配件", "其他" };
    var activeFilterClass = "bg-primary text-on-primary shadow-sm";
    var filterClass = "bg-surface-container hover:bg-surface-container-high text-on-surface-variant";
}

        <title>PiCartChu 日本寶可夢代購平台</title>
<div class="w-full px-4 md:px-8">
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <!-- Tailwind CSS CDN -->
        <script src="https://cdn.tailwindcss.com"></script>
        <script id="tailwind-config">
            tailwind.config = {
            darkMode: "class",
            theme: {
            extend: {
            colors: {
            "primary": "#EF5350",
            "on-primary": "#ffffff",
            "tertiary": "#42A5F5",
            "success": "#66BB6A",
            "surface": "#f4faff",
            "on-surface": "#0d1e25",
            "on-surface-variant": "#5a413f",
            "surface-container": "#dff1fb",
            "surface-container-low": "#e7f6ff",
            "surface-container-lowest": "#ffffff",
            "outline-variant": "#e2bebb"
            }
            }
            }
            }
        </script>
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <div class="bg-[#f4faff] font-['Inter'] text-[#0d1e25] py-4 md:py-8">

        <!-- 內容容器 -->
        <div class="mx-auto flex w-full flex-col gap-8">

            <!-- 1. Hero Banner 區塊 -->
            <section class="w-full">
                <div class="relative w-full h-[300px] md:h-[400px] lg:h-[450px] rounded-xl overflow-hidden shadow-md group">
                    <div class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 group-hover:scale-105" style="background-image: url(../img/banner.png)"></div>
                    <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/20 to-transparent"></div>
                    <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-10 text-white z-10">
                        <span class="inline-block px-3 py-1 mb-3 text-xs font-bold bg-[#66BB6A] text-white rounded w-max uppercase tracking-wider">
                            FEATURED COLLECTION
                        </span>
                        <h2 class="text-2xl md:text-4xl font-extrabold mb-3 leading-tight max-w-2xl">
                            最新寶可夢新品與熱賣商品
                        </h2>
                        <p class="text-lg text-white/90 mb-6 max-w-xl">
                            直接從日本產地直送，預購開跑中！
                        </p>
                    </div>
                </div>
            </section>

            <!-- 2. 篩選器區塊 (地區、種類) -->
            <section class="w-full">
                <div class="bg-white rounded-xl shadow-sm border border-[#e2bebb]/50 p-5 md:p-6">
                    <div class="flex flex-col gap-3">
                        <!-- 地區篩選 -->
                        <div class="flex flex-col md:flex-row md:items-start gap-4">
                            <div class="w-full md:w-24 shrink-0 mt-1 flex items-center gap-2 text-primary font-bold">
                                <span class="material-symbols-outlined text-[20px]">location_on</span> 地區
                            </div>
                            <div class="flex flex-wrap gap-2 md:gap-3 flex-1">
                                <a href="@Url.Action("Index", new { productType = pageModel.ProductType, search = pageModel.Search })" class="px-4 py-1.5 rounded text-body-sm font-medium transition-all @(string.IsNullOrWhiteSpace(pageModel.Location) ? activeFilterClass : filterClass)">全部</a>
                                @foreach (var location in locations)
                                {
                                    <a href="@Url.Action("Index", new { location, productType = pageModel.ProductType, search = pageModel.Search })" class="px-4 py-1.5 rounded text-body-sm font-medium transition-all @(pageModel.Location == location ? activeFilterClass : filterClass)">@location</a>
                                }
                            </div>
                        </div>
                        <div class="w-full h-px bg-surface-variant/50"></div>
                        <!-- 種類篩選 -->
                        <div class="flex flex-col md:flex-row md:items-start gap-4">
                            <div class="w-full md:w-24 shrink-0 mt-1 flex items-center gap-2 text-tertiary font-bold">
                                <span class="material-symbols-outlined text-[20px]">category</span> 種類
                            </div>
                            <div class="flex flex-wrap gap-2 md:gap-3 flex-1">
                                <a href="@Url.Action("Index", new { location = pageModel.Location, search = pageModel.Search })" class="px-4 py-1.5 rounded text-body-sm font-medium transition-all @(string.IsNullOrWhiteSpace(pageModel.ProductType) ? activeFilterClass : filterClass)">全部</a>
                                @foreach (var productType in productTypes)
                                {
                                    <a href="@Url.Action("Index", new { location = pageModel.Location, productType, search = pageModel.Search })" class="px-4 py-1.5 rounded text-body-sm font-medium transition-all @(pageModel.ProductType == productType ? activeFilterClass : filterClass)">@productType</a>
                                }
                            </div>
                        </div>
                        <div class="w-full h-px bg-surface-variant/50"></div>
            </section>



            <!-- 3. 精選熱銷商品網格區塊 -->
            <section class="w-full">
                <div class="flex items-end justify-between mb-6">
                    <div>
                        <h3 class="text-2xl font-bold text-[#0d1e25] flex items-center gap-2">
                            精選熱銷商品
                            <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#EF5350]/10 text-[#EF5350]">
                                <span class="material-symbols-outlined text-[20px]">local_fire_department</span>
                            </span>
                        </h3>
                        <p class="text-sm text-[#5a413f] mt-1">為您挑選本週最受歡迎的代購項目</p>
                    </div>
                    <a class="hidden md:flex items-center gap-1 text-[#42A5F5] font-medium hover:text-[#0079c1] transition-colors group" href="#">
                        查看全部 <span class="material-symbols-outlined text-[20px] transition-transform group-hover:translate-x-1">arrow_forward</span>
                    </a>
                </div>

                <!-- 商品卡片列表 -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    @if (pageModel.Products.Count == 0)
                    {
                        <p class="col-span-full rounded-xl bg-white p-10 text-center text-[#5a413f]">目前沒有可販售的商品。</p>
                    }
                    @foreach (var product in pageModel.Products)
                    {
                        <div class="cursor-pointer bg-white border border-[#e2bebb]/30 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col overflow-hidden group" onclick="window.location.href='@Url.Action("Details", "Product", new { id = product.ProductId })'">
                            <div class="relative w-full aspect-square bg-[#f4faff] p-4 flex items-center justify-center overflow-hidden">
                                <button class="absolute top-3 right-3 z-10 w-8 h-8 rounded-lg bg-white/90 backdrop-blur-sm flex items-center justify-center text-[#5a413f] hover:text-[#EF5350] shadow-sm transition-all" type="button" onclick="event.stopPropagation()">
                                    <span class="material-symbols-outlined text-[18px]">favorite</span>
                                </button>
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img alt="@product.ProductName" class="w-full h-full object-contain mix-blend-multiply group-hover:scale-105 transition-transform duration-500" src="@product.ImageUrl">
                                }
                                else
                                {
                                    <span class="text-sm text-[#5a413f]">暫無商品照片</span>
                                }
                            </div>
                            <div class="p-4 md:p-5 flex flex-col flex-1">
                                <h4 class="mb-2 min-h-[56px] text-center text-lg font-bold text-[#0d1e25] line-clamp-2">@product.ProductName</h4>
                                <div class="mt-auto pt-3 flex items-center justify-between">
                                    <div class="flex flex-col">
                                        @if (product.LowestPrice.HasValue)
                                        {
                                            <span class="text-xl font-extrabold text-[#EF5350]">NT$@product.LowestPrice.Value.ToString("N0")@(product.SpecCount > 1 ? " 起" : "")</span>
                                        }
                                        else
                                        {
                                            <span class="text-sm font-bold text-[#5a413f]">價格請洽詢</span>
                                        }
                                    </div>
                                    <button class="w-10 h-10 rounded-lg bg-[#42A5F5]/10 text-[#42A5F5] hover:bg-[#42A5F5] hover:text-white transition-all flex items-center justify-center shadow-sm" type="button" aria-label="加入購物車" onclick="event.stopPropagation()">
                                        <span class="material-symbols-outlined text-[20px]">shopping_cart</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

        </div>

    </div>
   
</div>
