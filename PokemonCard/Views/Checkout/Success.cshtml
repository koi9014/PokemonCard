@model PokemonCard.Models.Order

@{
    ViewData["Title"] = "訂單完成";
}

<link rel="stylesheet" href="~/css/CheckoutSuccess.css">
<div class="success-page">
    <div class="success-card">

        <!-- 成功圖示 -->
        <div class="success-icon">
            ✓
        </div>

        <!-- 標題 -->
        <h1>下單成功！</h1>

        <p class="success-message">
            感謝您的購買，您的訂單已成功建立。
        </p>


        <!-- 訂單資訊 -->
        <div class="order-info">

            <div class="info-row">
                <span>訂單編號</span>
                <strong>@Model.OrderNo</strong>
            </div>

            <div class="info-row">
                <span>訂單狀態</span>

                <strong class="status">
                    @switch(Model.OrderStatus?.ToUpperInvariant())
                    {
                        case "PENDING":
                            <span>待付款</span>
                            break;

                        case "PAID":
                            <span>已付款</span>
                            break;

                        case "PROCESSING":
                            <span>待出貨</span>
                            break;

                        case "SHIPPED":
                            <span>運送中</span>
                            break;

                        case "COMPLETED":
                            <span>已完成</span>
                            break;

                        default:
                            <span>@Model.OrderStatus</span>
                            break;
                    }
                </strong>
            </div>

            <div class="info-row">
                <span>下單時間</span>
                <strong>
                    @Model.OrderCreatedAt.ToString("yyyy/MM/dd HH:mm")
                </strong>
            </div>

        </div>


        <!-- 商品資訊 -->
        @if(Model.OrderItems != null && Model.OrderItems.Any( ))
        {
            <div class="product-section">

                <h2>商品資訊</h2>

                @foreach(var item in Model.OrderItems)
                {
                    <div class="product-item">

                        <div class="product-detail">

                            <div class="product-name">
                                @item.ProductName
                            </div>

                            @if(!string.IsNullOrEmpty(item.ProductSpec))
                            {
                                <div class="product-spec">
                                    規格：@item.ProductSpec
                                </div>
                            }

                            @if(!string.IsNullOrEmpty(item.ProductSpec2))
                            {
                                <div class="product-spec">
                                    @item.ProductSpec2
                                </div>
                            }

                            <div class="product-quantity">
                                數量：@item.Quantity
                            </div>

                        </div>

                        <div class="product-price">

                            <div>
                                NT$ @item.UnitPrice.ToString("N0")
                            </div>

                            <small>
                                小計 NT$ @((item.UnitPrice * item.Quantity).ToString("N0"))
                            </small>

                        </div>

                    </div>
                }

            </div>
        }


        <!-- 金額 -->
        <div class="amount-section">

            <div class="amount-row">
                <span>商品金額</span>
                <span>
                    NT$ @Model.OrderAmount.ToString("N0")
                </span>
            </div>

            <div class="amount-row">
                <span>運費</span>
                <span>
                    NT$ @Model.ShipAmount.ToString("N0")
                </span>
            </div>

            <div class="amount-line"></div>

            <div class="total-row">
                <span>應付金額</span>
                <strong>
                    NT$ @((Model.OrderAmount + Model.ShipAmount).ToString("N0"))
                </strong>
            </div>

        </div>


        <!-- 收件資訊 -->
        <div class="receiver-section">

            <h2>收件資訊</h2>

            <div class="receiver-row">
                <span>收件人</span>
                <span>@Model.ReceiverName</span>
            </div>

            <div class="receiver-row">
                <span>手機</span>
                <span>@Model.ReceiverPhone</span>
            </div>

            <div class="receiver-row">
                <span>配送地址</span>
                <span>@Model.ShippingAddress</span>
            </div>

        </div>


        <!-- 按鈕 -->
        <div class="success-actions">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline">
                回首頁
            </a>

            <a asp-controller="MyAccount"
               asp-action="order"
               class="btn btn-primary">
                查看我的訂單
            </a>

        </div>

    </div>

</div>
