@model PokemonCard.Models.Product

<link rel="stylesheet" href="~/css/CheckOut.css">

<div class="container-fluid px-4 py-3 checkout-page">

    <!-- =================================
         ① 購物車商品
    ================================== -->
    <div class="checkout-card">

        <div class="card-title">
            購物車 <span>(1 件)</span>
        </div>


        <!-- 商品標題 -->
        <div class="product-header">

            <div>商品資料</div>
            <div>商品單價</div>
            <div>數量</div>
            <div>商品小計</div>

        </div>


        <!-- 商品 -->
        <div class="cart-product">


            <!-- 商品資訊 -->
            <div class="product-info">

                <img src="@Model.ProductImages.FirstOrDefault( )?.ImageUrl"
                     alt="@Model.ProductName">

                <div>

                    <div class="product-name">
                        @Model.ProductName
                    </div>

                    <div class="product-spec">
                        @(((ProductSpec)ViewBag.Spec).SpecsCategory1)
                    </div>

                </div>

            </div>


            <!-- 單價 -->
            <div class="product-price">

                <span class="mobile-label">
                    商品單價
                </span>

                NT$ @(((ProductSpec)ViewBag.Spec).SpecsPrice)

            </div>


            <!-- 數量 -->
            <div class="product-quantity">

                <span class="mobile-label">
                    數量
                </span>

                <div class="quantity-box">

                    <button type="button"
                            id="minusBtn">
                        −
                    </button>

                    <input type="text"
                           id="quantity"
                           value="@ViewBag.Quantity"
                           readonly>

                    <button type="button"
                            id="plusBtn">
                        ＋
                    </button>

                </div>

            </div>


            <!-- 小計 -->
            <div class="product-subtotal">

                <span class="mobile-label">
                    商品小計
                </span>

                NT$ <span id="subtotal">
                @(((ProductSpec)ViewBag.Spec).SpecsPrice * (int)ViewBag.Quantity)
            </span>

        </div>

    </div>

</div>


<!-- =================================
         ② 填寫資料
    ================================== -->
<div class="checkout-card customer-card">

    <div class="card-title">
        填寫資料
    </div>


    <div class="form-content">


        <!-- ==================
                 聯絡資訊
            =================== -->
        <div class="form-section">

            <div class="form-section-title">
                聯絡資訊
            </div>

            <div class="row g-3">

                <div class="col-md-6">

                    <label class="form-label">
                        姓名 <span>*</span>
                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="請輸入姓名">

                </div>


                <div class="col-md-6">

                    <label class="form-label">
                        手機號碼 <span>*</span>
                    </label>

                    <input type="tel"
                           class="form-control"
                           placeholder="請輸入手機號碼">

                </div>


                <div class="col-md-6">

                    <label class="form-label">
                        Email <span>*</span>
                    </label>

                    <input type="email"
                           class="form-control"
                           placeholder="請輸入 Email">

                </div>


                <div class="col-md-6">

                    <label class="form-label">
                        國家／地區 <span>*</span>
                    </label>

                    <select class="form-select">

                        <option>台灣</option>
                        <option>日本</option>
                        <option>香港</option>

                    </select>

                </div>

            </div>

        </div>


        <!-- ==================
                 配送資訊
            =================== -->
        <div class="form-section">

            <div class="form-section-title">
                配送資訊
            </div>

            <div class="row g-3">

                <div class="col-md-6">

                    <label class="form-label">
                        送貨方式 <span>*</span>
                    </label>

                    <select class="form-select">

                        <option>宅配</option>
                        <option>超商取貨</option>

                    </select>

                </div>


                <div class="col-md-6">

                    <label class="form-label">
                        郵遞區號
                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="請輸入郵遞區號">

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        縣市 <span>*</span>
                    </label>

                    <select id="city"
                            name="city"
                            class="form-select">

                        <option value="">請選擇縣市</option>

                        <option value="基隆市">基隆市</option>
                        <option value="臺北市">臺北市</option>
                        <option value="新北市">新北市</option>
                        <option value="桃園市">桃園市</option>
                        <option value="新竹市">新竹市</option>
                        <option value="新竹縣">新竹縣</option>
                        <option value="苗栗縣">苗栗縣</option>
                        <option value="臺中市">臺中市</option>
                        <option value="彰化縣">彰化縣</option>
                        <option value="南投縣">南投縣</option>
                        <option value="雲林縣">雲林縣</option>
                        <option value="嘉義市">嘉義市</option>
                        <option value="嘉義縣">嘉義縣</option>
                        <option value="臺南市">臺南市</option>
                        <option value="高雄市">高雄市</option>
                        <option value="屏東縣">屏東縣</option>
                        <option value="宜蘭縣">宜蘭縣</option>
                        <option value="花蓮縣">花蓮縣</option>
                        <option value="臺東縣">臺東縣</option>
                        <option value="澎湖縣">澎湖縣</option>
                        <option value="金門縣">金門縣</option>
                        <option value="連江縣">連江縣</option>

                    </select>

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        區域 <span>*</span>
                    </label>

                    <select id="district"
                            name="district"
                            class="form-select">

                        <option value="">請先選擇縣市</option>

                    </select>

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        地址 <span>*</span>
                    </label>

                    <input type="text"
                           name="address"
                           class="form-control"
                           placeholder="請輸入詳細地址">

                </div>

            </div>


            <div class="shipping-note">

                <i class="bi bi-info-circle"></i>

                點選「前往結帳」後，即可於下一頁選擇希望的到貨日期。

                <br>

                <span>
                    未指定到貨日：將於 3–5 個工作天內出貨
                </span>

            </div>

        </div>


        <!-- ==================
                 付款方式
            =================== -->
        <div class="form-section">

            <div class="form-section-title">
                付款方式
            </div>

            <div class="payment-option">

                <div>

                    <div class="payment-name">

                        <i class="bi bi-credit-card"></i>

                        信用卡

                    </div>

                    <small>
                        VISA / Master / JCB
                    </small>

                </div>

                <div class="payment-radio">

                    <input type="radio"
                           name="payment"
                           checked>

                </div>

            </div>

        </div>


        <!-- ==================
                 訂單備註
            =================== -->
        <div class="form-section">

            <div class="form-section-title">
                訂單備註
            </div>

            <textarea class="form-control"
                      rows="4"
                      placeholder="有其他需求可以在這裡留言"></textarea>

        </div>


        <!-- ==================
                 金額
            =================== -->
        <div class="order-summary">

            <div class="summary-row">

                <span>
                    商品小計
                </span>

                <span id="summarySubtotal">
                    NT$ @(((ProductSpec)ViewBag.Spec).SpecsPrice * (int)ViewBag.Quantity)
                </span>

            </div>


            <div class="summary-row">

                <span>
                    運費
                </span>

                <span>
                    NT$60
                </span>

            </div>


            <div class="summary-row discount">

                <span>
                    優惠折扣
                </span>

                <span>
                    - NT$0
                </span>

            </div>


            <hr>


            <div class="total-row">

                <span>
                    應付金額
                </span>

                <strong id="totalAmount">

                    NT$ @(((ProductSpec)ViewBag.Spec).SpecsPrice * (int)ViewBag.Quantity + 60)

                </strong>

            </div>

        </div>


        <!-- 結帳 -->
        <div class="checkout-action">

            <button class="checkout-btn">
                前往結帳
            </button>

        </div>


    </div>

</div>

</div>
<script>

    const minusBtn =
        document.getElementById("minusBtn");

    const plusBtn =
        document.getElementById("plusBtn");

    const quantityInput =
        document.getElementById("quantity");

    const subtotalElement =
        document.getElementById("subtotal");

    const summarySubtotal =
        document.getElementById("summarySubtotal");

    const totalAmount =
        document.getElementById("totalAmount");


    // 商品單價
    const price =
            @(((ProductSpec)ViewBag.Spec).SpecsPrice);


    // 運費
    const shipping =
        60;


    // 減少數量
    minusBtn.addEventListener("click", function() {

        let quantity =
            parseInt(quantityInput.value) || 1;

        if (quantity > 1) {

            quantity--;

            quantityInput.value =
                quantity;

            updateAmount();

        }

    });


    // 增加數量
    plusBtn.addEventListener("click", function() {

        let quantity =
            parseInt(quantityInput.value) || 1;

        quantity++;

        quantityInput.value =
            quantity;

        updateAmount();

    });


    // 更新金額
    function updateAmount() {

        const quantity =
            parseInt(quantityInput.value) || 1;

        const subtotal =
            price * quantity;

        const total =
            subtotal + shipping;


        // 商品小計
        subtotalElement.textContent =
            subtotal.toLocaleString();


        // 下方商品小計
        summarySubtotal.textContent =
            "NT$ " + subtotal.toLocaleString();


        // 總金額
        totalAmount.textContent =
            "NT$ " + total.toLocaleString();

    }

</script>

